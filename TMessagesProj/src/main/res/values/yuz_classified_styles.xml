<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Elonlar (classifieds) ekrani Material komponentlaridan (CoordinatorLayout, AppBarLayout,
      ChipGroup, ExtendedFloatingActionButton, TextInputLayout) foydalanadi. Ular Telegram'ning
      o'z temasi ostida emas, balki ContextThemeWrapper orqali shu Material tema ostida inflate
      qilinadi — aks holda "requires Theme.MaterialComponents" xatosi beradi.
      Feed dizayni qorong'i (karta #121212, fon #000000), shuning uchun Material (dark) parent.
    -->
    <style name="Theme.YuzGramAds" parent="Theme.MaterialComponents.NoActionBar">
        <item name="colorPrimary">@color/home_accent</item>
        <item name="colorPrimaryVariant">@color/home_accent</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/home_accent_purple</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="android:windowBackground">@color/home_bg</item>
        <item name="android:colorBackground">@color/home_bg</item>
    </style>

    <!--
      Funksiyalar hub v2 — bitta hero + bo'lim qatorlari. Barcha raqamlar
      yuz_design_tokens.xml'dan; layout faqat tuzilma yozadi.
    -->
    <style name="FuncsionHero" parent="Widget.MaterialComponents.CardView">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">@dimen/yuz_gutter</item>
        <item name="android:layout_marginEnd">@dimen/yuz_gutter</item>
        <item name="android:layout_marginTop">@dimen/yuz_space_4</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:foreground">?attr/selectableItemBackground</item>
        <item name="cardBackgroundColor">@color/yuz_surface_raised</item>
        <item name="cardCornerRadius">24dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@color/yuz_stroke_decor</item>
        <item name="strokeWidth">@dimen/yuz_stroke</item>
    </style>

    <style name="FuncsionHeroTitle">
        <item name="android:textColor">@color/yuz_text_bright</item>
        <item name="android:textSize">@dimen/yuz_text_title</item>
        <item name="android:textStyle">bold</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:shadowColor">#99000000</item>
        <item name="android:shadowDx">0</item>
        <item name="android:shadowDy">2</item>
        <item name="android:shadowRadius">8</item>
    </style>

    <style name="FuncsionHeroDesc">
        <item name="android:layout_marginTop">3dp</item>
        <item name="android:textColor">@color/yuz_text_secondary</item>
        <item name="android:textSize">@dimen/yuz_text_secondary</item>
        <item name="android:lineSpacingExtra">2sp</item>
        <item name="android:shadowColor">#CC000000</item>
        <item name="android:shadowDx">0</item>
        <item name="android:shadowDy">1</item>
        <item name="android:shadowRadius">6</item>
    </style>

    <style name="FuncsionHeroCta">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">@dimen/yuz_space_4</item>
        <item name="android:background">@drawable/bg_funktions_cta</item>
        <item name="android:drawableStart">@drawable/ic_yuz_mic</item>
        <item name="android:drawablePadding">@dimen/yuz_space_2</item>
        <item name="android:drawableTint">@color/yuz_on_action</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingLeft">@dimen/yuz_space_4</item>
        <item name="android:paddingTop">10dp</item>
        <item name="android:paddingRight">@dimen/yuz_space_4</item>
        <item name="android:paddingBottom">10dp</item>
        <item name="android:textColor">@color/yuz_on_action</item>
        <item name="android:textSize">@dimen/yuz_text_secondary</item>
        <item name="android:textStyle">bold</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="FuncsionSection">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">@dimen/yuz_gutter</item>
        <item name="android:layout_marginEnd">@dimen/yuz_gutter</item>
        <item name="android:layout_marginTop">@dimen/yuz_space_6</item>
        <item name="android:textColor">@color/yuz_text_bright</item>
        <item name="android:textSize">@dimen/yuz_text_section</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">-0.005</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:drawableStart">@drawable/bg_func_section_bar</item>
        <item name="android:drawablePadding">10dp</item>
    </style>

    <style name="FuncsionRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">@dimen/yuz_gutter</item>
        <item name="android:layout_marginEnd">@dimen/yuz_gutter</item>
        <item name="android:layout_marginTop">@dimen/yuz_space_3</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:baselineAligned">false</item>
    </style>

    <style name="FuncsionTile" parent="Widget.MaterialComponents.CardView">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:minHeight">150dp</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:foreground">?attr/selectableItemBackground</item>
        <item name="cardBackgroundColor">@color/yuz_surface</item>
        <item name="cardCornerRadius">@dimen/yuz_radius_card</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@color/yuz_stroke</item>
        <item name="strokeWidth">@dimen/yuz_stroke</item>
    </style>

    <style name="FuncsionTileTitle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">@dimen/yuz_space_3</item>
        <item name="android:textColor">@color/yuz_text_bright</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="FuncsionTileDesc">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">3dp</item>
        <item name="android:textColor">@color/yuz_text_secondary</item>
        <item name="android:textSize">12sp</item>
        <item name="android:lineSpacingExtra">2sp</item>
        <item name="android:minLines">2</item>
        <item name="android:maxLines">2</item>
        <item name="android:ellipsize">end</item>
    </style>

    <style name="FuncsionChevron">
        <item name="android:layout_width">18dp</item>
        <item name="android:layout_height">18dp</item>
        <item name="android:src">@drawable/ic_yuz_chevron_right</item>
        <item name="android:tint">@color/yuz_text_muted</item>
        <item name="android:contentDescription">@null</item>
    </style>

    <style name="FuncsionEq">
        <item name="android:layout_width">18dp</item>
        <item name="android:layout_height">18dp</item>
        <item name="android:layout_marginEnd">@dimen/yuz_space_2</item>
        <item name="android:contentDescription">@null</item>
        <item name="android:src">@drawable/ic_yuz_eq</item>
        <item name="android:tint">@color/yuz_action</item>
        <item name="android:visibility">gone</item>
    </style>

    <style name="FuncsionWide" parent="Widget.MaterialComponents.CardView">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">@dimen/yuz_gutter</item>
        <item name="android:layout_marginEnd">@dimen/yuz_gutter</item>
        <item name="android:layout_marginTop">@dimen/yuz_space_3</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:foreground">?attr/selectableItemBackground</item>
        <item name="cardBackgroundColor">@color/yuz_surface</item>
        <item name="cardCornerRadius">@dimen/yuz_radius_card</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@color/yuz_stroke</item>
        <item name="strokeWidth">@dimen/yuz_stroke</item>
    </style>

    <!-- Rasmli karta: media qismi (rasm + pastki fade + ikon nishoni). -->
    <style name="FuncsionTileMedia">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">104dp</item>
    </style>

    <style name="FuncsionImageBadge">
        <item name="android:layout_width">34dp</item>
        <item name="android:layout_height">34dp</item>
        <item name="android:padding">8dp</item>
        <item name="android:scaleType">fitCenter</item>
        <item name="android:tint">#FFFFFF</item>
        <item name="android:contentDescription">@null</item>
    </style>

    <style name="FuncsionTileText">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">vertical</item>
        <item name="android:paddingStart">@dimen/yuz_space_4</item>
        <item name="android:paddingTop">@dimen/yuz_space_3</item>
        <item name="android:paddingEnd">@dimen/yuz_space_4</item>
        <item name="android:paddingBottom">14dp</item>
    </style>

    <!-- "Tez orada" nishoni — rasm ustidagi kichik neon pill. -->
    <style name="FuncsionSoonBadge">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/bg_func_soon</item>
        <item name="android:paddingLeft">10dp</item>
        <item name="android:paddingTop">5dp</item>
        <item name="android:paddingRight">10dp</item>
        <item name="android:paddingBottom">5dp</item>
        <item name="android:textColor">@color/yuz_text_bright</item>
        <item name="android:textSize">10sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <!-- "Music player" — to'liq kenglikdagi jonli holat kartasi. -->
    <style name="FuncsionMusic" parent="FuncsionWide">
        <item name="cardBackgroundColor">@color/yuz_surface_raised</item>
        <item name="strokeColor">@color/yuz_stroke_action</item>
    </style>

    <style name="FuncsionMusicRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:padding">@dimen/yuz_space_4</item>
    </style>

    <style name="FuncsionMusicCover">
        <item name="android:layout_width">96dp</item>
        <item name="android:layout_height">96dp</item>
        <item name="android:scaleType">centerCrop</item>
        <item name="android:background">@drawable/bg_func_round</item>
        <item name="android:clipToOutline">true</item>
        <item name="android:contentDescription">@null</item>
    </style>

    <style name="FuncsionMusicTitle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/yuz_text_bright</item>
        <item name="android:textSize">17sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="FuncsionMusicBadge">
        <item name="android:layout_width">30dp</item>
        <item name="android:layout_height">30dp</item>
        <item name="android:padding">8dp</item>
        <item name="android:scaleType">fitCenter</item>
        <item name="android:background">@drawable/bg_yuz_play</item>
        <item name="android:src">@drawable/ic_yuz_play</item>
        <item name="android:tint">@color/yuz_on_action</item>
        <item name="android:contentDescription">@null</item>
    </style>
</resources>
