<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/yuz_space_2"
    android:background="@drawable/bg_yuz_games_panel"
    android:orientation="vertical"
    android:padding="@dimen/yuz_space_3">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <FrameLayout
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_yuz_trust_avatar">

            <TextView
                android:id="@+id/personInitials"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:textColor="@color/yuz_action"
                android:textSize="16sp"
                android:textStyle="bold" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/yuz_space_3"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/personName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/yuz_text_bright"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/personSub"
                style="@style/YuzCaption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:ellipsize="end"
                android:maxLines="2" />
        </LinearLayout>

        <TextView
            android:id="@+id/personPrimary"
            style="@style/YuzPillActive"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/yuz_space_2"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/personSecondary"
            style="@style/YuzPill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/yuz_space_1"
            android:clickable="true"
            android:focusable="true" />

        <ImageButton
            android:id="@+id/personMore"
            style="@style/YuzIconButton"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginStart="@dimen/yuz_space_1"
            android:contentDescription="@string/yuz_trust_more"
            android:padding="@dimen/yuz_space_1"
            android:src="@drawable/ic_yuz_more"
            android:tint="@color/yuz_text_secondary"
            android:visibility="gone" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/personShareRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/yuz_space_2"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">

        <TextView
            android:id="@+id/personShareLabel"
            style="@style/YuzCaption"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1" />

        <android.widget.Switch
            android:id="@+id/personShareSwitch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
    </LinearLayout>
</LinearLayout>