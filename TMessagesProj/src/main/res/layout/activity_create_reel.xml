<?xml version="1.0" encoding="utf-8"?>
<!--
  "Reel joylash" ekrani — video tanlash + birinchi kadr preview + davomiylik/hajm
  ma'lumoti, sarlavha/hashtag, monetizatsiya tugmasi, yuklash + Firestore yozish.
  CreateClassifiedAdActivity bilan bir xil Material uslubida (Theme_YuzGramAds ostida
  inflate qilinadi), shu sababli Elonlar bilan vizual bir butun ko'rinadi.

  Preview kadri LOCAL'ga MediaMetadataRetriever bilan olinadi — Storage qoidasi
  user_reels/ ostida faqat video contentType'ga ruxsat bergani uchun rasm poster
  yuklanmaydi (thumbnailUrl bo'sh qoladi, feed'da birinchi kadr ko'rsatiladi).
-->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_chat_room_gradient">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="@dimen/yuz_space_8">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:navigationIcon="@drawable/ic_back"
            app:title="@string/reels_create_title"
            app:titleTextColor="@color/yuz_text" />

        <!-- Video tanlash / preview maydoni: bo'sh holatda chaqiriq, tanlangach kadr -->
        <FrameLayout
            android:id="@+id/btnPickVideo"
            android:layout_width="match_parent"
            android:layout_height="240dp"
            android:layout_marginStart="@dimen/yuz_space_4"
            android:layout_marginEnd="@dimen/yuz_space_4"
            android:layout_marginTop="@dimen/yuz_space_2"
            android:background="@drawable/bg_classified_image_picker"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground">

            <LinearLayout
                android:id="@+id/llPickPrompt"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="@dimen/yuz_gutter">

                <FrameLayout
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:background="@drawable/bg_classified_premium_fab">

                    <ImageView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:layout_gravity="center"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_add_photo"
                        app:tint="@color/yuz_text" />
                </FrameLayout>

                <TextView
                    android:id="@+id/tvPickVideoLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/yuz_space_3"
                    android:text="@string/reels_pick_video"
                    android:textColor="@color/yuz_text"
                    android:textSize="@dimen/yuz_text_section"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/reels_pick_video_subtitle"
                    android:textColor="@color/yuz_text_secondary"
                    android:textSize="@dimen/yuz_text_secondary" />
            </LinearLayout>

            <ImageView
                android:id="@+id/ivVideoPreview"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/yuz_bg"
                android:contentDescription="@null"
                android:scaleType="centerCrop"
                android:visibility="gone" />

            <TextView
                android:id="@+id/btnPickOverlay"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:background="@drawable/bg_yuz_chip"
                android:paddingStart="@dimen/yuz_space_4"
                android:paddingTop="@dimen/yuz_space_2"
                android:paddingEnd="@dimen/yuz_space_4"
                android:paddingBottom="@dimen/yuz_space_2"
                android:text="@string/reels_change_video"
                android:textColor="@color/yuz_text"
                android:textSize="@dimen/yuz_text_secondary"
                android:textStyle="bold"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvVideoDuration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|end"
                android:layout_marginEnd="@dimen/yuz_space_3"
                android:layout_marginBottom="@dimen/yuz_space_3"
                android:background="@drawable/bg_yuz_chip"
                android:paddingStart="@dimen/yuz_space_2"
                android:paddingTop="@dimen/yuz_space_1"
                android:paddingEnd="@dimen/yuz_space_2"
                android:paddingBottom="@dimen/yuz_space_1"
                android:textColor="@color/yuz_text"
                android:textSize="@dimen/yuz_text_caption"
                android:visibility="gone" />
        </FrameLayout>

        <TextView
            android:id="@+id/tvVideoName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/yuz_space_4"
            android:layout_marginEnd="@dimen/yuz_space_4"
            android:layout_marginTop="@dimen/yuz_space_3"
            android:ellipsize="middle"
            android:singleLine="true"
            android:textColor="@color/yuz_action"
            android:textSize="@dimen/yuz_text_secondary"
            android:visibility="gone" />

        <!-- "0:24 · 18.2 MB · MP4" — tanlangach ko'rinadi -->
        <TextView
            android:id="@+id/tvVideoMeta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/yuz_space_4"
            android:layout_marginTop="@dimen/yuz_space_2"
            android:background="@drawable/bg_yuz_chip"
            android:paddingStart="@dimen/yuz_space_3"
            android:paddingTop="@dimen/yuz_space_1"
            android:paddingEnd="@dimen/yuz_space_3"
            android:paddingBottom="@dimen/yuz_space_1"
            android:textColor="@color/yuz_text_secondary"
            android:textSize="@dimen/yuz_text_caption"
            android:visibility="gone" />

        <!-- Haftalik kvot: "Haftalik limit: 2/3 ta · 50 MB gacha" (YuzReelQuota) -->
        <TextView
            android:id="@+id/tvQuotaInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/yuz_space_4"
            android:layout_marginEnd="@dimen/yuz_space_4"
            android:layout_marginTop="@dimen/yuz_space_2"
            android:textColor="@color/yuz_text_secondary"
            android:textSize="@dimen/yuz_text_secondary"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/yuz_space_4">

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/reels_caption_hint"
                app:boxBackgroundColor="@color/classified_field_bg"
                app:boxStrokeColor="@color/yuz_action"
                app:hintTextColor="@color/yuz_text_muted">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etCaption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textCapSentences"
                    android:textColor="@color/yuz_text" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/yuz_space_3"
                android:hint="@string/reels_hashtags_hint"
                app:boxBackgroundColor="@color/classified_field_bg"
                app:boxStrokeColor="@color/yuz_action"
                app:hintTextColor="@color/yuz_text_muted">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etHashtags"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="text"
                    android:textColor="@color/yuz_text" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Monetizatsiya: Reel.monetizationEnabled (donor feed daromad belgisi) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/yuz_space_4"
                android:background="@drawable/bg_profile_modern_card"
                android:gravity="center_vertical"
                android:minHeight="56dp"
                android:orientation="horizontal"
                android:paddingStart="@dimen/yuz_space_4"
                android:paddingTop="@dimen/yuz_space_2"
                android:paddingEnd="@dimen/yuz_space_3"
                android:paddingBottom="@dimen/yuz_space_2">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/reels_monetization_title"
                        android:textColor="@color/yuz_text"
                        android:textSize="@dimen/yuz_text_body"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/reels_monetization_subtitle"
                        android:textColor="@color/yuz_text_secondary"
                        android:textSize="@dimen/yuz_text_caption" />
                </LinearLayout>

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switchMonetization"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/yuz_space_2"
                    android:checked="true"
                    app:thumbTint="@color/yuz_action" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPublish"
                style="@style/YuzButton"
                android:layout_width="match_parent"
                android:layout_height="@dimen/yuz_button"
                android:layout_marginTop="@dimen/yuz_gutter"
                android:text="@string/reels_publish" />
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
