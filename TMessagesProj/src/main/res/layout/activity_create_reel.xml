<?xml version="1.0" encoding="utf-8"?>
<!--
  "Yangi reel" kompozitori: ixcham kvadrat media tanlagich + nom/tavsif formasi.

  Tanlagich 144dp kvadrat — 9:16 ramka emas, shuning uchun ekranning katta
  qismi matn maydonlariga qoladi. Kadr `clipToOutline` bilan kartaning radiusiga
  kesiladi. Poster Firebase'ga yuklanmaydi (Storage qoidasi `user_reels/` ostida
  faqat video contentType'ga ruxsat beradi) — kadr shu ekranda va profildagi
  "yuklanmoqda" katagida ko'rsatiladi.
-->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_chat_room_gradient"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="@dimen/yuz_space_8">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:navigationContentDescription="@string/AccDescrGoBack"
            app:navigationIcon="@drawable/ic_back"
            app:titleTextColor="@color/yuz_text" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:letterSpacing="-0.02"
            android:paddingStart="@dimen/yuz_gutter"
            android:paddingEnd="@dimen/yuz_gutter"
            android:paddingTop="@dimen/yuz_space_1"
            android:text="@string/reels_upload_heading"
            android:textColor="@color/yuz_text_bright"
            android:textSize="@dimen/yuz_text_display"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:paddingStart="@dimen/yuz_gutter"
            android:paddingTop="@dimen/yuz_space_1"
            android:paddingEnd="@dimen/yuz_gutter"
            android:text="@string/reels_upload_subtitle"
            android:textColor="@color/yuz_text_secondary"
            android:textSize="@dimen/yuz_text_secondary" />

        <!-- Kvadrat tanlagich · o'ngda tanlangan video holati -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="top"
            android:orientation="horizontal"
            android:paddingStart="@dimen/yuz_gutter"
            android:paddingTop="@dimen/yuz_space_4"
            android:paddingEnd="@dimen/yuz_gutter">

            <FrameLayout
                android:id="@+id/btnPickVideo"
                android:layout_width="144dp"
                android:layout_height="144dp"
                android:background="@drawable/bg_yuz_upload_hero"
                android:clickable="true"
                android:clipToOutline="true"
                android:contentDescription="@string/reels_pick_video"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground">

                <LinearLayout
                    android:id="@+id/llPickPrompt"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="@dimen/yuz_space_3">

                    <FrameLayout
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="@drawable/bg_yuz_upload_orb">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_gravity="center"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_yuz_gallery"
                            app:tint="@color/yuz_action" />
                    </FrameLayout>

                    <TextView
                        android:id="@+id/tvPickVideoLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/yuz_space_2"
                        android:gravity="center"
                        android:maxLines="2"
                        android:text="@string/reels_pick_video"
                        android:textColor="@color/yuz_text"
                        android:textSize="@dimen/yuz_text_secondary"
                        android:textStyle="bold" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/ivVideoPreview"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@color/yuz_bg"
                    android:contentDescription="@null"
                    android:scaleType="centerCrop"
                    android:visibility="gone" />

                <!-- Kadr ustidagi qoraytirish: davomiylik chip'i o'qilishi uchun -->
                <View
                    android:id="@+id/previewScrim"
                    android:layout_width="match_parent"
                    android:layout_height="64dp"
                    android:layout_gravity="bottom"
                    android:background="@drawable/bg_yuz_media_scrim_bottom"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tvVideoDuration"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|start"
                    android:layout_marginStart="@dimen/yuz_space_2"
                    android:layout_marginBottom="@dimen/yuz_space_2"
                    android:background="@drawable/bg_yuz_chip"
                    android:paddingStart="@dimen/yuz_space_2"
                    android:paddingTop="@dimen/yuz_space_1"
                    android:paddingEnd="@dimen/yuz_space_2"
                    android:paddingBottom="@dimen/yuz_space_1"
                    android:textColor="@color/yuz_text"
                    android:textSize="@dimen/yuz_text_caption"
                    android:textStyle="bold"
                    android:visibility="gone" />

                <!-- "Boshqa video" — ixcham aylana ikonka -->
                <FrameLayout
                    android:id="@+id/btnPickOverlay"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_gravity="top|end"
                    android:layout_marginTop="@dimen/yuz_space_2"
                    android:layout_marginEnd="@dimen/yuz_space_2"
                    android:background="@drawable/bg_yuz_chip"
                    android:contentDescription="@string/reels_change_video"
                    android:visibility="gone">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_gravity="center"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_yuz_gallery"
                        app:tint="@color/yuz_action" />
                </FrameLayout>

                <ProgressBar
                    android:id="@+id/progressAnalyze"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_gravity="center"
                    android:indeterminateTint="@color/yuz_action"
                    android:visibility="gone" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="144dp"
                android:layout_marginStart="@dimen/yuz_space_4"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvMediaPlaceholder"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:text="@string/reels_media_empty_title"
                    android:textColor="@color/yuz_text_bright"
                    android:textSize="@dimen/yuz_text_button"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvVideoName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="middle"
                    android:includeFontPadding="false"
                    android:singleLine="true"
                    android:textColor="@color/yuz_text"
                    android:textSize="@dimen/yuz_text_body"
                    android:textStyle="bold"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tvVideoMeta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/yuz_space_1"
                    android:lineSpacingExtra="3sp"
                    android:maxLines="3"
                    android:text="@string/reels_media_empty_hint"
                    android:textColor="@color/yuz_text_secondary"
                    android:textSize="@dimen/yuz_text_caption" />
            </LinearLayout>
        </LinearLayout>

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/yuz_gutter"
            android:layout_marginTop="@dimen/yuz_space_5"
            android:layout_marginEnd="@dimen/yuz_gutter"
            android:hint="@string/reels_name_hint"
            app:boxBackgroundColor="@color/yuz_field"
            app:boxCornerRadiusBottomEnd="@dimen/yuz_radius_field"
            app:boxCornerRadiusBottomStart="@dimen/yuz_radius_field"
            app:boxCornerRadiusTopEnd="@dimen/yuz_radius_field"
            app:boxCornerRadiusTopStart="@dimen/yuz_radius_field"
            app:boxStrokeColor="@color/yuz_field_stroke"
            app:boxStrokeErrorColor="@color/yuz_danger"
            app:boxStrokeWidth="@dimen/yuz_stroke"
            app:boxStrokeWidthFocused="2dp"
            app:counterEnabled="true"
            app:counterMaxLength="100"
            app:counterTextColor="@color/yuz_text_muted"
            app:errorTextColor="@color/yuz_danger"
            app:hintTextColor="@color/yuz_text_muted">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etReelName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:imeOptions="actionNext"
                android:inputType="textCapSentences"
                android:maxLength="100"
                android:maxLines="1"
                android:textColor="@color/yuz_text"
                android:textSize="@dimen/yuz_text_button" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="132dp"
            android:layout_marginStart="@dimen/yuz_gutter"
            android:layout_marginTop="@dimen/yuz_space_3"
            android:layout_marginEnd="@dimen/yuz_gutter"
            android:hint="@string/reels_description_hint"
            app:boxBackgroundColor="@color/yuz_field"
            app:boxCornerRadiusBottomEnd="@dimen/yuz_radius_field"
            app:boxCornerRadiusBottomStart="@dimen/yuz_radius_field"
            app:boxCornerRadiusTopEnd="@dimen/yuz_radius_field"
            app:boxCornerRadiusTopStart="@dimen/yuz_radius_field"
            app:boxStrokeColor="@color/yuz_field_stroke"
            app:boxStrokeWidth="@dimen/yuz_stroke"
            app:boxStrokeWidthFocused="2dp"
            app:counterEnabled="true"
            app:counterMaxLength="800"
            app:counterTextColor="@color/yuz_text_muted"
            app:hintTextColor="@color/yuz_text_muted">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etCaption"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="top|start"
                android:inputType="textCapSentences|textMultiLine"
                android:maxLength="800"
                android:scrollbars="vertical"
                android:textColor="@color/yuz_text"
                android:textSize="@dimen/yuz_text_button" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Kunlik limit / hajm chegarasi (YuzReelQuota) -->
        <LinearLayout
            android:id="@+id/quotaCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/yuz_gutter"
            android:layout_marginTop="@dimen/yuz_space_3"
            android:layout_marginEnd="@dimen/yuz_gutter"
            android:background="@drawable/bg_yuz_upload_info"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/yuz_space_3"
            android:paddingTop="@dimen/yuz_space_2"
            android:paddingEnd="@dimen/yuz_space_3"
            android:paddingBottom="@dimen/yuz_space_2"
            android:visibility="gone">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_yuz_timer"
                app:tint="@color/yuz_action" />

            <TextView
                android:id="@+id/tvQuotaInfo"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/yuz_space_2"
                android:layout_weight="1"
                android:textColor="@color/yuz_text_secondary"
                android:textSize="@dimen/yuz_text_secondary" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPublish"
            style="@style/YuzButton"
            android:layout_width="match_parent"
            android:layout_height="@dimen/yuz_button"
            android:layout_marginStart="@dimen/yuz_gutter"
            android:layout_marginTop="@dimen/yuz_space_5"
            android:layout_marginEnd="@dimen/yuz_gutter"
            android:text="@string/reels_publish" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/yuz_gutter"
            android:layout_marginTop="@dimen/yuz_space_2"
            android:layout_marginEnd="@dimen/yuz_gutter"
            android:gravity="center"
            android:text="@string/reels_upload_hint_bg"
            android:textColor="@color/yuz_text_muted"
            android:textSize="@dimen/yuz_text_caption" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
