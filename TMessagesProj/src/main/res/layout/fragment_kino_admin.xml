<?xml version="1.0" encoding="utf-8"?>
<!--
  YuzGram admin paneli (#77) — login/parol (claimAdminSession) dan so'ng besh tab:
  Dashboard (haqiqiy statistika: comment_profiles.lastActiveAt + reels + movies),
  Kinolar (CRUD), Reels (ko'rish/hujjat holati + o'chirish), Limitlar (reels
  kunlik/hajm chegaralari), Reklama (chatlar va Funksiyalar bannerlari CRUD).
  Kinolar ekrani kirish tugmasi bu yerga ko'chirildi: endi ochilish joyi —
  Sozlamalar ro'yxatidagi "Admin panel" qatori (ProfileActivity).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_chat_room_gradient"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/kinoAdminTopBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/yuz_space_1"
        android:paddingTop="@dimen/yuz_space_2"
        android:paddingEnd="@dimen/yuz_space_4"
        android:paddingBottom="@dimen/yuz_space_2">

        <ImageButton
            android:id="@+id/btnKinoAdminBack"
            style="@style/YuzIconButton"
            android:contentDescription="@string/kino_back"
            android:src="@drawable/ic_back" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/kino_admin_title"
            android:textColor="@color/yuz_text"
            android:textSize="@dimen/yuz_text_title"
            android:textStyle="bold" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:id="@+id/loginPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:paddingStart="@dimen/yuz_space_6"
            android:paddingEnd="@dimen/yuz_space_6">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/kino_admin_title"
                android:textColor="@color/yuz_text"
                android:textSize="@dimen/yuz_text_title"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/yuz_space_1"
                android:layout_marginBottom="@dimen/yuz_gutter"
                android:gravity="center"
                android:text="@string/kino_admin_desc"
                android:textColor="@color/yuz_text_secondary"
                android:textSize="@dimen/yuz_text_secondary" />

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/kino_admin_hint_user">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etKinoAdminUser"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="text"
                    android:maxLines="1" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/yuz_space_3"
                android:hint="@string/kino_admin_hint_pass"
                app:passwordToggleEnabled="true">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etKinoAdminPass"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textPassword"
                    android:maxLines="1" />
            </com.google.android.material.textfield.TextInputLayout>

            <ProgressBar
                android:id="@+id/kinoLoginProgress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="@dimen/yuz_space_3"
                android:indeterminateTint="@color/yuz_action"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnKinoAdminLogin"
                android:layout_width="match_parent"
                android:layout_height="@dimen/yuz_button"
                android:layout_marginTop="@dimen/yuz_space_4"
                style="@style/YuzButton"
                android:text="@string/kino_admin_login" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/managePanel"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone">

            <!-- Tab chiplari -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="@dimen/yuz_space_4"
                android:paddingEnd="@dimen/yuz_space_4"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/btnTabDash"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="@dimen/yuz_space_2"
                        android:background="@drawable/bg_classified_category_badge"
                        android:clickable="true"
                        android:focusable="true"
                        android:paddingStart="@dimen/yuz_space_4"
                        android:paddingTop="@dimen/yuz_space_2"
                        android:paddingEnd="@dimen/yuz_space_4"
                        android:paddingBottom="@dimen/yuz_space_2"
                        android:text="@string/yuz_admin_tab_dash"
                        android:textColor="@color/yuz_action"
                        android:textSize="@dimen/yuz_text_secondary"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/btnTabMovies"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="@dimen/yuz_space_2"
                        android:background="@drawable/bg_yuz_chip"
                        android:clickable="true"
                        android:focusable="true"
                        android:paddingStart="@dimen/yuz_space_4"
                        android:paddingTop="@dimen/yuz_space_2"
                        android:paddingEnd="@dimen/yuz_space_4"
                        android:paddingBottom="@dimen/yuz_space_2"
                        android:text="@string/yuz_admin_tab_movies"
                        android:textColor="@color/yuz_text_secondary"
                        android:textSize="@dimen/yuz_text_secondary" />

                    <TextView
                        android:id="@+id/btnTabReels"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="@dimen/yuz_space_2"
                        android:background="@drawable/bg_yuz_chip"
                        android:clickable="true"
                        android:focusable="true"
                        android:paddingStart="@dimen/yuz_space_4"
                        android:paddingTop="@dimen/yuz_space_2"
                        android:paddingEnd="@dimen/yuz_space_4"
                        android:paddingBottom="@dimen/yuz_space_2"
                        android:text="@string/yuz_admin_tab_reels"
                        android:textColor="@color/yuz_text_secondary"
                        android:textSize="@dimen/yuz_text_secondary" />

                    <TextView
                        android:id="@+id/btnTabLimits"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="@dimen/yuz_space_2"
                        android:background="@drawable/bg_yuz_chip"
                        android:clickable="true"
                        android:focusable="true"
                        android:paddingStart="@dimen/yuz_space_4"
                        android:paddingTop="@dimen/yuz_space_2"
                        android:paddingEnd="@dimen/yuz_space_4"
                        android:paddingBottom="@dimen/yuz_space_2"
                        android:text="@string/yuz_admin_tab_limits"
                        android:textColor="@color/yuz_text_secondary"
                        android:textSize="@dimen/yuz_text_secondary" />

                    <TextView
                        android:id="@+id/btnTabAds"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="@dimen/yuz_space_2"
                        android:background="@drawable/bg_yuz_chip"
                        android:clickable="true"
                        android:focusable="true"
                        android:paddingStart="@dimen/yuz_space_4"
                        android:paddingTop="@dimen/yuz_space_2"
                        android:paddingEnd="@dimen/yuz_space_4"
                        android:paddingBottom="@dimen/yuz_space_2"
                        android:text="@string/yuz_admin_tab_ads"
                        android:textColor="@color/yuz_text_secondary"
                        android:textSize="@dimen/yuz_text_secondary" />

                    <TextView
                        android:id="@+id/btnTabModeration"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_yuz_chip"
                        android:clickable="true"
                        android:focusable="true"
                        android:paddingStart="@dimen/yuz_space_4"
                        android:paddingTop="@dimen/yuz_space_2"
                        android:paddingEnd="@dimen/yuz_space_4"
                        android:paddingBottom="@dimen/yuz_space_2"
                        android:text="@string/yuz_admin_tab_moderation"
                        android:textColor="@color/yuz_text_secondary"
                        android:textSize="@dimen/yuz_text_secondary" />
                </LinearLayout>
            </HorizontalScrollView>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

                <!-- ─── Dashboard ─── -->
                <androidx.core.widget.NestedScrollView
                    android:id="@+id/dashPanel"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipToPadding="false"
                    android:paddingStart="@dimen/yuz_space_3"
                    android:paddingTop="@dimen/yuz_space_3"
                    android:paddingEnd="@dimen/yuz_space_3"
                    android:paddingBottom="@dimen/yuz_space_6">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/yuz_space_1"
                            android:layout_marginEnd="@dimen/yuz_space_1"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/tvStatsUpdated"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:textColor="@color/yuz_text_muted"
                                android:textSize="@dimen/yuz_text_caption" />

                            <TextView
                                android:id="@+id/btnRefreshStats"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="@drawable/bg_yuz_chip"
                                android:clickable="true"
                                android:focusable="true"
                                android:paddingStart="@dimen/yuz_space_3"
                                android:paddingTop="@dimen/yuz_space_2"
                                android:paddingEnd="@dimen/yuz_space_3"
                                android:paddingBottom="@dimen/yuz_space_2"
                                android:text="@string/yuz_admin_refresh"
                                android:textColor="@color/yuz_action"
                                android:textSize="@dimen/yuz_text_secondary"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <ProgressBar
                            android:id="@+id/progressDash"
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:layout_gravity="center"
                            android:layout_marginTop="@dimen/yuz_space_6"
                            android:indeterminateTint="@color/yuz_action"
                            android:visibility="gone" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/yuz_space_1"
                            android:layout_marginTop="@dimen/yuz_space_3"
                            android:text="@string/yuz_admin_group_users"
                            android:textColor="@color/yuz_text"
                            android:textSize="@dimen/yuz_text_secondary"
                            android:textStyle="bold" />

                        <GridLayout
                            android:id="@+id/gridUsersStats"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:columnCount="2" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/yuz_space_1"
                            android:layout_marginTop="@dimen/yuz_space_3"
                            android:text="@string/yuz_admin_group_content"
                            android:textColor="@color/yuz_text"
                            android:textSize="@dimen/yuz_text_secondary"
                            android:textStyle="bold" />

                        <GridLayout
                            android:id="@+id/gridContentStats"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:columnCount="2" />

                        <TextView
                            android:id="@+id/tvRecentTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/yuz_space_1"
                            android:layout_marginTop="@dimen/yuz_space_3"
                            android:text="@string/yuz_admin_recent"
                            android:textColor="@color/yuz_text"
                            android:textSize="@dimen/yuz_text_secondary"
                            android:textStyle="bold"
                            android:visibility="gone" />

                        <LinearLayout
                            android:id="@+id/llRecentUsers"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical" />
                    </LinearLayout>
                </androidx.core.widget.NestedScrollView>

                <!-- ─── Kinolar ─── -->
                <FrameLayout
                    android:id="@+id/moviesPanel"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:visibility="gone">

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rvAdminMovies"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:clipToPadding="false"
                        android:paddingStart="@dimen/yuz_space_4"
                        android:paddingTop="@dimen/yuz_space_2"
                        android:paddingEnd="@dimen/yuz_space_4"
                        android:paddingBottom="96dp" />

                    <TextView
                        android:id="@+id/tvAdminEmpty"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:text="@string/kino_empty"
                        android:textColor="@color/yuz_text_secondary"
                        android:textSize="@dimen/yuz_text_body"
                        android:visibility="gone" />

                    <ProgressBar
                        android:id="@+id/progressAdminMovies"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:indeterminateTint="@color/yuz_action" />

                    <com.google.android.material.floatingactionbutton.FloatingActionButton
                        android:id="@+id/btnAddKino"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="bottom|end"
                        android:layout_margin="@dimen/yuz_gutter"
                        android:contentDescription="@string/kino_admin_add"
                        app:backgroundTint="@color/yuz_action"
                        app:srcCompat="@drawable/ic_add"
                        android:tint="@color/yuz_on_action" />
                </FrameLayout>

                <!-- ─── Reels ─── -->
                <FrameLayout
                    android:id="@+id/reelsPanel"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:visibility="gone">

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rvAdminReels"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:clipToPadding="false"
                        android:paddingStart="@dimen/yuz_space_4"
                        android:paddingTop="@dimen/yuz_space_2"
                        android:paddingEnd="@dimen/yuz_space_4"
                        android:paddingBottom="@dimen/yuz_space_6" />

                    <TextView
                        android:id="@+id/tvReelsEmpty"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:text="@string/reels_empty"
                        android:textColor="@color/yuz_text_secondary"
                        android:textSize="@dimen/yuz_text_body"
                        android:visibility="gone" />

                    <ProgressBar
                        android:id="@+id/progressAdminReels"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:indeterminateTint="@color/yuz_action"
                        android:visibility="gone" />

                    <com.google.android.material.floatingactionbutton.FloatingActionButton
                        android:id="@+id/btnAddReel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="bottom|end"
                        android:layout_margin="@dimen/yuz_gutter"
                        android:contentDescription="@string/yuz_admin_reel_add"
                        app:backgroundTint="@color/yuz_action"
                        app:srcCompat="@drawable/ic_add"
                        android:tint="@color/yuz_on_action" />
                </FrameLayout>

                <!-- ─── Limitlar ─── -->
                <androidx.core.widget.NestedScrollView
                    android:id="@+id/limitsPanel"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipToPadding="false"
                    android:paddingStart="@dimen/yuz_space_4"
                    android:paddingTop="@dimen/yuz_space_3"
                    android:paddingEnd="@dimen/yuz_space_4"
                    android:paddingBottom="@dimen/yuz_space_6"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/yuz_admin_limits_title"
                            android:textColor="@color/yuz_text"
                            android:textSize="@dimen/yuz_text_body"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/yuz_space_1"
                            android:text="@string/yuz_admin_limits_desc"
                            android:textColor="@color/yuz_text_secondary"
                            android:textSize="@dimen/yuz_text_caption" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/yuz_space_4"
                            android:orientation="horizontal">

                            <com.google.android.material.textfield.TextInputLayout
                                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:hint="@string/yuz_admin_limit_regular">

                                <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/etAdminLimitRegularDaily"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:inputType="number"
                                    android:maxLines="1" />
                            </com.google.android.material.textfield.TextInputLayout>

                            <com.google.android.material.textfield.TextInputLayout
                                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/yuz_space_3"
                                android:layout_weight="1"
                                android:hint="@string/yuz_admin_limit_premium">

                                <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/etAdminLimitPremiumDaily"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:inputType="number"
                                    android:maxLines="1" />
                            </com.google.android.material.textfield.TextInputLayout>
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/yuz_space_3"
                            android:orientation="horizontal">

                            <com.google.android.material.textfield.TextInputLayout
                                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:hint="@string/yuz_admin_limit_regular_mb">

                                <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/etAdminLimitRegularMb"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:inputType="number"
                                    android:maxLines="1" />
                            </com.google.android.material.textfield.TextInputLayout>

                            <com.google.android.material.textfield.TextInputLayout
                                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/yuz_space_3"
                                android:layout_weight="1"
                                android:hint="@string/yuz_admin_limit_premium_mb">

                                <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/etAdminLimitPremiumMb"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:inputType="number"
                                    android:maxLines="1" />
                            </com.google.android.material.textfield.TextInputLayout>
                        </LinearLayout>

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/yuz_space_2"
                            android:text="@string/yuz_admin_limits_unlimited_hint"
                            android:textColor="@color/yuz_text_muted"
                            android:textSize="@dimen/yuz_text_caption" />

                        <ProgressBar
                            android:id="@+id/progressLimits"
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:layout_gravity="center"
                            android:layout_marginTop="@dimen/yuz_space_4"
                            android:indeterminateTint="@color/yuz_action"
                            android:visibility="gone" />

                        <TextView
                            android:id="@+id/tvLimitsUpdated"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/yuz_space_3"
                            android:textColor="@color/yuz_text_muted"
                            android:textSize="@dimen/yuz_text_caption" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnSaveLimits"
                            style="@style/YuzButton"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/yuz_button"
                            android:layout_marginTop="@dimen/yuz_space_3"
                            android:text="@string/yuz_admin_limits_save" />
                    </LinearLayout>
                </androidx.core.widget.NestedScrollView>

                <!-- ─── Reklama ─── -->
                <FrameLayout
                    android:id="@+id/adsPanel"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:visibility="gone">

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rvAdminAds"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:clipToPadding="false"
                        android:paddingStart="@dimen/yuz_space_4"
                        android:paddingTop="@dimen/yuz_space_2"
                        android:paddingEnd="@dimen/yuz_space_4"
                        android:paddingBottom="96dp" />

                    <TextView
                        android:id="@+id/tvAdminAdsEmpty"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:gravity="center"
                        android:paddingStart="@dimen/yuz_space_6"
                        android:paddingEnd="@dimen/yuz_space_6"
                        android:text="@string/yuz_admin_ads_empty"
                        android:textColor="@color/yuz_text_secondary"
                        android:textSize="@dimen/yuz_text_body"
                        android:visibility="gone" />

                    <ProgressBar
                        android:id="@+id/progressAdminAds"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:indeterminateTint="@color/yuz_action"
                        android:visibility="gone" />

                    <com.google.android.material.floatingactionbutton.FloatingActionButton
                        android:id="@+id/btnAddAd"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="bottom|end"
                        android:layout_margin="@dimen/yuz_gutter"
                        android:contentDescription="@string/yuz_admin_ad_add"
                        app:backgroundTint="@color/yuz_action"
                        app:srcCompat="@drawable/ic_add"
                        android:tint="@color/yuz_on_action" />
                </FrameLayout>

                <!-- ─── E'lonlar moderatsiyasi ─── -->
                <LinearLayout
                    android:id="@+id/moderationPanel"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:paddingStart="@dimen/yuz_space_4"
                    android:paddingTop="@dimen/yuz_space_3"
                    android:paddingEnd="@dimen/yuz_space_4"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_profile_modern_card"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="@dimen/yuz_space_3">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/yuz_admin_moderation_auto"
                                android:textColor="@color/yuz_text"
                                android:textSize="@dimen/yuz_text_body"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="@string/yuz_admin_moderation_auto_hint"
                                android:textColor="@color/yuz_text_secondary"
                                android:textSize="@dimen/yuz_text_caption" />
                        </LinearLayout>

                        <com.google.android.material.switchmaterial.SwitchMaterial
                            android:id="@+id/swAdminModerationAuto"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/yuz_space_2"
                            app:useMaterialThemeColors="true" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvModerationPending"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/yuz_space_3"
                        android:textColor="@color/yuz_text"
                        android:textSize="@dimen/yuz_text_secondary"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvModerationUpdated"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textColor="@color/yuz_text_muted"
                        android:textSize="@dimen/yuz_text_caption"
                        android:visibility="gone" />

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_marginTop="@dimen/yuz_space_2"
                        android:layout_weight="1">

                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/rvAdminModeration"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:clipToPadding="false"
                            android:paddingTop="@dimen/yuz_space_1"
                            android:paddingBottom="96dp" />

                        <TextView
                            android:id="@+id/tvAdminModerationEmpty"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:gravity="center"
                            android:paddingStart="@dimen/yuz_space_6"
                            android:paddingEnd="@dimen/yuz_space_6"
                            android:text="@string/yuz_admin_moderation_empty"
                            android:textColor="@color/yuz_text_secondary"
                            android:textSize="@dimen/yuz_text_body"
                            android:visibility="gone" />

                        <ProgressBar
                            android:id="@+id/progressAdminModeration"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:indeterminateTint="@color/yuz_action"
                            android:visibility="gone" />
                    </FrameLayout>
                </LinearLayout>
            </FrameLayout>
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
