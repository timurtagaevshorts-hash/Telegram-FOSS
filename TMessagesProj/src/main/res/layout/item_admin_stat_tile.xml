<?xml version="1.0" encoding="utf-8"?>
<!-- Admin dashboard kartasi: katta son + ostida label (GridLayout'ga code bilan qo'shiladi) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:layout_margin="5dp"
    android:background="@drawable/bg_profile_modern_card"
    android:orientation="vertical"
    android:paddingStart="@dimen/yuz_space_3"
    android:paddingTop="@dimen/yuz_space_3"
    android:paddingEnd="@dimen/yuz_space_3"
    android:paddingBottom="@dimen/yuz_space_3">

    <TextView
        android:id="@+id/tvStatValue"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="0"
        android:textColor="@color/yuz_action"
        android:textSize="@dimen/yuz_text_title"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvStatLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:ellipsize="end"
        android:maxLines="2"
        android:textColor="@color/yuz_text_secondary"
        android:textSize="@dimen/yuz_text_caption" />
</LinearLayout>
