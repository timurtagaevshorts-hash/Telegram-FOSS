<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/home_bg">

    <!--
      Vertikal "paging" RecyclerView. ViewPager2 ATALDI — Telegram `androidx.recyclerview`
      AAR'ini butunlay exclude qilgan va o'z ichidagi (vendored) nusxasidan foydalanadi
      (qarang TMessagesProj/build.gradle: configurations.all { exclude ... }).
      ViewPager2 AAR'i esa rasmiy recyclerview 1.0.0 bilan kompilyatsiya qilingan —
      u holda kichik bir API nommosligi runtime'da NoSuchMethodError berardi.
      Shuning uchun bu yerda FAQAT shu repodagi sinovdan o'tgan klasslar:
      RecyclerView + LinearLayoutManager(VERTICAL) + PagerSnapHelper.
    -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvReels"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:overScrollMode="never"
        android:scrollbars="none" />

    <!-- Yuqori overlay: sarlavha + "Reel joylash" (ustida qoraytirgich gradient) -->
    <LinearLayout
        android:id="@+id/reelsTopBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:background="@drawable/bg_reel_top_scrim"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="12dp"
        android:paddingTop="12dp"
        android:paddingBottom="10dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/reels_title"
            android:textColor="@color/text_primary"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnMute"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="@string/reels_sound_on"
            android:foreground="?attr/selectableItemBackgroundBorderless"
            android:padding="8dp"
            android:text="@string/reels_sound_on"
            android:textColor="@color/white"
            android:textSize="19sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPostReel"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/reels_post"
            android:textColor="@color/home_accent"
            android:textStyle="bold" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/progressReels"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:indeterminateTint="@color/home_accent"
        android:visibility="gone" />

    <TextView
        android:id="@+id/emptyReels"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:text="@string/reels_empty"
        android:textColor="@color/text_secondary"
        android:textSize="15sp"
        android:visibility="gone" />

</FrameLayout>
