<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/home_bg">

    <!--
      Vertikal "paging" RecyclerView. ViewPager2 ATALDI — Telegram `androidx.recyclerview`
      AAR'ini butunlay exclude qilgan va o'z ichidagi (vendored) nusxasidan foydalanadi
      (qarang TMessagesProj/build.gradle: configurations.all { exclude ... }).
      ViewPager2 AAR'i esa rasmiy recyclerview 1.0.0 bilan kompilyatsiya qilingan —
      u holda kichik bir API nommosligi runtime'da NoSuchMethodError berardi.
      Shuning uchun bu yerda FAQAT shu repodagi sinovdan o'tgan klasslar:
      RecyclerView + LinearLayoutManager(VERTICAL) + PagerSnapHelper.
    -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvReels"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:overScrollMode="never"
        android:scrollbars="none" />

    <!-- Yuqori qatlam: sarlavha qatori + storiya chiplari (chatdan ko'chirildi).
         Fullscreen rejimida butunliqcha yashiriladi. -->
    <LinearLayout
        android:id="@+id/reelsHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/reelsTopBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_reel_top_scrim"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="@dimen/yuz_space_4"
            android:paddingEnd="@dimen/yuz_space_3"
            android:paddingTop="@dimen/yuz_space_3"
            android:paddingBottom="@dimen/yuz_space_3">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/reels_title"
                android:textColor="@color/yuz_text"
                android:textSize="@dimen/yuz_text_title"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/btnMute"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_yuz_reel_action"
                android:contentDescription="@string/reels_sound_off"
                android:foreground="?attr/selectableItemBackgroundBorderless"
                android:padding="@dimen/yuz_space_3"
                android:src="@drawable/ic_yuz_volume_off"
                android:tint="@color/yuz_text" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPostReel"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/reels_post"
                android:textColor="@color/yuz_action"
                android:textStyle="bold"
                app:icon="@drawable/ic_yuz_add"
                app:iconGravity="textStart"
                app:iconSize="18dp"
                app:iconTint="@color/yuz_action" />
        </LinearLayout>

        <!-- #70: storiya qatori — chatdan Reels tepasiga ko'chirildi. -->
        <LinearLayout
            android:id="@+id/storyRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_reel_top_scrim"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/yuz_space_4"
            android:paddingEnd="@dimen/yuz_space_3"
            android:paddingBottom="@dimen/yuz_space_3">

            <TextView
                android:id="@+id/btnStoryPost"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/yuz_space_2"
                android:background="@drawable/bg_classified_category_badge"
                android:drawablePadding="6dp"
                android:drawableStart="@drawable/msg_stories_add"
                android:drawableTint="@color/yuz_text"
                android:foreground="?attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:paddingStart="@dimen/yuz_space_3"
                android:paddingTop="@dimen/yuz_space_2"
                android:paddingEnd="@dimen/yuz_space_3"
                android:paddingBottom="@dimen/yuz_space_2"
                android:text="@string/story_post"
                android:textColor="@color/yuz_text"
                android:textSize="@dimen/yuz_text_secondary" />

            <TextView
                android:id="@+id/btnStoryView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_classified_category_badge"
                android:drawablePadding="6dp"
                android:drawableStart="@drawable/ic_yuz_film"
                android:drawableTint="@color/yuz_text"
                android:foreground="?attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:paddingStart="@dimen/yuz_space_3"
                android:paddingTop="@dimen/yuz_space_2"
                android:paddingEnd="@dimen/yuz_space_3"
                android:paddingBottom="@dimen/yuz_space_2"
                android:text="@string/story_view"
                android:textColor="@color/yuz_text"
                android:textSize="@dimen/yuz_text_secondary" />
        </LinearLayout>
    </LinearLayout>

    <!-- StoryRecorder uchun yashirin langar: 56dp FAB (ko'rinmaydi, lekin
         layout olgan — SourceView.fromFloatingButton uning birinchi farzandi
         ekran koordinatalarini oladi va show/hide'ni shu idorchaga bog'laydi). -->
    <FrameLayout
        android:id="@+id/storyFab"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="96dp"
        android:layout_marginEnd="@dimen/yuz_space_6"
        android:alpha="0"
        android:clickable="false"
        android:focusable="false">

        <ImageView
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:contentDescription="@null"
            android:padding="@dimen/yuz_space_4"
            android:src="@drawable/msg_stories_add"
            android:tint="@color/yuz_text" />
    </FrameLayout>

    <!-- Fullscreen rejimda ko'rinadigan yopish tugmasi (sarlavha o'rniga) -->
    <ImageView
        android:id="@+id/btnFsClose"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="@dimen/yuz_space_4"
        android:layout_marginEnd="@dimen/yuz_space_3"
        android:background="@drawable/bg_yuz_reel_action"
        android:contentDescription="@string/yuz_a11y_close"
        android:foreground="?attr/selectableItemBackgroundBorderless"
        android:padding="@dimen/yuz_space_3"
        android:src="@drawable/ic_yuz_close"
        android:tint="@color/yuz_text"
        android:visibility="gone" />

    <ProgressBar
        android:id="@+id/progressReels"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:indeterminateTint="@color/yuz_action"
        android:visibility="gone" />

    <TextView
        android:id="@+id/emptyReels"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:drawablePadding="12dp"
        android:drawableTop="@drawable/ic_yuz_film"
        android:gravity="center"
        android:paddingStart="@dimen/yuz_space_6"
        android:paddingEnd="@dimen/yuz_space_6"
        android:text="@string/reels_empty"
        android:textColor="@color/yuz_text_secondary"
        android:textSize="15sp"
        android:visibility="gone" />

    <!--
      Izohlar qatlami — KinoTOP4'dagi BottomSheetDialogFragment o'rniga shu
      ekran ichidagi pastki panel. Sabab: pastki navigatsiya bari Butun ekran
      ustida (LaunchActivity darajasida) doimiy turadi, alohida dialog esa uni
      qoplab, foydachini "bar yo'qoldi" chalkashtirardi. Panel qismiy balandlikda
      ochiladi (ReelsActivity'da kod bilan o'lchanadi) va pastdan bar balandligi
      qadar bo'shliq oladi.
    -->
    <View
        android:id="@+id/commentsScrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#80000000"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/commentsPanel"
        android:layout_width="match_parent"
        android:layout_height="380dp"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_reels_comments"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/yuz_space_4"
            android:paddingTop="@dimen/yuz_space_3"
            android:paddingEnd="@dimen/yuz_space_2"
            android:paddingBottom="@dimen/yuz_space_2">

            <TextView
                android:id="@+id/tvCommentsTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/reels_comments"
                android:textColor="@color/yuz_text"
                android:textSize="@dimen/yuz_text_section"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/btnCloseComments"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:contentDescription="@string/reels_comments_close"
                android:foreground="?attr/selectableItemBackgroundBorderless"
                android:padding="@dimen/yuz_space_2"
                android:src="@drawable/ic_yuz_close"
                android:tint="@color/yuz_text_secondary" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvComments"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:overScrollMode="never"
                android:paddingBottom="@dimen/yuz_space_2"
                android:scrollbars="none" />

            <ProgressBar
                android:id="@+id/progressComments"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_gravity="center"
                android:indeterminateTint="@color/yuz_action"
                android:visibility="gone" />

            <TextView
                android:id="@+id/emptyComments"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:paddingStart="@dimen/yuz_space_6"
                android:paddingEnd="@dimen/yuz_space_6"
                android:text="@string/reels_comments_empty"
                android:textColor="@color/yuz_text_secondary"
                android:textSize="@dimen/yuz_text_body"
                android:visibility="gone" />
        </FrameLayout>

        <TextView
            android:id="@+id/tvReplyHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/yuz_space_4"
            android:layout_marginEnd="@dimen/yuz_space_4"
            android:background="@drawable/bg_classified_category_badge"
            android:ellipsize="end"
            android:maxLines="1"
            android:paddingStart="@dimen/yuz_space_3"
            android:paddingTop="5dp"
            android:paddingEnd="@dimen/yuz_space_3"
            android:paddingBottom="5dp"
            android:textColor="@color/yuz_action"
            android:textSize="@dimen/yuz_text_secondary"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/yuz_space_4"
            android:paddingTop="@dimen/yuz_space_2"
            android:paddingEnd="@dimen/yuz_space_3"
            android:paddingBottom="@dimen/yuz_space_3">

            <EditText
                android:id="@+id/etComment"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/bg_reels_comment_input"
                android:hint="@string/reels_comment_hint"
                android:imeOptions="actionSend"
                android:inputType="textShortMessage|textCapSentences"
                android:maxLines="4"
                android:minLines="1"
                android:paddingStart="@dimen/yuz_space_4"
                android:paddingTop="@dimen/yuz_space_2"
                android:paddingEnd="@dimen/yuz_space_4"
                android:paddingBottom="@dimen/yuz_space_2"
                android:textColor="@color/yuz_text"
                android:textColorHint="@color/yuz_text_secondary"
                android:textSize="@dimen/yuz_text_body" />

            <ImageView
                android:id="@+id/btnSendComment"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="@dimen/yuz_space_2"
                android:background="@drawable/bg_reels_send"
                android:contentDescription="@string/reels_comment_send"
                android:foreground="?attr/selectableItemBackgroundBorderless"
                android:padding="@dimen/yuz_space_3"
                android:src="@drawable/ic_yuz_send"
                android:tint="@color/yuz_text" />
        </LinearLayout>
    </LinearLayout>

</FrameLayout>
