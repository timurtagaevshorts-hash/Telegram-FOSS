<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/modern_surface">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/jobCardsAppBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/modern_surface"
        app:elevation="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_scrollFlags="scroll|enterAlways">

            <!-- #75: Elonlar bilan bir xil uslubdagi sarlavha (ikonka + ikki qator matn). -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="@dimen/yuz_gutter"
                android:paddingTop="@dimen/yuz_space_4"
                android:paddingEnd="@dimen/yuz_gutter"
                android:paddingBottom="@dimen/yuz_space_2">

                <ImageView
                    android:id="@+id/ivJobIcon"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_centerVertical="true"
                    android:src="@drawable/ic_yuz_briefcase"
                    android:tint="@color/yuz_action" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/yuz_space_3"
                    android:layout_toEndOf="@id/ivJobIcon"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/job_board_title"
                        android:textColor="@color/yuz_text"
                        android:textSize="@dimen/yuz_text_title"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/job_board_subtitle"
                        android:textColor="@color/yuz_text_secondary"
                        android:textSize="@dimen/yuz_text_secondary" />
                </LinearLayout>
            </RelativeLayout>

            <com.google.android.material.tabs.TabLayout
                android:id="@+id/tabJobSections"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/modern_surface"
                app:tabIndicatorColor="@color/yuz_action"
                app:tabSelectedTextColor="@color/yuz_text"
                app:tabTextColor="@color/yuz_text_secondary" />

            <!-- #75: qidiruv qatori — doim ko'rinadi, filtri o'ngdagi tugmada. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="@dimen/yuz_gutter"
                android:paddingTop="@dimen/yuz_space_1"
                android:paddingEnd="@dimen/yuz_gutter"
                android:paddingBottom="@dimen/yuz_space_3">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_classified_search_bar"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/yuz_space_3"
                    android:paddingEnd="@dimen/yuz_space_3">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_search"
                        android:tint="@color/yuz_text_secondary" />

                    <EditText
                        android:id="@+id/etJobSearch"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_marginStart="@dimen/yuz_space_2"
                        android:background="@null"
                        android:hint="Kasb, ish, shahar..."
                        android:imeOptions="actionSearch"
                        android:inputType="text"
                        android:maxLines="1"
                        android:textColor="@color/yuz_text"
                        android:textColorHint="@color/yuz_text_muted"
                        android:textSize="@dimen/yuz_text_body" />
                </LinearLayout>

                <ImageButton
                    android:id="@+id/btnJobFilterToggle"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="@dimen/yuz_space_2"
                    android:background="@drawable/bg_classified_search_bar"
                    android:contentDescription="Filtrlar"
                    android:padding="@dimen/yuz_space_3"
                    android:src="@drawable/ic_filter"
                    android:tint="@color/yuz_action" />
            </LinearLayout>

            <!-- #75: filtr paneli (maosh, hudud, sana, saralash). -->
            <LinearLayout
                android:id="@+id/jobFilterPanel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="@dimen/yuz_gutter"
                android:paddingEnd="@dimen/yuz_gutter"
                android:paddingBottom="@dimen/yuz_space_4"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/yuz_space_3"
                    android:text="@string/job_board_filters"
                    android:textColor="@color/yuz_text"
                    android:textSize="@dimen/yuz_text_section"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="@dimen/yuz_space_2"
                        android:layout_weight="1"
                        android:hint="Min maosh"
                        app:boxBackgroundColor="@color/yuz_field"
                        app:boxCornerRadiusTopStart="12dp"
                        app:boxCornerRadiusTopEnd="12dp"
                        app:boxCornerRadiusBottomStart="12dp"
                        app:boxCornerRadiusBottomEnd="12dp"
                        app:hintTextColor="@color/yuz_text_secondary"
                        style="@style/Widget.MaterialComponents.TextInputLayout.FilledBox.Dense">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etJobMinSalary"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="number"
                            android:textColor="@color/yuz_text" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:hint="Max maosh"
                        app:boxBackgroundColor="@color/yuz_field"
                        app:boxCornerRadiusTopStart="12dp"
                        app:boxCornerRadiusTopEnd="12dp"
                        app:boxCornerRadiusBottomStart="12dp"
                        app:boxCornerRadiusBottomEnd="12dp"
                        app:hintTextColor="@color/yuz_text_secondary"
                        style="@style/Widget.MaterialComponents.TextInputLayout.FilledBox.Dense">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etJobMaxSalary"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="number"
                            android:textColor="@color/yuz_text" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/yuz_space_2"
                    android:orientation="horizontal">

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="@dimen/yuz_space_2"
                        android:layout_weight="1"
                        android:hint="Joylashuv (Shahar/Tuman)"
                        app:boxBackgroundColor="@color/yuz_field"
                        app:boxCornerRadiusTopStart="12dp"
                        app:boxCornerRadiusTopEnd="12dp"
                        app:boxCornerRadiusBottomStart="12dp"
                        app:boxCornerRadiusBottomEnd="12dp"
                        app:hintTextColor="@color/yuz_text_secondary"
                        style="@style/Widget.MaterialComponents.TextInputLayout.FilledBox.Dense">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etJobLocation"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="text"
                            android:textColor="@color/yuz_text" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnJobRegionPicker"
                        style="@style/YuzButtonSecondary"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/yuz_button"
                        android:text="@string/job_board_region_only"
                        android:textSize="@dimen/yuz_text_secondary"
                        app:icon="@drawable/ic_location_pin"
                        app:iconGravity="start" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/yuz_space_4"
                    android:layout_marginBottom="@dimen/yuz_space_2"
                    android:text="@string/classified_filter_date_title"
                    android:textColor="@color/yuz_text_secondary"
                    android:textSize="@dimen/yuz_text_secondary"
                    android:textStyle="bold" />

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:overScrollMode="never"
                    android:scrollbars="none">

                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/chipGroupJobDate"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:chipSpacingHorizontal="8dp"
                        app:singleLine="true"
                        app:singleSelection="true" />
                </HorizontalScrollView>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/yuz_space_3"
                    android:layout_marginBottom="@dimen/yuz_space_2"
                    android:text="@string/classified_filter_sort_title"
                    android:textColor="@color/yuz_text_secondary"
                    android:textSize="@dimen/yuz_text_secondary"
                    android:textStyle="bold" />

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:overScrollMode="never"
                    android:scrollbars="none">

                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/chipGroupJobSort"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:chipSpacingHorizontal="8dp"
                        app:singleLine="true"
                        app:singleSelection="true" />
                </HorizontalScrollView>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/yuz_space_3"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnJobFilterReset"
                        style="@style/YuzButtonGhost"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/yuz_button"
                        android:layout_marginEnd="@dimen/yuz_space_2"
                        android:layout_weight="1"
                        android:text="@string/classified_filter_reset" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnJobFilterApply"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/yuz_button"
                        android:layout_weight="1"
                        style="@style/YuzButton"
                        android:text="@string/job_board_filter_search" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.appbar.AppBarLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <!-- Fonda ketayotgan ish e'loni yuklashi: progress shu yerda ko'rinadi. -->
        <LinearLayout
            android:id="@+id/jobUploadBanner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/yuz_gutter"
            android:layout_marginTop="@dimen/yuz_space_2"
            android:layout_marginEnd="@dimen/yuz_gutter"
            android:background="@drawable/bg_yuz_upload_info"
            android:orientation="vertical"
            android:paddingStart="@dimen/yuz_space_3"
            android:paddingTop="10dp"
            android:paddingEnd="@dimen/yuz_space_2"
            android:paddingBottom="10dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/jobUploadBannerIcon"
                    android:layout_width="@dimen/yuz_icon_sm"
                    android:layout_height="@dimen/yuz_icon_sm"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_yuz_briefcase"
                    android:tint="@color/yuz_action" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/yuz_space_2"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/jobUploadBannerTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textColor="@color/yuz_text_bright"
                        android:textSize="@dimen/yuz_text_secondary"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/jobUploadBannerSubtitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textColor="@color/yuz_text_secondary"
                        android:textSize="@dimen/yuz_text_caption" />
                </LinearLayout>

                <ImageButton
                    android:id="@+id/jobUploadBannerAction"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/classified_pending_cancel"
                    android:padding="8dp"
                    android:src="@drawable/ic_yuz_close"
                    android:tint="@color/yuz_text_secondary" />
            </LinearLayout>

            <ProgressBar
                android:id="@+id/jobUploadBannerProgress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="3dp"
                android:layout_marginTop="@dimen/yuz_space_2"
                android:max="100"
                android:progressTint="@color/yuz_action" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvJobCards"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false" />

            <LinearLayout
                android:id="@+id/emptyState"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:orientation="vertical"
                android:visibility="gone">

                <ImageView
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:alpha="0.8"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_yuz_briefcase"
                    android:tint="@color/yuz_text_muted" />

                <TextView
                    android:id="@+id/tvEmpty"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/yuz_space_3"
                    android:text="@string/job_board_empty"
                    android:textColor="@color/yuz_text"
                    android:textSize="@dimen/yuz_text_section"
                    android:textStyle="bold" />
            </LinearLayout>

            <ProgressBar
                android:id="@+id/progressBar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:indeterminateTint="@color/yuz_action"
                android:visibility="gone" />
        </FrameLayout>
    </LinearLayout>

    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/fabPostJob"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="@dimen/yuz_gutter"
        android:layout_marginBottom="92dp"
        android:text="@string/job_board_post"
        android:textColor="@color/yuz_on_action"
        app:backgroundTint="@color/yuz_action"
        app:elevation="8dp"
        app:icon="@drawable/ic_add"
        app:iconTint="@color/yuz_on_action" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
