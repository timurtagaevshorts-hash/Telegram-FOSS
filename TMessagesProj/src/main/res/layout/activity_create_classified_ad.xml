<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_chat_room_gradient">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="@dimen/yuz_space_8">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:navigationIcon="@drawable/ic_back"
            app:title="@string/classified_post_ad"
            app:titleTextColor="@color/yuz_text" />

        <!-- Premium hero -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/yuz_space_4"
            android:layout_marginEnd="@dimen/yuz_space_4"
            android:background="@drawable/bg_classified_post_hero"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="@dimen/yuz_space_4">

            <ImageView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_yuz_crown"
                android:tint="#FFC24B" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/yuz_space_3"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/classified_post_ad"
                    android:textColor="@color/yuz_text"
                    android:textSize="@dimen/yuz_text_section"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/classified_post_subtitle"
                    android:textColor="@color/yuz_text_secondary"
                    android:textSize="@dimen/yuz_text_secondary" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/yuz_space_4">

            <!-- Graphic image picker -->
            <FrameLayout
                android:id="@+id/btnPickImages"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_classified_image_picker"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:padding="@dimen/yuz_gutter">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical">

                    <FrameLayout
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:background="@drawable/bg_classified_premium_fab">

                        <ImageView
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:layout_gravity="center"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_add_photo"
                            app:tint="@color/yuz_text" />
                    </FrameLayout>

                    <TextView
                        android:id="@+id/tvPickImagesLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/yuz_space_3"
                        android:text="@string/classified_add_photos"
                        android:textColor="@color/yuz_text"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/classified_add_photos_subtitle"
                        android:textColor="@color/yuz_text_secondary"
                        android:textSize="@dimen/yuz_text_secondary" />
                </LinearLayout>
            </FrameLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvSelectedImages"
                android:layout_width="match_parent"
                android:layout_height="88dp"
                android:layout_marginTop="@dimen/yuz_space_3"
                android:visibility="gone" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/yuz_gutter"
                android:text="@string/classified_category"
                android:textColor="@color/yuz_text"
                android:textSize="@dimen/yuz_text_secondary"
                android:textStyle="bold" />

            <Spinner
                android:id="@+id/spinnerCategory"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="@dimen/yuz_space_2"
                android:background="@drawable/bg_classified_search_bar"
                android:paddingStart="@dimen/yuz_space_3"
                android:paddingEnd="@dimen/yuz_space_3" />

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/yuz_space_4"
                android:hint="@string/classified_model_hint"
                app:boxBackgroundColor="@color/classified_field_bg"
                app:boxStrokeColor="@color/yuz_action"
                app:hintTextColor="@color/yuz_text_muted">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etModel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textCapSentences"
                    android:textColor="@color/yuz_text" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/yuz_space_3"
                android:hint="@string/classified_title_hint"
                app:boxBackgroundColor="@color/classified_field_bg"
                app:boxStrokeColor="@color/yuz_action"
                app:hintTextColor="@color/yuz_text_muted">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textCapSentences"
                    android:textColor="@color/yuz_text" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilPrice"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/yuz_space_3"
                android:hint="@string/classified_price_hint"
                app:boxBackgroundColor="@color/classified_field_bg"
                app:boxStrokeColor="@color/yuz_action"
                app:hintTextColor="@color/yuz_text_muted"
                app:suffixText="@string/classified_price_suffix"
                app:suffixTextColor="@color/yuz_action">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etPrice"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="number"
                    android:textColor="@color/yuz_text" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/yuz_space_3"
                android:hint="@string/classified_address_hint"
                app:boxBackgroundColor="@color/classified_field_bg"
                app:boxStrokeColor="@color/yuz_action"
                app:hintTextColor="@color/yuz_text_muted"
                app:startIconDrawable="@drawable/ic_location_pin"
                app:startIconTint="@color/yuz_action">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etAddress"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:imeOptions="actionNext"
                    android:inputType="textCapSentences"
                    android:maxLines="1"
                    android:textColor="@color/yuz_text" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- #75: hudud tanlagichi — filtr qidiruvi region maydoniga tayanadi. -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPickRegion"
                style="@style/YuzButtonSecondary"
                android:layout_width="match_parent"
                android:layout_height="@dimen/yuz_button"
                android:layout_marginTop="@dimen/yuz_space_2"
                android:text="@string/classified_region_optional"
                android:textSize="@dimen/yuz_text_secondary"
                app:icon="@drawable/ic_location_pin"
                app:iconGravity="start" />

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/yuz_space_3"
                android:hint="@string/classified_phone_hint"
                app:boxBackgroundColor="@color/classified_field_bg"
                app:boxStrokeColor="@color/yuz_action"
                app:hintTextColor="@color/yuz_text_muted"
                app:startIconContentDescription="@string/classified_phone_hint"
                app:startIconDrawable="@drawable/ic_yuz_phone"
                app:startIconTint="@color/yuz_action">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etPhone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="phone"
                    android:textColor="@color/yuz_text" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/yuz_space_3"
                android:hint="@string/classified_full_info_hint"
                app:boxBackgroundColor="@color/classified_field_bg"
                app:boxStrokeColor="@color/yuz_action"
                app:hintTextColor="@color/yuz_text_muted">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etDescription"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="top"
                    android:inputType="textMultiLine|textCapSentences"
                    android:minLines="4"
                    android:textColor="@color/yuz_text" />
            </com.google.android.material.textfield.TextInputLayout>

            <!--
              Eski KinoTOP4 "kartochka uslubi" tanlagichi bu yerdan olib tashlandi:
              portda faqat bitta (black) uslub qolgan — ClassifiedAdCardThemes.normalize()
              har doim BLACK qaytardi, shuning uchun 4 ta svatch uchun hech qanday
              click listener yo'q edi (o'lik UI foydalanuvchini chalkashtirardi).
            -->

            <TextView
                android:id="@+id/tvUploadStatus"
                style="@style/YuzBodySecondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/yuz_space_3"
                android:visibility="gone" />

            <ProgressBar
                android:id="@+id/uploadProgress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/yuz_space_3"
                android:max="100"
                android:progressTint="@color/yuz_action"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPublish"
                style="@style/YuzButton"
                android:layout_marginTop="@dimen/yuz_space_5"
                android:text="@string/classified_publish" />
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
