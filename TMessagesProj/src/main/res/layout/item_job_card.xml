<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/jobCardRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/yuz_space_2"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    app:cardBackgroundColor="@color/yuz_surface"
    app:cardCornerRadius="@dimen/yuz_radius_card"
    app:cardElevation="0dp"
    app:strokeColor="@color/yuz_stroke_soft"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <FrameLayout
            android:id="@+id/jobThumbFrame"
            android:layout_width="match_parent"
            android:layout_height="140dp"
            android:background="@drawable/bg_yuz_thumb_top"
            android:clipToOutline="true">

            <ImageView
                android:id="@+id/ivJobThumb"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@null"
                android:scaleType="centerCrop" />

            <View
                android:layout_width="match_parent"
                android:layout_height="80dp"
                android:layout_gravity="bottom"
                android:background="@drawable/bg_classified_ad_scrim" />

            <TextView
                android:id="@+id/tvJobType"
                style="@style/YuzBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|start"
                android:layout_margin="@dimen/yuz_space_3"
                android:background="@drawable/bg_classified_category_badge"
                android:elevation="2dp"
                android:paddingStart="@dimen/yuz_space_2"
                android:paddingTop="@dimen/yuz_space_1"
                android:paddingEnd="@dimen/yuz_space_2"
                android:paddingBottom="@dimen/yuz_space_1"
                android:textColor="@color/yuz_text" />

            <TextView
                android:id="@+id/tvJobOwn"
                style="@style/YuzBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|end"
                android:layout_margin="@dimen/yuz_space_3"
                android:background="@drawable/bg_yuz_tag_own"
                android:elevation="2dp"
                android:paddingStart="@dimen/yuz_space_2"
                android:paddingTop="@dimen/yuz_space_1"
                android:paddingEnd="@dimen/yuz_space_2"
                android:paddingBottom="@dimen/yuz_space_1"
                android:textColor="@color/yuz_gold"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvJobSalary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|start"
                android:layout_marginStart="@dimen/yuz_space_3"
                android:layout_marginBottom="@dimen/yuz_space_3"
                android:background="@drawable/bg_classified_price_badge"
                android:elevation="2dp"
                android:paddingStart="@dimen/yuz_space_3"
                android:paddingTop="5dp"
                android:paddingEnd="@dimen/yuz_space_3"
                android:paddingBottom="5dp"
                android:textColor="@color/yuz_gold"
                android:textSize="@dimen/yuz_text_secondary"
                android:textStyle="bold" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/yuz_space_3"
            android:paddingTop="@dimen/yuz_space_3"
            android:paddingEnd="@dimen/yuz_space_3"
            android:paddingBottom="@dimen/yuz_space_3">

            <TextView
                android:id="@+id/tvJobTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:maxLines="2"
                android:textColor="@color/yuz_text"
                android:textSize="@dimen/yuz_text_section"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvJobSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/yuz_space_1"
                android:ellipsize="end"
                android:maxLines="2"
                android:textColor="@color/yuz_text_secondary"
                android:textSize="@dimen/yuz_text_secondary" />

            <LinearLayout
                android:id="@+id/jobLocationRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/yuz_space_2"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/ivJobLocationIcon"
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_location_pin"
                    app:tint="@color/yuz_text_muted" />

                <TextView
                    android:id="@+id/tvJobLocation"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/yuz_text_muted"
                    android:textSize="@dimen/yuz_text_caption" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/jobActionsRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/yuz_space_2"
                android:gravity="end"
                android:orientation="horizontal"
                android:visibility="gone">

                <ImageButton
                    android:id="@+id/btnJobEdit"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="@drawable/bg_yuz_chip"
                    android:contentDescription="@string/classified_edit"
                    android:padding="7dp"
                    android:src="@drawable/ic_edit"
                    android:tint="@color/yuz_text_secondary" />

                <ImageButton
                    android:id="@+id/btnJobDelete"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_marginStart="@dimen/yuz_space_2"
                    android:background="@drawable/bg_yuz_chip"
                    android:contentDescription="@string/classified_delete"
                    android:padding="7dp"
                    android:src="@drawable/ic_delete"
                    android:tint="@color/yuz_danger" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
