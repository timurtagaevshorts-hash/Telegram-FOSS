<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/yuz_bg">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/mafTopBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/yuz_space_1"
        android:paddingTop="@dimen/yuz_space_2"
        android:paddingEnd="@dimen/yuz_gutter"
        android:paddingBottom="@dimen/yuz_space_2">

        <ImageButton
            android:id="@+id/btnMafBack"
            style="@style/YuzIconButton"
            android:contentDescription="@string/games_back"
            android:src="@drawable/ic_back" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/yuz_space_1"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                style="@style/YuzScreenTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/maf_title" />

            <TextView
                android:id="@+id/tvMafSubtitle"
                style="@style/YuzScreenSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="1" />
        </LinearLayout>
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/yuz_gutter"
            android:paddingTop="@dimen/yuz_space_2"
            android:paddingEnd="@dimen/yuz_gutter"
            android:paddingBottom="@dimen/yuz_space_8">

            <!-- Faza paneli -->
            <LinearLayout
                android:id="@+id/mafPhaseCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_yuz_games_tile_mafia"
                android:orientation="vertical"
                android:padding="@dimen/yuz_space_4">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvMafPhase"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textColor="@color/yuz_text_bright"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvMafTimer"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_yuz_games_chip"
                        android:paddingLeft="@dimen/yuz_space_3"
                        android:paddingTop="5dp"
                        android:paddingRight="@dimen/yuz_space_3"
                        android:paddingBottom="5dp"
                        android:textColor="@color/yuz_games_mafia"
                        android:textSize="@dimen/yuz_text_secondary"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvMafPhaseHint"
                    style="@style/YuzBodySecondary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/yuz_space_2" />
            </LinearLayout>

            <!-- Rol kartasi -->
            <LinearLayout
                android:id="@+id/mafRoleCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/yuz_space_3"
                android:background="@drawable/bg_yuz_games_panel"
                android:orientation="vertical"
                android:padding="@dimen/yuz_space_4"
                android:visibility="gone">

                <TextView
                    style="@style/YuzLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/maf_role" />

                <TextView
                    android:id="@+id/tvMafRoleName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="@color/yuz_text_bright"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvMafRoleDesc"
                    style="@style/YuzBodySecondary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/yuz_space_2" />

                <TextView
                    android:id="@+id/tvMafCheck"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/yuz_space_2"
                    android:textColor="@color/yuz_action"
                    android:textSize="@dimen/yuz_text_secondary"
                    android:textStyle="bold"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tvMafTeam"
                    style="@style/YuzCaption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/yuz_space_2"
                    android:textColor="@color/yuz_games_mafia"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- G'olib banneri -->
            <TextView
                android:id="@+id/tvMafWinner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/yuz_space_3"
                android:background="@drawable/bg_yuz_games_chip_active"
                android:gravity="center"
                android:padding="@dimen/yuz_space_4"
                android:textColor="@color/yuz_action"
                android:textSize="@dimen/yuz_text_section"
                android:textStyle="bold"
                android:visibility="gone" />

            <!-- Tungi/ovoz natijasi banneri -->
            <TextView
                android:id="@+id/tvMafNotice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/yuz_space_3"
                android:background="@drawable/bg_yuz_games_panel"
                android:gravity="center"
                android:padding="@dimen/yuz_space_3"
                android:textColor="@color/yuz_text"
                android:textSize="14sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <!-- O'yinchilar -->
            <TextView
                style="@style/YuzSectionHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/yuz_space_5"
                android:text="@string/maf_players_title" />

            <TextView
                android:id="@+id/tvMafSeatsMeta"
                style="@style/YuzCaption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp" />

            <LinearLayout
                android:id="@+id/mafSeatGrid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/yuz_space_3"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/tvMafHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/yuz_space_3"
                android:gravity="center"
                android:textColor="@color/yuz_action"
                android:textSize="14sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <!-- Tugmalar -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnMafPrimary"
                style="@style/YuzButton"
                android:layout_width="match_parent"
                android:layout_marginTop="@dimen/yuz_space_4"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnMafSecondary"
                style="@style/YuzButtonSecondary"
                android:layout_width="match_parent"
                android:layout_marginTop="@dimen/yuz_space_2"
                android:visibility="gone" />

            <!-- Ovoz va qoidalar -->
            <LinearLayout
                android:id="@+id/mafVoiceRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/yuz_space_4"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <uz.kodlikino.top4.ui.GameMicButton
                    android:id="@+id/btnMafMic"
                    android:layout_width="52dp"
                    android:layout_height="52dp" />

                <TextView
                    android:id="@+id/tvMafVoice"
                    style="@style/YuzCaption"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/yuz_space_3"
                    android:layout_weight="1"
                    android:text="@string/games_voice_idle" />

                <TextView
                    android:id="@+id/btnMafRules"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_yuz_games_chip"
                    android:clickable="true"
                    android:contentDescription="@string/games_rules_hint"
                    android:focusable="true"
                    android:paddingLeft="@dimen/yuz_space_3"
                    android:paddingTop="8dp"
                    android:paddingRight="@dimen/yuz_space_3"
                    android:paddingBottom="8dp"
                    android:text="@string/games_rules"
                    android:textColor="@color/yuz_action"
                    android:textSize="@dimen/yuz_text_secondary"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Reaksiyalar va ovoz tugmasi -->
            <LinearLayout
                android:id="@+id/mafReactionBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/yuz_space_3"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <HorizontalScrollView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:clipToPadding="false"
                    android:scrollbars="none">

                    <LinearLayout
                        android:id="@+id/mafReactionRow"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal" />
                </HorizontalScrollView>

                <TextView
                    android:id="@+id/btnMafVoiceToggle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/yuz_space_2"
                    android:background="@drawable/bg_yuz_games_chip"
                    android:clickable="true"
                    android:contentDescription="@string/games_voice_toggle"
                    android:focusable="true"
                    android:paddingLeft="@dimen/yuz_space_3"
                    android:paddingTop="8dp"
                    android:paddingRight="@dimen/yuz_space_3"
                    android:paddingBottom="8dp"
                    android:text="@string/games_voice_on"
                    android:textColor="@color/yuz_action"
                    android:textSize="@dimen/yuz_text_secondary"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Voqealar -->
            <TextView
                style="@style/YuzSectionHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/yuz_space_6"
                android:text="@string/maf_log" />

            <LinearLayout
                android:id="@+id/mafLog"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/yuz_space_2"
                android:orientation="vertical" />

            <TextView
                style="@style/YuzCaption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/yuz_space_5"
                android:text="@string/maf_rules" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>

    <uz.kodlikino.top4.ui.GameReactionView
        android:id="@+id/mafReactionOverlay"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center" />
</FrameLayout>
