<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/yuz_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="100dp">

        <LinearLayout
            android:id="@+id/funkHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/yuz_gutter"
            android:paddingTop="@dimen/yuz_space_4"
            android:paddingEnd="@dimen/yuz_gutter"
            android:paddingBottom="@dimen/yuz_space_2">

            <TextView
                style="@style/YuzScreenTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/funksiyalar_title"
                android:textSize="@dimen/yuz_text_display" />

            <TextView
                style="@style/YuzScreenSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/funksiyalar_subtitle" />
        </LinearLayout>

        <!-- Admin panel boshqaradigan reklama (faol banner bo'lsa ko'rinadi). -->
        <FrameLayout
            android:id="@+id/adFunctionsSlot"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/yuz_gutter"
            android:layout_marginTop="@dimen/yuz_space_2"
            android:layout_marginEnd="@dimen/yuz_gutter"
            android:visibility="gone" />

        <!-- Music player — muqova, ijro holati va ekvalayzer bilan keng karta. -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardMusiqa"
            style="@style/FuncsionMusic"
            android:layout_marginTop="@dimen/yuz_space_4">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_func_music_glow" />

                <LinearLayout style="@style/FuncsionMusicRow">

                    <FrameLayout
                        android:layout_width="88dp"
                        android:layout_height="88dp">

                        <ImageView
                            style="@style/FuncsionMusicCover"
                            android:src="@drawable/func_music_photo" />

                        <ImageView
                            style="@style/FuncsionMusicBadge"
                            android:layout_gravity="bottom|end"
                            android:layout_marginEnd="6dp"
                            android:layout_marginBottom="6dp" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                style="@style/FuncsionMusicTitle"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/func_musiqa_title" />

                            <ImageView
                                android:id="@+id/musicTileEq"
                                style="@style/FuncsionEq" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/musicTileDesc"
                            style="@style/FuncsionTileDesc"
                            android:maxLines="2"
                            android:minLines="1"
                            android:text="@string/func_musiqa_desc" />
                    </LinearLayout>

                    <ImageView
                        style="@style/FuncsionChevron"
                        android:layout_marginStart="@dimen/yuz_space_2" />
                </LinearLayout>
            </FrameLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/marketSection"
            style="@style/FuncsionSection"
            android:text="@string/funksiyalar_section_market" />

        <LinearLayout
            android:id="@+id/rowMarket"
            style="@style/FuncsionRow">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardElonlar"
                style="@style/FuncsionTile">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <FrameLayout style="@style/FuncsionTileMedia">

                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:contentDescription="@null"
                            android:scaleType="centerCrop"
                            android:src="@drawable/func_market_photo" />

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="64dp"
                            android:layout_gravity="bottom"
                            android:background="@drawable/bg_func_image_fade" />

                        <ImageView
                            style="@style/FuncsionImageBadge"
                            android:layout_gravity="bottom|start"
                            android:layout_marginStart="@dimen/yuz_space_3"
                            android:layout_marginBottom="@dimen/yuz_space_3"
                            android:background="@drawable/bg_func_blue"
                            android:src="@drawable/ic_yuz_tag" />
                    </FrameLayout>

                    <LinearLayout style="@style/FuncsionTileText">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                style="@style/FuncsionTileTitle"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="0dp"
                                android:layout_weight="1"
                                android:text="@string/func_elonlar_title" />

                            <ImageView style="@style/FuncsionChevron" />
                        </LinearLayout>

                        <TextView
                            style="@style/FuncsionTileDesc"
                            android:text="@string/func_elonlar_desc" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <Space
                android:layout_width="@dimen/yuz_space_3"
                android:layout_height="1dp" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardIsh"
                style="@style/FuncsionTile">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <FrameLayout style="@style/FuncsionTileMedia">

                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:contentDescription="@null"
                            android:scaleType="centerCrop"
                            android:src="@drawable/func_jobs_photo" />

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="64dp"
                            android:layout_gravity="bottom"
                            android:background="@drawable/bg_func_image_fade" />

                        <ImageView
                            style="@style/FuncsionImageBadge"
                            android:layout_gravity="bottom|start"
                            android:layout_marginStart="@dimen/yuz_space_3"
                            android:layout_marginBottom="@dimen/yuz_space_3"
                            android:background="@drawable/bg_func_indigo"
                            android:src="@drawable/ic_yuz_briefcase" />
                    </FrameLayout>

                    <LinearLayout style="@style/FuncsionTileText">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                style="@style/FuncsionTileTitle"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="0dp"
                                android:layout_weight="1"
                                android:text="@string/func_ish_title" />

                            <ImageView style="@style/FuncsionChevron" />
                        </LinearLayout>

                        <TextView
                            style="@style/FuncsionTileDesc"
                            android:text="@string/func_ish_desc" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <!-- AI — rasmli hero: ovoz yordamchisi butun ekranning qahramoni. -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardAi"
            style="@style/FuncsionHero"
            android:layout_marginTop="@dimen/yuz_space_6">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="248dp">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@null"
                    android:scaleType="centerCrop"
                    android:src="@drawable/func_ai_hero" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_func_hero_scrim" />

                <ImageView
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_gravity="top|start"
                    android:layout_marginStart="@dimen/yuz_space_4"
                    android:layout_marginTop="@dimen/yuz_space_4"
                    android:background="@drawable/bg_func_violet"
                    android:contentDescription="@null"
                    android:padding="11dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_yuz_mic"
                    android:tint="#FFFFFF" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom"
                    android:orientation="vertical"
                    android:padding="@dimen/yuz_space_5">

                    <TextView
                        style="@style/FuncsionHeroTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/func_ai_title" />

                    <TextView
                        style="@style/FuncsionHeroDesc"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="40dp"
                        android:maxLines="2"
                        android:text="@string/func_ai_desc" />

                    <TextView
                        style="@style/FuncsionHeroCta"
                        android:text="@string/func_ai_cta" />
                </LinearLayout>
            </FrameLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/contentSection"
            style="@style/FuncsionSection"
            android:text="@string/funksiyalar_section_content" />

        <LinearLayout
            android:id="@+id/rowContent"
            style="@style/FuncsionRow">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardKinolar"
                style="@style/FuncsionTile">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <FrameLayout style="@style/FuncsionTileMedia">

                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:contentDescription="@null"
                            android:scaleType="centerCrop"
                            android:src="@drawable/func_cinema_photo" />

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="64dp"
                            android:layout_gravity="bottom"
                            android:background="@drawable/bg_func_image_fade" />

                        <ImageView
                            style="@style/FuncsionImageBadge"
                            android:layout_gravity="bottom|start"
                            android:layout_marginStart="@dimen/yuz_space_3"
                            android:layout_marginBottom="@dimen/yuz_space_3"
                            android:background="@drawable/bg_func_amber"
                            android:src="@drawable/ic_yuz_film" />
                    </FrameLayout>

                    <LinearLayout style="@style/FuncsionTileText">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                style="@style/FuncsionTileTitle"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="0dp"
                                android:layout_weight="1"
                                android:text="@string/func_kinolar_title" />

                            <ImageView style="@style/FuncsionChevron" />
                        </LinearLayout>

                        <TextView
                            style="@style/FuncsionTileDesc"
                            android:text="@string/func_kinolar_desc" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <Space
                android:layout_width="@dimen/yuz_space_3"
                android:layout_height="1dp" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardInstagram"
                style="@style/FuncsionTile">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <FrameLayout style="@style/FuncsionTileMedia">

                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:contentDescription="@null"
                            android:scaleType="centerCrop"
                            android:src="@drawable/func_instagram_photo" />

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="64dp"
                            android:layout_gravity="bottom"
                            android:background="@drawable/bg_func_image_fade" />

                        <ImageView
                            style="@style/FuncsionImageBadge"
                            android:layout_gravity="bottom|start"
                            android:layout_marginStart="@dimen/yuz_space_3"
                            android:layout_marginBottom="@dimen/yuz_space_3"
                            android:background="@drawable/bg_func_pink"
                            android:src="@drawable/ic_yuz_instagram" />
                    </FrameLayout>

                    <LinearLayout style="@style/FuncsionTileText">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                style="@style/FuncsionTileTitle"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="0dp"
                                android:layout_weight="1"
                                android:text="@string/func_instagram_title" />

                            <ImageView style="@style/FuncsionChevron" />
                        </LinearLayout>

                        <TextView
                            style="@style/FuncsionTileDesc"
                            android:text="@string/func_instagram_desc" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
