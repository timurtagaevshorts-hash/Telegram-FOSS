<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/modern_surface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="100dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="@dimen/yuz_gutter"
            android:paddingTop="@dimen/yuz_space_4"
            android:paddingEnd="@dimen/yuz_gutter"
            android:text="@string/funksiyalar_title"
            android:textColor="@color/yuz_text"
            android:textSize="@dimen/yuz_text_display"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="@dimen/yuz_gutter"
            android:paddingTop="2dp"
            android:paddingEnd="@dimen/yuz_gutter"
            android:paddingBottom="@dimen/yuz_space_4"
            android:text="@string/funksiyalar_subtitle"
            android:textColor="@color/yuz_text_secondary"
            android:textSize="@dimen/yuz_text_secondary" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardAi"
            style="@style/FuncsionCard">

            <LinearLayout style="@style/FuncsionCardRow">

                <ImageView
                    style="@style/FuncsionCardIconImg"
                    android:background="@drawable/bg_func_violet"
                    android:src="@drawable/ic_yuz_mic" />

                <LinearLayout style="@style/FuncsionCardText">
                    <TextView style="@style/FuncsionCardTitle" android:text="@string/func_ai_title" />
                    <TextView style="@style/FuncsionCardDesc" android:text="@string/func_ai_desc" />
                </LinearLayout>

                <ImageView style="@style/FuncsionCardChevron" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardElonlar"
            style="@style/FuncsionCard">

            <LinearLayout style="@style/FuncsionCardRow">

                <ImageView
                    style="@style/FuncsionCardIconImg"
                    android:background="@drawable/bg_func_blue"
                    android:src="@drawable/ic_yuz_tag" />

                <LinearLayout style="@style/FuncsionCardText">
                    <TextView style="@style/FuncsionCardTitle" android:text="@string/func_elonlar_title" />
                    <TextView style="@style/FuncsionCardDesc" android:text="@string/func_elonlar_desc" />
                </LinearLayout>

                <ImageView style="@style/FuncsionCardChevron" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardIsh"
            style="@style/FuncsionCard">

            <LinearLayout style="@style/FuncsionCardRow">

                <ImageView
                    style="@style/FuncsionCardIconImg"
                    android:background="@drawable/bg_func_indigo"
                    android:src="@drawable/ic_yuz_briefcase" />

                <LinearLayout style="@style/FuncsionCardText">
                    <TextView style="@style/FuncsionCardTitle" android:text="@string/func_ish_title" />
                    <TextView style="@style/FuncsionCardDesc" android:text="@string/func_ish_desc" />
                </LinearLayout>

                <ImageView style="@style/FuncsionCardChevron" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardMusiqa"
            style="@style/FuncsionCard">

            <LinearLayout style="@style/FuncsionCardRow">

                <ImageView
                    style="@style/FuncsionCardIconImg"
                    android:background="@drawable/bg_func_teal"
                    android:src="@drawable/ic_yuz_music" />

                <LinearLayout style="@style/FuncsionCardText">
                    <TextView style="@style/FuncsionCardTitle" android:text="@string/func_musiqa_title" />
                    <TextView style="@style/FuncsionCardDesc" android:text="@string/func_musiqa_desc" />
                </LinearLayout>

                <ImageView style="@style/FuncsionCardChevron" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardInstagram"
            style="@style/FuncsionCard">

            <LinearLayout style="@style/FuncsionCardRow">

                <ImageView
                    style="@style/FuncsionCardIconImg"
                    android:background="@drawable/bg_func_pink"
                    android:src="@drawable/ic_yuz_download" />

                <LinearLayout style="@style/FuncsionCardText">
                    <TextView style="@style/FuncsionCardTitle" android:text="@string/func_instagram_title" />
                    <TextView style="@style/FuncsionCardDesc" android:text="@string/func_instagram_desc" />
                </LinearLayout>

                <ImageView style="@style/FuncsionCardChevron" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardKinolar"
            style="@style/FuncsionCard">

            <LinearLayout style="@style/FuncsionCardRow">

                <ImageView
                    style="@style/FuncsionCardIconImg"
                    android:background="@drawable/bg_func_amber"
                    android:src="@drawable/ic_yuz_film" />

                <LinearLayout style="@style/FuncsionCardText">
                    <TextView style="@style/FuncsionCardTitle" android:text="@string/func_kinolar_title" />
                    <TextView style="@style/FuncsionCardDesc" android:text="@string/func_kinolar_desc" />
                </LinearLayout>

                <ImageView style="@style/FuncsionCardChevron" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
