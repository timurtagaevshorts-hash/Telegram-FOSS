<?xml version="1.0" encoding="utf-8"?>
<!--
  Reels feed'ining bitta sahifasi — to'liq ekranli video + ustidagi ma'lumot qatlamlari.
  PlayerView controller'i (boshqaruv paneli) yoqilmaydi — boshqaruv ReelsAdapter'da
  qo'lda amalga oshiriladi (bosish = play/pause). Shunda media3'ning murakkab
  controller layoutlari ishga tushmaydi va Material 1.6.1 / minSdk 21 muhitida
  xatosiz ishlaydi.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <!--
      use_controller=false — PlayerView controller (PlayerControlView) umuman
      yaratilmaydi. Bu muhim: media3-ui AAR'ida RecyclerView faqat
      PlayerControlView ichida ishlatiladi, Telegram esa AAR'ni butunlay
      chiqarib tashlab o'z manba kodidagi RecyclerView'idan foydalanadi
      (qarang TMessagesProj/build.gradle configurations.all exclude).
      surface_type=texture_view — video oynani ichida chizadi, shuning uchun
      ustidagi poster/gradient qatlamlari telefon xotirasida (SurfaceView'da
      uchadigan "teshik") xatosiz ustma-ust tushadi.
      resize_mode=zoom — 9:16 video to'liq ekranni kesib to'ldiradi (Reels standart).
    -->
    <androidx.media3.ui.PlayerView
        android:id="@+id/playerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:resize_mode="zoom"
        app:surface_type="texture_view"
        app:use_controller="false" />

    <!--
      Poster (thumbnailUrl). PlayerView sirt (SurfaceView) ko'rinishida ishlagani uchun
      rasm video USTIDA turadi — birinchi kadr chiqishi bilan GONE qilinadi
      (qarang ReelsAdapter.onPlaybackStateChanged), aks holda video ko'rinmas edi.
    -->
    <ImageView
        android:id="@+id/ivThumbnail"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/home_bg"
        android:contentDescription="@null"
        android:scaleType="centerCrop" />

    <!--
      #106: Telegram hikoyasi posti — BackupImageView ichidagi ImageReceiver
      hikoyaning o'z manbasidan yuklaydi (striped thumb, to'liq rasm,
      shifrlash), Glide kerak emas. Faqat story sahifalarida ko'rinadi; video
      tayyor bo'lib ijro boshlangach yashiriladi (qarang ReelsAdapter).
      BackupImageView'ning (Context, AttributeSet) konstruktori yo'q — view
      code'da yaratilib shu konteynerga qo'yiladi.
    -->
    <FrameLayout
        android:id="@+id/storyThumbHost"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Pastdagi qora gradient — matn o'qilishi uchun -->
    <View
        android:layout_width="match_parent"
        android:layout_height="220dp"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_classified_ad_scrim" />

    <!--
      Markaziy ovoz holati belgisi: ovoz o'chiq/yoniqligini ko'rsatadi.
      Bosilganda ovoz yonadi va reel to'liq ekranga o'tadi (kichik holatdagi
      videoni bosish bilan bir xil). Fullscreen'da yashiriladi — u yerda
      yuqoridagi ovoz tugmasi ishlaydi. Spinner ustida ko'rinishi uchun
      ProgressBar'dan OLDIN chiziladi.
    -->
    <ImageView
        android:id="@+id/btnSoundCenter"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_gravity="center"
        android:alpha="0.9"
        android:background="@drawable/bg_yuz_reel_badge"
        android:contentDescription="@string/reels_sound_off"
        android:foreground="?attr/selectableItemBackgroundBorderless"
        android:padding="16dp"
        android:src="@drawable/ic_yuz_volume_off"
        android:tint="@color/yuz_on_media" />

    <ProgressBar
        android:id="@+id/pageProgress"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_gravity="center"
        android:indeterminateTint="@color/yuz_action"
        android:visibility="gone" />

    <!-- Bosilganda qisqa ko'rinadigan play/pause belgisi -->
    <ImageView
        android:id="@+id/tvPlayPauseBadge"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:layout_gravity="center"
        android:alpha="0.92"
        android:background="@drawable/bg_yuz_reel_badge"
        android:contentDescription="@null"
        android:padding="22dp"
        android:src="@drawable/ic_yuz_play"
        android:tint="@color/yuz_on_media"
        android:visibility="gone" />

    <!-- Ikki marta bosilganda paydo bo'ladigan yurak (KinoTOP4'dagi kabi) -->
    <ImageView
        android:id="@+id/tvLikeBurst"
        android:layout_width="84dp"
        android:layout_height="84dp"
        android:layout_gravity="center"
        android:contentDescription="@null"
        android:src="@drawable/ic_yuz_heart_filled"
        android:tint="@color/yuz_like"
        android:visibility="gone" />

    <!-- #99: video ochilmaganda — spinner o'rniga sabab + "Qayta urinish". -->
    <LinearLayout
        android:id="@+id/reelErrorRow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/bg_yuz_reel_badge"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/yuz_space_4"
        android:paddingTop="@dimen/yuz_space_2"
        android:paddingEnd="@dimen/yuz_space_4"
        android:paddingBottom="@dimen/yuz_space_2"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvReelError"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/yuz_text"
            android:textSize="@dimen/yuz_text_secondary" />

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_marginStart="@dimen/yuz_space_3"
            android:contentDescription="@string/reels_retry"
            android:src="@drawable/ic_refresh"
            android:tint="@color/yuz_action" />
    </LinearLayout>

    <!--
        O'z reel'i egasi uchun "⋮" menyusi (o'chirish). Faqat uploadedByUid ==
        joriy Telegram uid bo'lganda ko'rinadi — ReelsAdapter.bind() boshqaradi.
    -->
    <ImageView
        android:id="@+id/btnReelMenu"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="54dp"
        android:layout_marginEnd="@dimen/yuz_space_4"
        android:background="@drawable/bg_yuz_reel_action"
        android:contentDescription="@string/reels_menu"
        android:foreground="?attr/selectableItemBackgroundBorderless"
        android:padding="@dimen/yuz_space_2"
        android:src="@drawable/ic_yuz_more"
        android:tint="@color/yuz_text"
        android:visibility="gone" />

    <!--
      Video o'ynash progressi — nozik neon chiziq. PlayerView controller'i
      (use_controller=false) atayin o'chirilgan, shuning uchun progressni o'zimiz
      chizamiz: ReelsAdapter'dagi 250ms'lik ticker `playbackBar` ni yangilaydi.
    -->
    <ProgressBar
        android:id="@+id/playbackBar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:layout_gravity="bottom"
        android:layout_marginStart="@dimen/yuz_space_3"
        android:layout_marginEnd="@dimen/yuz_space_3"
        android:layout_marginBottom="80dp"
        android:max="1000"
        android:progress="0"
        android:progressDrawable="@drawable/bg_reels_progress" />

    <!-- O'ng ustun: like + izoh + ulashish + ko'rishlar -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="@dimen/yuz_space_3"
        android:layout_marginBottom="96dp"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/btnLike"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_yuz_reel_action"
            android:contentDescription="@string/reels_like"
            android:foreground="?attr/selectableItemBackgroundBorderless"
            android:padding="@dimen/yuz_space_3"
            android:src="@drawable/ic_yuz_heart"
            android:tint="@color/yuz_text" />

        <TextView
            android:id="@+id/tvLikeCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:shadowColor="@color/yuz_scrim_strong"
            android:shadowDy="1"
            android:shadowRadius="4"
            android:text="0"
            android:textColor="@color/yuz_text"
            android:textSize="@dimen/yuz_text_secondary" />

        <!-- Izoh: bosilganda pastda izohlar paneli ochiladi (ReelsActivity) -->
        <ImageView
            android:id="@+id/btnComments"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginTop="@dimen/yuz_space_4"
            android:background="@drawable/bg_yuz_reel_action"
            android:contentDescription="@string/reels_comments"
            android:foreground="?attr/selectableItemBackgroundBorderless"
            android:padding="@dimen/yuz_space_3"
            android:src="@drawable/ic_yuz_comment"
            android:tint="@color/yuz_text" />

        <TextView
            android:id="@+id/tvCommentCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:shadowColor="@color/yuz_scrim_strong"
            android:shadowDy="1"
            android:shadowRadius="4"
            android:text="0"
            android:textColor="@color/yuz_text"
            android:textSize="@dimen/yuz_text_secondary" />

        <ImageView
            android:id="@+id/btnShare"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginTop="@dimen/yuz_space_4"
            android:background="@drawable/bg_yuz_reel_action"
            android:contentDescription="@string/reels_share"
            android:foreground="?attr/selectableItemBackgroundBorderless"
            android:padding="@dimen/yuz_space_3"
            android:src="@drawable/ic_yuz_share"
            android:tint="@color/yuz_text" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/yuz_space_4"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="13dp"
                android:layout_height="13dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_yuz_eye"
                android:tint="@color/yuz_on_media_dim" />

            <TextView
                android:id="@+id/tvViews"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/yuz_space_1"
                android:shadowColor="@color/yuz_scrim_strong"
                android:shadowDy="1"
                android:shadowRadius="4"
                android:text="0"
                android:textColor="@color/yuz_text"
                android:textSize="@dimen/yuz_text_secondary" />
        </LinearLayout>
    </LinearLayout>

    <!-- Chap past: muallif + caption -->
    <LinearLayout
        android:id="@+id/reelInfoContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginStart="@dimen/yuz_space_4"
        android:layout_marginEnd="84dp"
        android:layout_marginBottom="88dp"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/uploaderRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingTop="@dimen/yuz_space_1"
            android:paddingBottom="@dimen/yuz_space_1">

            <FrameLayout
                android:id="@+id/reelAvatarHost"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:background="@drawable/bg_classified_premium_fab">

                <TextView
                    android:id="@+id/tvAvatarInitial"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="R"
                    android:textColor="@color/yuz_text"
                    android:textSize="@dimen/yuz_text_body"
                    android:textStyle="bold" />

                <!-- YuzGram profilidagi rasm (Telegram avatari topilmasa) -->
                <ImageView
                    android:id="@+id/ivAvatarPhoto"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:contentDescription="@null"
                    android:scaleType="centerCrop"
                    android:visibility="gone" />
            </FrameLayout>

            <TextView
                android:id="@+id/tvUploaderName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/yuz_space_3"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:shadowColor="@color/yuz_scrim_strong"
                android:shadowDy="1"
                android:shadowRadius="4"
                android:textColor="@color/yuz_text"
                android:textSize="@dimen/yuz_text_body"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvCaption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/yuz_space_2"
            android:ellipsize="end"
            android:lineSpacingExtra="2dp"
            android:maxLines="4"
            android:shadowColor="@color/yuz_scrim_strong"
            android:shadowDy="1"
            android:shadowRadius="4"
            android:textColor="@color/yuz_on_media"
            android:textSize="@dimen/yuz_text_body" />

        <!--
          KinoTOP4'dagi CTA qatori: `movieUrl` bo'lsa "Kinoni ko'rish",
          `adTitle`+`adUrl` bo'lsa sponsor plani. Ikkalasi ham bo'sh bo'lsa
          qator butunlay ko'rinmaydi (oddiy foydachi reel'lari uchun).
        -->
        <LinearLayout
            android:id="@+id/reelCtaRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/yuz_space_2"
            android:orientation="horizontal"
            android:visibility="gone">

            <TextView
                android:id="@+id/btnWatchMovie"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_classified_category_badge"
                android:contentDescription="@string/reels_watch_movie"
                android:foreground="?attr/selectableItemBackground"
                android:paddingStart="@dimen/yuz_space_3"
                android:paddingTop="@dimen/yuz_space_2"
                android:paddingEnd="@dimen/yuz_space_3"
                android:paddingBottom="@dimen/yuz_space_2"
                android:text="@string/reels_watch_movie"
                android:textColor="@color/yuz_action"
                android:textSize="@dimen/yuz_text_secondary"
                android:textStyle="bold"
                android:visibility="gone" />

            <TextView
                android:id="@+id/btnAd"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/yuz_space_2"
                android:layout_weight="1"
                android:background="@drawable/bg_classified_category_badge_light"
                android:ellipsize="end"
                android:foreground="?attr/selectableItemBackground"
                android:maxLines="1"
                android:paddingStart="@dimen/yuz_space_3"
                android:paddingTop="@dimen/yuz_space_2"
                android:paddingEnd="@dimen/yuz_space_3"
                android:paddingBottom="@dimen/yuz_space_2"
                android:textColor="@color/yuz_text"
                android:textSize="@dimen/yuz_text_secondary"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
