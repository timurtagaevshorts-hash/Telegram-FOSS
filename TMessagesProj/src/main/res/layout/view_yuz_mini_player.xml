<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/miniRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_yuz_mini"
    android:elevation="24dp"
    android:orientation="vertical">

    <View
        android:id="@+id/miniProgress"
        android:layout_width="match_parent"
        android:layout_height="2.5dp"
        android:background="@color/yuz_action" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/yuz_space_2"
        android:paddingEnd="@dimen/yuz_space_1">

        <ImageView
            android:id="@+id/ivMiniCover"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/bg_yuz_cover"
            android:contentDescription="@null"
            android:padding="@dimen/yuz_space_2"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_yuz_music"
            app:tint="@color/yuz_action" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/yuz_space_3"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvMiniTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:singleLine="true"
                android:text=""
                android:textColor="@color/yuz_text"
                android:textSize="@dimen/yuz_text_secondary"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvMiniArtist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:singleLine="true"
                android:text=""
                android:textColor="@color/yuz_text_secondary"
                android:textSize="@dimen/yuz_text_caption" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btnMiniPlay"
            android:layout_width="@dimen/yuz_icon_button"
            android:layout_height="@dimen/yuz_icon_button"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/yuz_a11y_play"
            android:padding="@dimen/yuz_space_3"
            android:src="@drawable/ic_yuz_play"
            app:tint="@color/yuz_text" />

        <ImageButton
            android:id="@+id/btnMiniClose"
            android:layout_width="@dimen/yuz_button_sm"
            android:layout_height="@dimen/yuz_button_sm"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/yuz_a11y_close"
            android:padding="@dimen/yuz_space_2"
            android:src="@drawable/ic_yuz_close"
            app:tint="@color/yuz_text_secondary" />
    </LinearLayout>
</LinearLayout>
