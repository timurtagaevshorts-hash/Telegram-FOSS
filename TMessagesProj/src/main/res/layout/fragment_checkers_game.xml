<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/yuz_bg"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/chkTopBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/yuz_space_1"
        android:paddingTop="@dimen/yuz_space_2"
        android:paddingEnd="@dimen/yuz_gutter"
        android:paddingBottom="@dimen/yuz_space_2">

        <ImageButton
            android:id="@+id/btnChkBack"
            style="@style/YuzIconButton"
            android:contentDescription="@string/games_back"
            android:src="@drawable/ic_back" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/yuz_space_1"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                style="@style/YuzScreenTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/chk_title" />

            <TextView
                android:id="@+id/tvChkSubtitle"
                style="@style/YuzScreenSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="1" />
        </LinearLayout>
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:id="@+id/chkContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="@dimen/yuz_space_3"
            android:paddingTop="@dimen/yuz_space_2"
            android:paddingEnd="@dimen/yuz_space_3"
            android:paddingBottom="@dimen/yuz_space_3">

            <!-- Raqib -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingLeft="@dimen/yuz_space_2"
                android:paddingRight="@dimen/yuz_space_2">

                <TextView
                    android:id="@+id/tvChkOppAvatar"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:background="@drawable/bg_yuz_games_avatar"
                    android:gravity="center"
                    android:textColor="@color/yuz_bg"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/yuz_space_3"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvChkOppName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textColor="@color/yuz_text"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvChkOppMeta"
                        style="@style/YuzCaption"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvChkOppClock"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_yuz_games_chip"
                    android:paddingLeft="@dimen/yuz_space_3"
                    android:paddingTop="5dp"
                    android:paddingRight="@dimen/yuz_space_3"
                    android:paddingBottom="5dp"
                    android:textColor="@color/yuz_text_secondary"
                    android:textSize="@dimen/yuz_text_secondary"
                    android:textStyle="bold" />
            </LinearLayout>

            <FrameLayout
                android:id="@+id/chkBoardHost"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/yuz_space_3">

                <uz.kodlikino.top4.ui.CheckersBoardView
                    android:id="@+id/chkBoard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <uz.kodlikino.top4.ui.GameReactionView
                    android:id="@+id/chkReactionOverlay"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center" />
            </FrameLayout>

            <TextView
                android:id="@+id/tvChkStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/yuz_space_3"
                android:gravity="center"
                android:textColor="@color/yuz_action"
                android:textSize="14sp"
                android:textStyle="bold" />

            <!-- O'zim -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/yuz_space_2"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingLeft="@dimen/yuz_space_2"
                android:paddingRight="@dimen/yuz_space_2">

                <TextView
                    android:id="@+id/tvChkMyAvatar"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:background="@drawable/bg_yuz_games_avatar"
                    android:gravity="center"
                    android:textColor="@color/yuz_bg"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/yuz_space_3"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvChkMyName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textColor="@color/yuz_text"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvChkMyMeta"
                        style="@style/YuzCaption"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvChkMyClock"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_yuz_games_chip_active"
                    android:paddingLeft="@dimen/yuz_space_3"
                    android:paddingTop="5dp"
                    android:paddingRight="@dimen/yuz_space_3"
                    android:paddingBottom="5dp"
                    android:textColor="@color/yuz_action"
                    android:textSize="@dimen/yuz_text_secondary"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/chkActionRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/yuz_space_4"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnChkResign"
                    style="@style/YuzButtonSecondary"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:text="@string/chk_resign" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnChkRematch"
                    style="@style/YuzButton"
                    android:layout_width="0dp"
                    android:layout_marginStart="@dimen/yuz_space_2"
                    android:layout_weight="1"
                    android:text="@string/chk_rematch"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- Reaksiyalar va ovoz tugmasi -->
            <LinearLayout
                android:id="@+id/chkReactionBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/yuz_space_3"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <HorizontalScrollView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:clipToPadding="false"
                    android:scrollbars="none">

                    <LinearLayout
                        android:id="@+id/chkReactionRow"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal" />
                </HorizontalScrollView>

                <TextView
                    android:id="@+id/btnChkVoiceToggle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/yuz_space_2"
                    android:background="@drawable/bg_yuz_games_chip"
                    android:clickable="true"
                    android:contentDescription="@string/games_voice_toggle"
                    android:focusable="true"
                    android:paddingLeft="@dimen/yuz_space_3"
                    android:paddingTop="8dp"
                    android:paddingRight="@dimen/yuz_space_3"
                    android:paddingBottom="8dp"
                    android:text="@string/games_voice_on"
                    android:textColor="@color/yuz_action"
                    android:textSize="@dimen/yuz_text_secondary"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Ovoz va qoidalar -->
            <LinearLayout
                android:id="@+id/chkVoiceRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/yuz_space_3"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <uz.kodlikino.top4.ui.GameMicButton
                    android:id="@+id/btnChkMic"
                    android:layout_width="52dp"
                    android:layout_height="52dp" />

                <TextView
                    android:id="@+id/tvChkVoice"
                    style="@style/YuzCaption"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/yuz_space_3"
                    android:layout_weight="1"
                    android:text="@string/games_voice_idle" />

                <TextView
                    android:id="@+id/btnChkRules"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_yuz_games_chip"
                    android:clickable="true"
                    android:contentDescription="@string/games_rules_hint"
                    android:focusable="true"
                    android:paddingLeft="@dimen/yuz_space_3"
                    android:paddingTop="8dp"
                    android:paddingRight="@dimen/yuz_space_3"
                    android:paddingBottom="8dp"
                    android:text="@string/games_rules"
                    android:textColor="@color/yuz_action"
                    android:textSize="@dimen/yuz_text_secondary"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                style="@style/YuzCaption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/yuz_space_3"
                android:gravity="center"
                android:text="@string/chk_rules" />
        </LinearLayout>

        <!-- Raqib kutilmoqda -->
        <LinearLayout
            android:id="@+id/chkWaitingPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_margin="@dimen/yuz_gutter"
            android:background="@drawable/bg_yuz_games_panel"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="@dimen/yuz_space_6"
            android:visibility="gone">

            <FrameLayout
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="@drawable/bg_yuz_games_badge_checkers">

                <ImageView
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_yuz_checkers"
                    android:tint="@color/yuz_on_action" />
            </FrameLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/yuz_space_4"
                android:gravity="center"
                android:text="@string/chk_waiting_title"
                android:textColor="@color/yuz_text_bright"
                android:textSize="@dimen/yuz_text_section"
                android:textStyle="bold" />

            <TextView
                style="@style/YuzBodySecondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/yuz_space_2"
                android:gravity="center"
                android:text="@string/chk_waiting_desc" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnChkCancel"
                style="@style/YuzButtonSecondary"
                android:layout_width="match_parent"
                android:layout_marginTop="@dimen/yuz_space_5"
                android:text="@string/chk_cancel_invite" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
