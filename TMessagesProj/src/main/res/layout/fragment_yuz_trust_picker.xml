<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/yuz_bg"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/pickerTopBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/yuz_space_1"
        android:paddingTop="@dimen/yuz_space_2"
        android:paddingEnd="@dimen/yuz_gutter"
        android:paddingBottom="@dimen/yuz_space_2">

        <ImageButton
            android:id="@+id/btnPickerBack"
            style="@style/YuzIconButton"
            android:contentDescription="@string/yuz_trust_pick_title"
            android:src="@drawable/ic_back" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/yuz_space_1"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                style="@style/YuzScreenTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/yuz_trust_pick_title" />

            <TextView
                style="@style/YuzScreenSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/yuz_trust_pick_subtitle" />
        </LinearLayout>
    </LinearLayout>

    <EditText
        android:id="@+id/pickerSearch"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginStart="@dimen/yuz_gutter"
        android:layout_marginEnd="@dimen/yuz_gutter"
        android:layout_marginBottom="@dimen/yuz_space_2"
        android:background="@drawable/bg_yuz_search_field"
        android:hint="@string/yuz_trust_search_hint"
        android:imeOptions="actionSearch"
        android:importantForAutofill="no"
        android:inputType="text"
        android:paddingStart="@dimen/yuz_space_3"
        android:paddingEnd="@dimen/yuz_space_3"
        android:singleLine="true"
        android:textColor="@color/yuz_text"
        android:textColorHint="@color/yuz_text_muted"
        android:textSize="15sp" />

    <ProgressBar
        android:id="@+id/pickerProgress"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="@dimen/yuz_space_4"
        android:indeterminateTint="@color/yuz_action"
        android:visibility="gone" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/yuz_gutter"
            android:paddingTop="@dimen/yuz_space_1"
            android:paddingEnd="@dimen/yuz_gutter"
            android:paddingBottom="@dimen/yuz_space_8">

            <LinearLayout
                android:id="@+id/pickerList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/pickerEmpty"
                style="@style/YuzEmptyHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/yuz_space_6"
                android:gravity="center"
                android:text="@string/yuz_trust_pick_empty"
                android:visibility="gone" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>