<?xml version="1.0" encoding="utf-8"?>
<!--
  Reels bildirishnomalari ekrani — donor `activity_profile_notifications.xml`
  varianti, YuzGram app-bar uslubida (JobCardsActivity bilan bir xil skelet).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_home_main"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/notifAppBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/yuz_space_1"
            android:paddingTop="@dimen/yuz_space_3"
            android:paddingEnd="@dimen/yuz_space_2"
            android:paddingBottom="@dimen/yuz_space_2">

            <ImageButton
                android:id="@+id/btnNotifBack"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/yuz_notif_title"
                android:src="@drawable/ic_back"
                app:tint="@color/yuz_text" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/yuz_space_1"
                android:layout_weight="1"
                android:text="@string/yuz_notif_title"
                android:textColor="@color/yuz_text"
                android:textSize="@dimen/yuz_text_title"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/btnDeleteAllNotifications"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/yuz_notif_delete_all"
                android:padding="@dimen/yuz_space_3"
                android:src="@drawable/ic_delete"
                app:tint="@color/yuz_text_secondary" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/yuz_space_4"
            android:layout_marginEnd="@dimen/yuz_space_4"
            android:layout_marginBottom="@dimen/yuz_space_2"
            android:background="@drawable/bg_profile_modern_card"
            android:gravity="center_vertical"
            android:minHeight="56dp"
            android:orientation="horizontal"
            android:paddingStart="@dimen/yuz_space_4"
            android:paddingTop="@dimen/yuz_space_2"
            android:paddingEnd="@dimen/yuz_space_3"
            android:paddingBottom="@dimen/yuz_space_2">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/yuz_notif_sound_title"
                    android:textColor="@color/yuz_text"
                    android:textSize="@dimen/yuz_text_body"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/yuz_notif_sound_subtitle"
                    android:textColor="@color/yuz_text_secondary"
                    android:textSize="@dimen/yuz_text_caption" />
            </LinearLayout>

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switchReelNotifSound"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/yuz_space_2"
                app:thumbTint="@color/yuz_action" />
        </LinearLayout>
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvNotifications"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingStart="@dimen/yuz_space_4"
            android:paddingTop="@dimen/yuz_space_1"
            android:paddingEnd="@dimen/yuz_space_4"
            android:paddingBottom="90dp" />

        <TextView
            android:id="@+id/tvNotificationsEmpty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:padding="@dimen/yuz_space_8"
            android:text="@string/yuz_notif_empty"
            android:textColor="@color/yuz_text_secondary"
            android:textSize="@dimen/yuz_text_body"
            android:visibility="gone" />

        <ProgressBar
            android:id="@+id/notificationsProgress"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="center"
            android:indeterminateTint="@color/yuz_action" />
    </FrameLayout>
</LinearLayout>
