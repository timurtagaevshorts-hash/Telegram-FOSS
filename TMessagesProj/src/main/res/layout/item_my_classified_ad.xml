<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/adCardRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="6dp"
    app:cardBackgroundColor="@color/surface_elevated"
    app:cardCornerRadius="@dimen/yuz_radius_card"
    app:cardElevation="3dp"
    app:strokeColor="@color/modern_border"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/yuz_space_3">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="96dp"
                android:layout_height="96dp"
                app:cardBackgroundColor="@color/modern_surface"
                app:cardCornerRadius="@dimen/yuz_radius_field"
                app:cardElevation="0dp"
                app:strokeColor="@color/modern_border"
                app:strokeWidth="1dp">

                <ImageView
                    android:id="@+id/ivAdImage"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@null"
                    android:scaleType="centerCrop" />
            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/yuz_space_3"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvAdModel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/yuz_action"
                    android:textSize="@dimen/yuz_text_secondary"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvCategory"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/yuz_text_secondary"
                    android:textSize="@dimen/yuz_text_caption"
                    android:textStyle="bold"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tvAdTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/yuz_space_1"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:textColor="@color/yuz_text"
                    android:textSize="@dimen/yuz_text_body"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvAdPrice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/yuz_space_2"
                    android:paddingHorizontal="@dimen/yuz_space_2"
                    android:paddingVertical="@dimen/yuz_space_1"
                    android:textColor="@color/yuz_gold"
                    android:textSize="@dimen/yuz_text_secondary"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvBlockedStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/yuz_space_1"
                    android:background="@drawable/bg_admin_blocked_badge"
                    android:paddingHorizontal="@dimen/yuz_space_2"
                    android:paddingVertical="2dp"
                    android:text="@string/classified_ad_blocked_status"
                    android:textColor="@color/yuz_danger"
                    android:textSize="@dimen/yuz_text_micro"
                    android:textStyle="bold"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/yuz_space_3"
            android:gravity="end"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnEditAd"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/yuz_button_sm"
                android:text="@string/classified_edit"
                app:cornerRadius="@dimen/yuz_radius_field" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDeleteAd"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/yuz_button_sm"
                android:layout_marginStart="@dimen/yuz_space_2"
                android:text="@string/classified_delete"
                app:cornerRadius="@dimen/yuz_radius_field" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
