<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_chat_room_gradient"
    android:orientation="vertical">

    <!-- Top bar -->
    <LinearLayout
        android:id="@+id/aiTopBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/yuz_space_1"
        android:paddingEnd="@dimen/yuz_space_2"
        android:paddingBottom="@dimen/yuz_space_2">

        <ImageButton
            android:id="@+id/btnAiBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@null"
            android:src="@drawable/ic_back"
            app:tint="@color/yuz_text" />

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginStart="@dimen/yuz_space_2"
            android:src="@drawable/ic_yuz_mic"
            app:tint="@color/yuz_action" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/yuz_space_2"
            android:text="@string/ai_title"
            android:textColor="@color/yuz_text"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Suhbat jurnali -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/aiScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:paddingBottom="@dimen/yuz_space_3"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/aiLog"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/yuz_gutter"
            android:paddingEnd="@dimen/yuz_gutter" />
    </androidx.core.widget.NestedScrollView>

    <!-- Tezkor tugmalar qatori -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/yuz_space_4"
        android:paddingEnd="@dimen/yuz_space_4"
        android:clipToPadding="false"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/aiChips"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal" />
    </HorizontalScrollView>

    <!-- Holat matni + mikrofon -->
    <TextView
        android:id="@+id/tvAiStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/yuz_space_3"
        android:gravity="center"
        android:paddingStart="@dimen/yuz_space_6"
        android:paddingEnd="@dimen/yuz_space_6"
        android:textColor="@color/yuz_text_secondary"
        android:textSize="@dimen/yuz_text_body" />

    <FrameLayout
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="@dimen/yuz_space_3"
        android:layout_marginBottom="28dp">

        <View
            android:id="@+id/aiMicRing"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_ai_ring"
            android:alpha="0" />

        <ImageButton
            android:id="@+id/btnAiMic"
            android:layout_width="92dp"
            android:layout_height="92dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_ai_mic"
            android:contentDescription="@string/ai_listening"
            android:elevation="6dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_yuz_mic"
            app:tint="@color/yuz_text" />
    </FrameLayout>
</LinearLayout>
