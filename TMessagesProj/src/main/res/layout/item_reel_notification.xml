<?xml version="1.0" encoding="utf-8"?>
<!--
  Bitta Reels bildirishnomasi kartasi — donor `item_reel_notification.xml`
  asosida, YuzGram qora-neon mavzusiga moslashtirilgan.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="@drawable/bg_profile_modern_card"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="12dp">

    <View
        android:id="@+id/viewUnreadDot"
        android:layout_width="8dp"
        android:layout_height="8dp"
        android:layout_marginEnd="8dp"
        android:background="@drawable/bg_yuz_unread_dot"
        android:visibility="invisible" />

    <FrameLayout
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:background="@drawable/bg_yuz_circle_gradient">

        <TextView
            android:id="@+id/tvActorInitial"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:gravity="center"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/ivActorPhoto"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:contentDescription="@null"
            android:scaleType="centerCrop" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvNotificationTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvNotificationReel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/home_accent_purple"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvNotificationBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvNotificationTime"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/text_hint"
            android:textSize="11sp" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="46dp"
        android:layout_height="60dp"
        android:layout_marginStart="8dp">

        <ImageView
            android:id="@+id/ivReelThumb"
            android:layout_width="46dp"
            android:layout_height="60dp"
            android:background="@drawable/bg_classified_image_placeholder"
            android:contentDescription="@null"
            android:scaleType="centerCrop" />

        <ImageView
            android:id="@+id/ivNotifType"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_gravity="bottom|end"
            android:background="@drawable/bg_yuz_reel_badge"
            android:padding="3dp"
            android:src="@drawable/ic_yuz_heart"
            app:tint="#FFFFFF" />
    </FrameLayout>

    <ImageButton
        android:id="@+id/btnDeleteNotification"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:layout_marginStart="4dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/yuz_notif_delete_all"
        android:padding="8dp"
        android:src="@drawable/ic_delete"
        app:tint="@color/text_secondary" />
</LinearLayout>
