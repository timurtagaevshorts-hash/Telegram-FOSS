<?xml version="1.0" encoding="utf-8"?>
<!-- Admin "Reklama" tab qatori: thumbnail + sarlavha/joylashuv + o'chirish -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/yuz_space_2"
    android:background="@drawable/bg_profile_modern_card"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="@dimen/yuz_space_3">

    <ImageView
        android:id="@+id/ivAdminAdThumb"
        android:layout_width="58dp"
        android:layout_height="58dp"
        android:background="@drawable/bg_yuz_pill"
        android:clipToOutline="true"
        android:contentDescription="@null"
        android:scaleType="centerCrop" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/yuz_space_3"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvAdminAdTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/yuz_text"
            android:textSize="@dimen/yuz_text_body"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvAdminAdMeta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/yuz_space_1"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="@color/yuz_text_secondary"
            android:textSize="@dimen/yuz_text_caption" />

        <TextView
            android:id="@+id/tvAdminAdStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/yuz_space_1"
            android:textColor="@color/yuz_action"
            android:textSize="@dimen/yuz_text_caption"
            android:textStyle="bold" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/btnAdminAdDelete"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:layout_marginStart="@dimen/yuz_space_2"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/kino_admin_delete"
        android:padding="@dimen/yuz_space_2"
        android:src="@drawable/ic_delete"
        android:tint="@color/yuz_text_secondary" />
</LinearLayout>
