<?xml version="1.0" encoding="utf-8"?>
<!-- YuzGram #62: ekvalayzer dialogi — preset tanlash + bas kuchi -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="8dp"
    android:paddingEnd="20dp"
    android:paddingBottom="8dp">

    <RadioGroup
        android:id="@+id/eqPresetGroup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <RadioButton
            android:id="@+id/eqPresetFlat"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:text="@string/musiqa_preset_flat"
            android:textColor="@color/text_primary" />

        <RadioButton
            android:id="@+id/eqPresetBass"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:text="@string/musiqa_preset_bass"
            android:textColor="@color/text_primary" />

        <RadioButton
            android:id="@+id/eqPresetJazz"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:text="@string/musiqa_preset_jazz"
            android:textColor="@color/text_primary" />

        <RadioButton
            android:id="@+id/eqPresetRock"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:text="@string/musiqa_preset_rock"
            android:textColor="@color/text_primary" />

        <RadioButton
            android:id="@+id/eqPresetVocal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:text="@string/musiqa_preset_vocal"
            android:textColor="@color/text_primary" />
    </RadioGroup>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/musiqa_bass_power"
        android:textColor="@color/text_secondary"
        android:textSize="13sp" />

    <SeekBar
        android:id="@+id/eqBassSeek"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:max="100" />

    <TextView
        android:id="@+id/tvEqHint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/musiqa_eq_hint"
        android:textColor="@color/text_secondary"
        android:textSize="12sp" />
</LinearLayout>
