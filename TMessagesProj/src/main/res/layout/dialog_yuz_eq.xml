<?xml version="1.0" encoding="utf-8"?>
<!-- YuzGram #62: ekvalayzer dialogi — preset tanlash + bas kuchi -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="@dimen/yuz_gutter"
    android:paddingTop="@dimen/yuz_space_2"
    android:paddingEnd="@dimen/yuz_gutter"
    android:paddingBottom="@dimen/yuz_space_2">

    <RadioGroup
        android:id="@+id/eqPresetGroup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <RadioButton
            android:id="@+id/eqPresetFlat"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="@dimen/yuz_space_2"
            android:paddingBottom="@dimen/yuz_space_2"
            android:text="@string/musiqa_preset_flat"
            android:textColor="@color/yuz_text" />

        <RadioButton
            android:id="@+id/eqPresetBass"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="@dimen/yuz_space_2"
            android:paddingBottom="@dimen/yuz_space_2"
            android:text="@string/musiqa_preset_bass"
            android:textColor="@color/yuz_text" />

        <RadioButton
            android:id="@+id/eqPresetJazz"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="@dimen/yuz_space_2"
            android:paddingBottom="@dimen/yuz_space_2"
            android:text="@string/musiqa_preset_jazz"
            android:textColor="@color/yuz_text" />

        <RadioButton
            android:id="@+id/eqPresetRock"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="@dimen/yuz_space_2"
            android:paddingBottom="@dimen/yuz_space_2"
            android:text="@string/musiqa_preset_rock"
            android:textColor="@color/yuz_text" />

        <RadioButton
            android:id="@+id/eqPresetVocal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="@dimen/yuz_space_2"
            android:paddingBottom="@dimen/yuz_space_2"
            android:text="@string/musiqa_preset_vocal"
            android:textColor="@color/yuz_text" />
    </RadioGroup>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/yuz_space_3"
        android:text="@string/musiqa_bass_power"
        android:textColor="@color/yuz_text_secondary"
        android:textSize="@dimen/yuz_text_secondary" />

    <SeekBar
        android:id="@+id/eqBassSeek"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:max="100" />

    <TextView
        android:id="@+id/tvEqHint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/yuz_space_2"
        android:text="@string/musiqa_eq_hint"
        android:textColor="@color/yuz_text_secondary"
        android:textSize="@dimen/yuz_text_secondary" />
</LinearLayout>
