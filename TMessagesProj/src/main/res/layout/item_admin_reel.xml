<?xml version="1.0" encoding="utf-8"?>
<!-- Admin "Reels" tab qatori: sarlavha + meta + o'chirish -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/yuz_space_2"
    android:background="@drawable/bg_profile_modern_card"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="@dimen/yuz_space_3">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvAdminReelTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/yuz_text"
            android:textSize="@dimen/yuz_text_body"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvAdminReelMeta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/yuz_space_1"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="@color/yuz_text_secondary"
            android:textSize="@dimen/yuz_text_caption" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/btnAdminReelDelete"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:layout_marginStart="@dimen/yuz_space_2"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/kino_admin_delete"
        android:padding="@dimen/yuz_space_2"
        android:src="@drawable/ic_delete"
        app:tint="@color/yuz_text_secondary" />
</LinearLayout>
