<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_chat_room_gradient"
    android:orientation="vertical">

    <!-- Top bar -->
    <LinearLayout
        android:id="@+id/dlTopBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/yuz_space_1"
        android:paddingEnd="@dimen/yuz_space_2"
        android:paddingBottom="@dimen/yuz_space_2">

        <ImageButton
            android:id="@+id/btnDlBack"
            style="@style/YuzIconButton"
            android:contentDescription="@string/yuz_a11y_back"
            android:src="@drawable/ic_back" />

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginStart="@dimen/yuz_space_2"
            android:src="@drawable/ic_yuz_box"
            app:tint="@color/yuz_action" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/yuz_space_2"
            android:text="@string/musiqa_dl_folder_title"
            android:textColor="@color/yuz_text"
            android:textSize="@dimen/yuz_text_title"
            android:textStyle="bold" />

        <!-- YuzGram #128: umumiy hajm pilli — "12 trek • 84 MB" -->
        <TextView
            android:id="@+id/tvDlSummary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/yuz_space_1"
            android:background="@drawable/bg_yuz_pill"
            android:paddingStart="@dimen/yuz_space_3"
            android:paddingTop="5dp"
            android:paddingEnd="@dimen/yuz_space_3"
            android:paddingBottom="5dp"
            android:textColor="@color/yuz_text_secondary"
            android:textSize="@dimen/yuz_text_secondary" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvDownloads"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="@dimen/yuz_space_4" />

        <!-- Bo'sh holat: markazda neon ikon + sarlavha + maslahat -->
        <LinearLayout
            android:id="@+id/dlEmptyBox"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingStart="@dimen/yuz_space_4"
            android:paddingEnd="@dimen/yuz_space_4"
            android:visibility="gone">

            <ImageView
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:alpha="0.5"
                android:src="@drawable/ic_yuz_music"
                app:tint="@color/yuz_action" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/yuz_space_2"
                android:text="@string/musiqa_dl_folder_empty"
                android:textColor="@color/yuz_text"
                android:textSize="@dimen/yuz_text_title"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/yuz_space_1"
                android:gravity="center"
                android:text="@string/musiqa_dl_folder_hint"
                android:textColor="@color/yuz_text_secondary"
                android:textSize="@dimen/yuz_text_secondary" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
