<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="78dp"
    android:layout_height="wrap_content"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingTop="2dp"
    android:paddingBottom="4dp">

    <FrameLayout
        android:id="@+id/storyRing"
        android:layout_width="66dp"
        android:layout_height="66dp"
        android:background="@drawable/bg_story_circle_ring"
        android:padding="3dp">

        <FrameLayout
            android:id="@+id/storyAvatarHost"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <ImageView
            android:id="@+id/storyAddBadge"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_gravity="bottom|end"
            android:background="@drawable/bg_reels_send"
            android:contentDescription="@string/story_post"
            android:padding="4dp"
            android:src="@drawable/ic_yuz_add"
            android:tint="#FFFFFF"
            android:visibility="gone" />
    </FrameLayout>

    <TextView
        android:id="@+id/tvStoryCircleName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="1"
        android:textColor="@color/yuz_text"
        android:textSize="11sp" />

</LinearLayout>
