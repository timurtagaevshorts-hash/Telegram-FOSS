<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/adCardRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_marginHorizontal="16dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    app:cardBackgroundColor="@color/classified_card_default_bg"
    app:cardCornerRadius="16dp"
    app:cardElevation="5dp"
    app:strokeColor="@color/yuz_stroke_soft"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/yuz_space_3"
        android:paddingTop="@dimen/yuz_space_3"
        android:paddingEnd="@dimen/yuz_space_3"
        android:paddingBottom="@dimen/yuz_space_3">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/yuz_space_3"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvCategoryBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_classified_category_badge"
                android:paddingStart="@dimen/yuz_space_2"
                android:paddingTop="@dimen/yuz_space_1"
                android:paddingEnd="@dimen/yuz_space_2"
                android:paddingBottom="@dimen/yuz_space_1"
                android:textColor="@color/yuz_text"
                android:textSize="10sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvAdModel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/yuz_action"
                android:textSize="@dimen/yuz_text_secondary"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvAdTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/yuz_space_1"
                android:ellipsize="end"
                android:maxLines="2"
                android:textColor="@color/yuz_text"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvAdPrice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/yuz_space_2"
                android:background="@drawable/bg_classified_price_badge"
                android:paddingStart="@dimen/yuz_space_2"
                android:paddingTop="@dimen/yuz_space_1"
                android:paddingEnd="@dimen/yuz_space_2"
                android:paddingBottom="@dimen/yuz_space_1"
                android:textColor="@color/yuz_gold"
                android:textSize="@dimen/yuz_text_secondary"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/adAddressRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/ivAdAddressIcon"
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_location_pin"
                    app:tint="@color/yuz_action" />

                <TextView
                    android:id="@+id/tvAdAddress"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/yuz_space_1"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/yuz_text_secondary"
                    android:textSize="@dimen/yuz_text_caption" />
            </LinearLayout>
        </LinearLayout>

        <FrameLayout
            android:id="@+id/cardAdImage"
            android:layout_width="96dp"
            android:layout_height="96dp">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:cardBackgroundColor="#0DFFFFFF"
                app:cardCornerRadius="14dp"
                app:cardElevation="2dp"
                app:strokeColor="#33FFFFFF"
                app:strokeWidth="1dp">

                <ImageView
                    android:id="@+id/ivAdImage"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@null"
                    android:scaleType="centerCrop" />
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/tvImageCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|end"
                android:layout_margin="2dp"
                android:background="@drawable/bg_classified_image_count_badge"
                android:paddingStart="@dimen/yuz_space_2"
                android:paddingTop="2dp"
                android:paddingEnd="@dimen/yuz_space_2"
                android:paddingBottom="2dp"
                android:textColor="@color/yuz_text"
                android:textSize="9sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </FrameLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
