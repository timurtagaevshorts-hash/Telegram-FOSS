<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="140dp"
    android:layout_margin="2dp"
    android:background="@color/modern_surface"
    android:foreground="?attr/selectableItemBackground">

    <ImageView
        android:id="@+id/ivReelThumb"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="centerCrop" />

    <View
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_classified_ad_scrim" />

    <TextView
        android:id="@+id/tvReelViews"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="8dp"
        android:layout_marginBottom="8dp"
        android:drawablePadding="4dp"
        android:drawableStart="@drawable/ic_yuz_eye"
        android:shadowColor="#80000000"
        android:shadowRadius="4"
        android:text="0"
        android:textColor="@color/yuz_text"
        android:textSize="12sp"
        android:textStyle="bold" />

    <ImageView
        android:id="@+id/tvReelDelete"
        android:layout_width="@dimen/yuz_icon_button"
        android:layout_height="@dimen/yuz_icon_button"
        android:layout_gravity="top|end"
        android:background="@drawable/bg_yuz_tile_delete"
        android:contentDescription="@string/reels_delete"
        android:foreground="?attr/selectableItemBackgroundBorderless"
        android:padding="@dimen/yuz_space_3"
        android:src="@drawable/ic_yuz_close"
        android:tint="@color/yuz_text"
        android:visibility="gone" />
</FrameLayout>
