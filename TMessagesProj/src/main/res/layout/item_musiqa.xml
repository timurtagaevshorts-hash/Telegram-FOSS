<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="@dimen/yuz_space_4"
    android:paddingTop="@dimen/yuz_space_2"
    android:paddingEnd="@dimen/yuz_space_3"
    android:paddingBottom="@dimen/yuz_space_2">

    <ImageView
        android:id="@+id/ivMusiqaCover"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:background="@color/modern_surface_high"
        android:contentDescription="@null"
        android:scaleType="centerCrop" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/yuz_space_3"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvMusiqaTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/yuz_text"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvMusiqaArtist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/yuz_text_secondary"
            android:textSize="@dimen/yuz_text_secondary" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvMusiqaDur"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/yuz_space_2"
        android:textColor="@color/yuz_text_secondary"
        android:textSize="@dimen/yuz_text_secondary" />

    <!-- YuzGram #62: qo'shiqni keshga yuklab olish -->
    <ImageButton
        android:id="@+id/btnMusiqaDl"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginStart="@dimen/yuz_space_1"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@null"
        android:src="@drawable/ic_yuz_download"
        app:tint="@color/yuz_text_secondary" />

    <ImageButton
        android:id="@+id/btnMusiqaPlay"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginStart="@dimen/yuz_space_1"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@null"
        android:src="@drawable/ic_yuz_play"
        app:tint="@color/yuz_action" />
</LinearLayout>
