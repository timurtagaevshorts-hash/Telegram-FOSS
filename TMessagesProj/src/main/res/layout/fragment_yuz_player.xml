<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/plRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_chat_room_gradient">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="@dimen/yuz_gutter"
        android:paddingEnd="@dimen/yuz_gutter">

        <!-- Top qator: yopish + brend -->
        <LinearLayout
            android:id="@+id/plTopBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingTop="@dimen/yuz_space_2"
            android:paddingBottom="@dimen/yuz_space_1">

            <ImageButton
                android:id="@+id/btnPlClose"
                android:layout_width="@dimen/yuz_icon_button"
                android:layout_height="@dimen/yuz_icon_button"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/musiqa_pl_close"
                android:src="@drawable/ic_yuz_chevron_down"
                app:tint="@color/yuz_text" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="end"
                android:text="YuzGram Music"
                android:textColor="@color/yuz_text_secondary"
                android:textSize="@dimen/yuz_text_secondary"
                android:textStyle="bold" />

            <View
                android:layout_width="@dimen/yuz_icon_button"
                android:layout_height="@dimen/yuz_icon_button" />
        </LinearLayout>

        <!-- Muqova -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <ImageView
                android:id="@+id/plCover"
                android:layout_width="260dp"
                android:layout_height="260dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_yuz_cover"
                android:clipToOutline="true"
                android:contentDescription="@null"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_yuz_music"
                android:padding="0dp" />
        </FrameLayout>

        <!-- Sarlavha -->
        <TextView
            android:id="@+id/tvPlTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="marquee"
            android:focusable="true"
            android:marqueeRepeatLimit="marquee_forever"
            android:singleLine="true"
            android:text="—"
            android:textColor="@color/yuz_text"
            android:textSize="@dimen/yuz_text_title"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvPlArtist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/yuz_space_1"
            android:ellipsize="end"
            android:singleLine="true"
            android:text=""
            android:textColor="@color/yuz_text_secondary"
            android:textSize="@dimen/yuz_text_body" />

        <!-- Seek -->
        <SeekBar
            android:id="@+id/plSeek"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/yuz_space_3" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvPlPos"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="0:00"
                android:textColor="@color/yuz_text_secondary"
                android:textSize="@dimen/yuz_text_caption" />

            <TextView
                android:id="@+id/tvPlDur"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0:00"
                android:textColor="@color/yuz_text_secondary"
                android:textSize="@dimen/yuz_text_caption" />
        </LinearLayout>

        <!-- Asosiy tugmalar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/yuz_space_3"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btnPlShuffle"
                android:layout_width="@dimen/yuz_icon_button"
                android:layout_height="@dimen/yuz_icon_button"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/musiqa_pl_shuffle"
                android:padding="@dimen/yuz_space_2"
                android:src="@drawable/ic_yuz_shuffle"
                app:tint="@color/yuz_text" />

            <ImageButton
                android:id="@+id/btnPlPrev"
                android:layout_width="@dimen/yuz_button"
                android:layout_height="@dimen/yuz_button"
                android:layout_marginEnd="@dimen/yuz_space_3"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/musiqa_pl_prev"
                android:padding="@dimen/yuz_space_2"
                android:src="@drawable/ic_yuz_prev"
                app:tint="@color/yuz_text" />

            <ImageButton
                android:id="@+id/btnPlPlay"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:background="@drawable/bg_yuz_play"
                android:contentDescription="@string/musiqa_pl_play"
                android:padding="@dimen/yuz_space_4"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_yuz_play"
                app:tint="@color/yuz_text_on_accent" />

            <ImageButton
                android:id="@+id/btnPlNext"
                android:layout_width="@dimen/yuz_button"
                android:layout_height="@dimen/yuz_button"
                android:layout_marginStart="@dimen/yuz_space_3"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/musiqa_pl_next"
                android:padding="@dimen/yuz_space_2"
                android:src="@drawable/ic_yuz_next"
                app:tint="@color/yuz_text" />

            <ImageButton
                android:id="@+id/btnPlRepeat"
                android:layout_width="@dimen/yuz_icon_button"
                android:layout_height="@dimen/yuz_icon_button"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/musiqa_pl_repeat"
                android:padding="@dimen/yuz_space_2"
                android:src="@drawable/ic_yuz_loop"
                app:tint="@color/yuz_text" />
        </LinearLayout>

        <!-- Ikkilamchi qator -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/yuz_space_3"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/btnPlSpeed"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingVertical="@dimen/yuz_space_2">

                <ImageView
                    android:layout_width="@dimen/yuz_icon"
                    android:layout_height="@dimen/yuz_icon"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_yuz_speed"
                    app:tint="@color/yuz_text" />

                <TextView
                    android:id="@+id/tvPlSpeedLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/yuz_space_1"
                    android:text="@string/musiqa_pl_speed"
                    android:textColor="@color/yuz_text_secondary"
                    android:textSize="@dimen/yuz_text_micro" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btnPlQueue"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingVertical="@dimen/yuz_space_2">

                <ImageView
                    android:layout_width="@dimen/yuz_icon"
                    android:layout_height="@dimen/yuz_icon"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_yuz_queue"
                    app:tint="@color/yuz_text" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/yuz_space_1"
                    android:text="@string/musiqa_pl_queue"
                    android:textColor="@color/yuz_text_secondary"
                    android:textSize="@dimen/yuz_text_micro" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btnPlHeart"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingVertical="@dimen/yuz_space_2">

                <ImageView
                    android:id="@+id/ivPlHeart"
                    android:layout_width="@dimen/yuz_icon"
                    android:layout_height="@dimen/yuz_icon"
                    android:contentDescription="@string/yuz_a11y_favorite"
                    android:src="@drawable/ic_yuz_heart"
                    app:tint="@color/yuz_text" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/yuz_space_1"
                    android:text="@string/musiqa_pl_fav"
                    android:textColor="@color/yuz_text_secondary"
                    android:textSize="@dimen/yuz_text_micro" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btnPlDl"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingVertical="@dimen/yuz_space_2">

                <ImageView
                    android:layout_width="@dimen/yuz_icon"
                    android:layout_height="@dimen/yuz_icon"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_yuz_download"
                    app:tint="@color/yuz_text" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/yuz_space_1"
                    android:text="@string/musiqa_pl_dl"
                    android:textColor="@color/yuz_text_secondary"
                    android:textSize="@dimen/yuz_text_micro" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btnPlEq"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingVertical="@dimen/yuz_space_2">

                <ImageView
                    android:layout_width="@dimen/yuz_icon"
                    android:layout_height="@dimen/yuz_icon"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_yuz_eq"
                    app:tint="@color/yuz_text" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/yuz_space_1"
                    android:text="@string/musiqa_pl_eq"
                    android:textColor="@color/yuz_text_secondary"
                    android:textSize="@dimen/yuz_text_micro" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btnPlSleep"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingVertical="@dimen/yuz_space_2">

                <ImageView
                    android:layout_width="@dimen/yuz_icon"
                    android:layout_height="@dimen/yuz_icon"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_yuz_timer"
                    app:tint="@color/yuz_text" />

                <TextView
                    android:id="@+id/tvPlSleepLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/yuz_space_1"
                    android:text="@string/musiqa_pl_sleep"
                    android:textColor="@color/yuz_text_secondary"
                    android:textSize="@dimen/yuz_text_micro" />
            </LinearLayout>
        </LinearLayout>

        <!-- Radio chip -->
        <TextView
            android:id="@+id/tvPlRadio"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="@dimen/yuz_space_3"
            android:layout_marginBottom="@dimen/yuz_space_4"
            android:background="@drawable/bg_yuz_pill"
            android:paddingStart="@dimen/yuz_space_4"
            android:paddingTop="@dimen/yuz_space_2"
            android:paddingEnd="@dimen/yuz_space_4"
            android:paddingBottom="@dimen/yuz_space_2"
            android:text="@string/musiqa_pl_radio_off"
            android:textColor="@color/yuz_text_secondary"
            android:textSize="@dimen/yuz_text_secondary"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Tezlik paneli -->
    <LinearLayout
        android:id="@+id/plSpeedPanel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="96dp"
        android:background="@drawable/bg_yuz_mini"
        android:elevation="12dp"
        android:orientation="horizontal"
        android:padding="@dimen/yuz_space_2"
        android:visibility="gone" />

    <!-- Navbat paneli (balandlik kodda: ekranning ~46% — XML foizni
         FrameLayout farzandida qo'llab-quvvatlamaydi) -->
    <LinearLayout
        android:id="@+id/plQueuePanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_yuz_sheet"
        android:elevation="12dp"
        android:orientation="vertical"
        android:paddingTop="@dimen/yuz_space_3"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/yuz_gutter"
            android:paddingEnd="@dimen/yuz_space_2">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/musiqa_pl_queue"
                android:textColor="@color/yuz_text"
                android:textSize="@dimen/yuz_text_section"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/btnQueueClose"
                android:layout_width="@dimen/yuz_button_sm"
                android:layout_height="@dimen/yuz_button_sm"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/musiqa_pl_queue_close"
                android:padding="@dimen/yuz_space_2"
                android:src="@drawable/ic_yuz_close"
                app:tint="@color/yuz_text" />
        </LinearLayout>

        <TextView
            android:id="@+id/plQueueEmpty"
            style="@style/YuzEmptyHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/yuz_space_6"
            android:gravity="center"
            android:paddingStart="@dimen/yuz_gutter"
            android:paddingEnd="@dimen/yuz_gutter"
            android:text="@string/musiqa_pl_queue_empty"
            android:visibility="gone" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/plQueueRv"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingBottom="@dimen/yuz_space_3" />
    </LinearLayout>
</FrameLayout>
