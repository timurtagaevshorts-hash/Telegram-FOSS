<?xml version="1.0" encoding="utf-8"?>
<!--
  YuzGram Premium ekrani — qora-neon palitrada tarif tanlash + Google Play
  to'lovi. KinoTOP4'dagi activity_premium.xml mexanizmining fork moslamasi
  (Theme.YuzGramAds ContextThemeWrapper ostida, BaseFragment ichida).

  Dizayn qoidalari (f1): narx — kartadagi eng yirik raqam; CTA — bitta
  YuzButton balandligi/radiusi; imtiyozlar ro'yxati emoji nishon + sarlavha +
  izoh ko'rinishida kodda qo'shiladi (YuzPremiumActivity.fillBenefits).
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/yuz_bg">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/premiumScroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/yuz_gutter"
            android:paddingTop="@dimen/yuz_space_2"
            android:paddingEnd="@dimen/yuz_gutter"
            android:paddingBottom="@dimen/yuz_space_8">

            <LinearLayout
                android:id="@+id/premiumTopBar"
                android:layout_width="match_parent"
                android:layout_height="@dimen/yuz_field_height"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/btnPremiumBack"
                    style="@style/YuzIconButton"
                    android:contentDescription="@string/premium_back"
                    android:src="@drawable/ic_yuz_back" />

                <TextView
                    style="@style/YuzScreenTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:paddingStart="@dimen/yuz_space_2"
                    android:paddingEnd="@dimen/yuz_space_2"
                    android:text="@string/premium_screen_title" />
            </LinearLayout>

            <!-- Hero: brend gradientida nishon, sarlavha va uchta kalit chip. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/yuz_space_2"
                android:background="@drawable/bg_yuz_premium_hero"
                android:orientation="vertical"
                android:padding="@dimen/yuz_space_5">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <FrameLayout
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:background="@drawable/bg_yuz_hero_chip">

                        <ImageView
                            android:layout_width="26dp"
                            android:layout_height="26dp"
                            android:layout_gravity="center"
                            android:contentDescription="@string/premium_badge_desc"
                            android:src="@drawable/ic_yuz_diamond"
                            android:tint="@color/yuz_text_on_accent" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/yuz_space_3"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvPremiumHero"
                            style="@style/YuzScreenTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/yuz_text_on_accent"
                            android:textSize="@dimen/yuz_text_display"
                            android:text="@string/premium_hero_title" />

                        <TextView
                            style="@style/YuzBodySecondary"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/yuz_space_1"
                            android:textColor="@color/yuz_text_on_accent_dim"
                            android:text="@string/premium_hero_subtitle" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/yuz_space_4"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/YuzPremiumHeroChip"
                        android:text="@string/premium_hero_chip_kino" />

                    <TextView
                        style="@style/YuzPremiumHeroChip"
                        android:layout_marginStart="@dimen/yuz_space_2"
                        android:text="@string/premium_hero_chip_reels" />

                    <TextView
                        style="@style/YuzPremiumHeroChip"
                        android:layout_marginStart="@dimen/yuz_space_2"
                        android:text="@string/premium_hero_chip_ai" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/tvPremiumStatus"
                style="@style/YuzPremiumCrest"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/yuz_space_3"
                android:visibility="gone" />

            <TextView
                style="@style/YuzLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/yuz_space_5"
                android:text="@string/premium_choose_label" />

            <!-- ==================== Premium Kino ==================== -->
            <LinearLayout
                android:id="@+id/cardKino"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/yuz_space_2"
                android:background="@drawable/bg_yuz_premium_card"
                android:orientation="vertical"
                android:padding="@dimen/yuz_space_4">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/YuzPremiumEmoji"
                        android:background="@drawable/bg_yuz_emoji_badge"
                        android:text="@string/premium_emoji_kino" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/yuz_space_3"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvKinoTitle"
                            style="@style/YuzSectionHeader"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textSize="@dimen/yuz_text_card_title" />

                        <TextView
                            android:id="@+id/tvKinoSubtitle"
                            style="@style/YuzPremiumCardSubtitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvKinoTag"
                        style="@style/YuzPremiumTagOutline"
                        android:layout_marginStart="@dimen/yuz_space_2" />
                </LinearLayout>

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="104dp"
                    android:layout_marginTop="@dimen/yuz_space_3"
                    android:background="@drawable/bg_yuz_art_frame"
                    android:clipToOutline="true">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="@string/premium_kino_art_desc"
                        android:scaleType="centerCrop"
                        android:src="@drawable/yuz_premium_kino_art" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/yuz_space_3"
                    android:gravity="bottom"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvKinoPrice"
                        style="@style/YuzScreenTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/yuz_gold"
                        android:textSize="@dimen/yuz_text_display" />

                    <TextView
                        style="@style/YuzCaption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/yuz_space_2"
                        android:layout_marginBottom="3dp"
                        android:text="@string/premium_price_period" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvKinoPlayPrice"
                    style="@style/YuzCaption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/yuz_space_1"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/llKinoBenefits"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/yuz_space_3"
                    android:orientation="vertical" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnPayKino"
                    style="@style/YuzButton"
                    android:layout_marginTop="@dimen/yuz_space_4"
                    android:enabled="false" />
            </LinearLayout>

            <!-- ==================== To'liq Premium ==================== -->
            <LinearLayout
                android:id="@+id/cardFull"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/yuz_space_4"
                android:background="@drawable/bg_yuz_premium_card_full"
                android:orientation="vertical"
                android:padding="@dimen/yuz_space_4">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/YuzPremiumEmoji"
                        android:background="@drawable/bg_yuz_emoji_badge_gold"
                        android:text="@string/premium_emoji_full" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/yuz_space_3"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvFullTitle"
                            style="@style/YuzSectionHeader"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textSize="@dimen/yuz_text_card_title" />

                        <TextView
                            android:id="@+id/tvFullSubtitle"
                            style="@style/YuzPremiumCardSubtitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvFullTag"
                        style="@style/YuzPremiumTagGold"
                        android:layout_marginStart="@dimen/yuz_space_2" />
                </LinearLayout>

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="112dp"
                    android:layout_marginTop="@dimen/yuz_space_3"
                    android:background="@drawable/bg_yuz_art_frame"
                    android:clipToOutline="true">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="@string/premium_full_art_desc"
                        android:scaleType="centerCrop"
                        android:src="@drawable/yuz_premium_full_art" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/yuz_space_3"
                    android:gravity="bottom"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvFullPrice"
                        style="@style/YuzScreenTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/yuz_gold"
                        android:textSize="@dimen/yuz_text_display" />

                    <TextView
                        style="@style/YuzCaption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/yuz_space_2"
                        android:layout_marginBottom="3dp"
                        android:text="@string/premium_price_period" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvFullPlayPrice"
                    style="@style/YuzCaption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/yuz_space_1"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/llFullBenefits"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/yuz_space_3"
                    android:orientation="vertical" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnPayFull"
                    style="@style/YuzButton"
                    android:layout_marginTop="@dimen/yuz_space_4"
                    android:enabled="false"
                    android:textColor="@color/yuz_text_on_accent"
                    app:backgroundTint="@color/yuz_gold"
                    app:rippleColor="@color/yuz_stroke_strong" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRestorePurchases"
                style="@style/YuzButtonSecondary"
                android:layout_marginTop="@dimen/yuz_space_3"
                android:text="@string/premium_restore" />

            <TextView
                style="@style/YuzCaption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/yuz_space_3"
                android:gravity="center"
                android:text="@string/premium_pay_note" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <LinearLayout
        android:id="@+id/premiumApprovedOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/yuz_bg"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="@dimen/yuz_space_8"
        android:visibility="gone">

        <FrameLayout
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:layout_marginBottom="@dimen/yuz_space_5"
            android:background="@drawable/bg_yuz_badge_ring">

            <ImageView
                android:id="@+id/ivPremiumBadge"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_gravity="center"
                android:contentDescription="@string/premium_badge_desc"
                android:src="@drawable/ic_yuz_star"
                android:tint="@color/yuz_gold" />
        </FrameLayout>

        <TextView
            android:id="@+id/tvApprovedTitle"
            style="@style/YuzScreenTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textColor="@color/yuz_gold" />

        <TextView
            android:id="@+id/tvApprovedSubtitle"
            style="@style/YuzBodySecondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/yuz_space_3"
            android:gravity="center"
            android:lineSpacingExtra="3dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnApprovedClose"
            style="@style/YuzButton"
            android:layout_marginTop="@dimen/yuz_space_6"
            android:text="@string/premium_done_close" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnApprovedPlans"
            style="@style/YuzButtonSecondary"
            android:layout_width="wrap_content"
            android:layout_marginTop="@dimen/yuz_space_3"
            android:text="@string/premium_view_plans" />
    </LinearLayout>
</FrameLayout>
