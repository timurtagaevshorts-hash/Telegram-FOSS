<?xml version="1.0" encoding="utf-8"?>
<!--
  YuzGram Premium ekrani — qora-neon palitrada tarif tanlash + Google Play
  to'lovi. KinoTOP4'dagi activity_premium.xml mexanizmining fork moslamasi
  (Theme.YuzGramAds ContextThemeWrapper ostida, BaseFragment ichida).

  Dizayn qoidalari (f1): narx — kartadagi eng yirik raqam; CTA — bitta
  YuzButton balandligi/radiusi; imtiyozlar ro'yxati matnoldi "✓" belgisi
  bilan emas, kodda qo'shiladigan vektor belgi bilan chiqadi.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/yuz_bg">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/premiumScroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/yuz_gutter"
            android:paddingTop="@dimen/yuz_space_2"
            android:paddingEnd="@dimen/yuz_gutter"
            android:paddingBottom="@dimen/yuz_space_8">

            <LinearLayout
                android:id="@+id/premiumTopBar"
                android:layout_width="match_parent"
                android:layout_height="@dimen/yuz_field_height"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/btnPremiumBack"
                    style="@style/YuzIconButton"
                    android:contentDescription="@string/premium_back"
                    android:src="@drawable/ic_yuz_back" />

                <TextView
                    style="@style/YuzScreenTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:paddingStart="@dimen/yuz_space_2"
                    android:paddingEnd="@dimen/yuz_space_2"
                    android:text="@string/premium_screen_title" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/yuz_space_2"
                android:background="@drawable/bg_yuz_premium_hero"
                android:orientation="vertical"
                android:padding="@dimen/yuz_space_5">

                <TextView
                    android:id="@+id/tvPremiumHero"
                    style="@style/YuzScreenTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/premium_hero_title" />

                <TextView
                    style="@style/YuzBodySecondary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/yuz_space_2"
                    android:text="@string/premium_hero_subtitle" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvPremiumStatus"
                style="@style/YuzLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/yuz_space_3"
                android:textColor="@color/yuz_gold"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/cardKino"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/yuz_space_4"
                android:background="@drawable/bg_yuz_premium_card"
                android:orientation="vertical"
                android:padding="@dimen/yuz_space_4">

                <TextView
                    android:id="@+id/tvKinoTitle"
                    style="@style/YuzSectionHeader"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <TextView
                    android:id="@+id/tvKinoPrice"
                    style="@style/YuzScreenTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/yuz_space_1"
                    android:textColor="@color/yuz_gold" />

                <TextView
                    android:id="@+id/tvKinoPlayPrice"
                    style="@style/YuzCaption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/yuz_space_1"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/llKinoBenefits"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/yuz_space_3"
                    android:orientation="vertical" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnPayKino"
                    style="@style/YuzButton"
                    android:layout_marginTop="@dimen/yuz_space_4"
                    android:enabled="false" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/cardFull"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/yuz_space_4"
                android:background="@drawable/bg_yuz_premium_card"
                android:orientation="vertical"
                android:padding="@dimen/yuz_space_4">

                <TextView
                    android:id="@+id/tvFullTitle"
                    style="@style/YuzSectionHeader"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <TextView
                    android:id="@+id/tvFullPrice"
                    style="@style/YuzScreenTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/yuz_space_1"
                    android:textColor="@color/yuz_gold" />

                <TextView
                    android:id="@+id/tvFullPlayPrice"
                    style="@style/YuzCaption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/yuz_space_1"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/llFullBenefits"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/yuz_space_3"
                    android:orientation="vertical" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnPayFull"
                    style="@style/YuzButton"
                    android:layout_marginTop="@dimen/yuz_space_4"
                    android:enabled="false" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRestorePurchases"
                style="@style/YuzButtonSecondary"
                android:layout_marginTop="@dimen/yuz_space_3"
                android:text="@string/premium_restore" />

            <TextView
                style="@style/YuzCaption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/yuz_space_3"
                android:gravity="center"
                android:text="@string/premium_pay_note" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <LinearLayout
        android:id="@+id/premiumApprovedOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/yuz_bg"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="@dimen/yuz_space_8"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvApprovedTitle"
            style="@style/YuzScreenTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textColor="@color/yuz_gold" />

        <TextView
            android:id="@+id/tvApprovedSubtitle"
            style="@style/YuzBodySecondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/yuz_space_3"
            android:gravity="center" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnApprovedClose"
            style="@style/YuzButton"
            android:layout_marginTop="@dimen/yuz_space_6"
            android:text="@string/premium_done_close" />
    </LinearLayout>
</FrameLayout>
