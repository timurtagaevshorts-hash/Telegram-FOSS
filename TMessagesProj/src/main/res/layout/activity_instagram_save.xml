<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_chat_room_gradient">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="@dimen/yuz_space_8">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/instagramSaveToolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:navigationIcon="@drawable/ic_back"
            app:title="@string/instagram_save_title"
            app:titleTextColor="@color/yuz_text" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/yuz_space_4"
            android:paddingTop="@dimen/yuz_space_1"
            android:paddingEnd="@dimen/yuz_space_4">

            <FrameLayout
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_instagram_gradient">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:contentDescription="@string/instagram_save_title"
                    android:src="@drawable/ic_yuz_instagram" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/yuz_space_3"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/instagram_save_hero"
                    android:textColor="@color/yuz_text"
                    android:textSize="@dimen/yuz_text_section"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/instagram_save_subtitle"
                    android:textColor="@color/yuz_text_secondary"
                    android:textSize="12.5sp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/yuz_space_4">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/classified_card_default_bg"
                app:cardCornerRadius="@dimen/yuz_radius_card"
                app:cardElevation="0dp"
                app:strokeColor="@color/yuz_stroke_soft"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/yuz_space_4">

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/instagram_save_link_hint"
                        android:textColorHint="@color/yuz_text_secondary"
                        app:boxCornerRadiusBottomEnd="14dp"
                        app:boxCornerRadiusBottomStart="14dp"
                        app:boxCornerRadiusTopEnd="14dp"
                        app:boxCornerRadiusTopStart="14dp"
                        app:boxStrokeColor="@color/yuz_action"
                        app:hintTextColor="@color/yuz_text_secondary">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etInstagramLink"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textUri"
                            android:maxLines="3"
                            android:textColor="@color/yuz_text"
                            android:textSize="@dimen/yuz_text_body" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/yuz_space_3"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnInstagramPaste"
                            style="@style/YuzButtonSecondary"
                            android:layout_width="0dp"
                            android:layout_height="@dimen/yuz_button"
                            android:layout_weight="1"
                            android:text="@string/instagram_save_paste" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnInstagramDownload"
                            android:layout_width="0dp"
                            android:layout_height="@dimen/yuz_button"
                            android:layout_marginStart="@dimen/yuz_space_3"
                            android:layout_weight="1.6"
                            style="@style/YuzButton"
                            android:text="@string/instagram_save_download"
                            app:icon="@drawable/ic_yuz_download"
                            app:iconGravity="textStart"
                            app:iconTint="@color/yuz_on_action" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:id="@+id/instagramProgressPanel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/yuz_space_3"
                android:background="@drawable/bg_instagram_progress"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="@dimen/yuz_space_4"
                android:paddingTop="@dimen/yuz_space_3"
                android:paddingEnd="@dimen/yuz_space_4"
                android:paddingBottom="@dimen/yuz_space_3"
                android:visibility="gone">

                <ProgressBar
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:indeterminateTint="@color/yuz_action" />

                <TextView
                    android:id="@+id/tvInstagramProgress"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/yuz_space_3"
                    android:textColor="@color/yuz_text"
                    android:textSize="13.5sp" />
            </LinearLayout>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/instagramResultCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/yuz_space_4"
                android:visibility="gone"
                app:cardBackgroundColor="@color/classified_card_default_bg"
                app:cardCornerRadius="@dimen/yuz_radius_card"
                app:cardElevation="8dp"
                app:strokeColor="@color/yuz_stroke_strong"
                app:strokeWidth="1.5dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/yuz_space_4">

                    <TextView
                        android:id="@+id/tvInstagramAuthor"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/yuz_space_3"
                        android:textColor="@color/yuz_text_secondary"
                        android:textSize="@dimen/yuz_text_secondary"
                        android:visibility="gone" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnInstagramSaveGallery"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/yuz_button"
                        style="@style/YuzButton"
                        android:text="@string/instagram_save_gallery"
                        app:icon="@drawable/ic_yuz_gallery"
                        app:iconGravity="textStart" />

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/yuz_space_4"
                        app:cardBackgroundColor="@color/yuz_surface"
                        app:cardCornerRadius="@dimen/yuz_radius_card"
                        app:cardElevation="0dp"
                        app:strokeColor="@color/yuz_stroke_soft"
                        app:strokeWidth="1dp">

                        <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="360dp">

                            <androidx.media3.ui.PlayerView
                                android:id="@+id/instagramPreviewPlayer"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                app:resize_mode="fit"
                                app:show_buffering="when_playing" />
                        </FrameLayout>
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
