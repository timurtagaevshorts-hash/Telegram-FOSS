<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet_comments"
    android:orientation="vertical"
    android:padding="@dimen/yuz_gutter">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="Izoh yozish"
        android:textColor="@color/yuz_text"
        android:textSize="@dimen/yuz_text_section"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/yuz_space_2"
        android:gravity="center"
        android:lineSpacingExtra="3dp"
        android:text="Izoh qoldirish uchun kiring va qisqa profil yarating.\nIlovaning boshqa qismlari uchun ro'yxatdan o'tish shart emas."
        android:textColor="@color/yuz_text_secondary"
        android:textSize="@dimen/yuz_text_secondary" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnPhoneSignIn"
        android:layout_width="match_parent"
        android:layout_height="@dimen/yuz_button"
        android:layout_marginTop="@dimen/yuz_gutter"
        android:text="@string/auth_phone_sign_in_button"
        android:textColor="@color/text_on_gold"
        android:textStyle="bold"
        app:backgroundTint="@color/yuz_text"
        app:cornerRadius="@dimen/yuz_radius_field"
        app:icon="@drawable/ic_login"
        app:iconGravity="textStart"
        app:iconTint="@color/yuz_text" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnCancelAuth"
        style="@style/Widget.MaterialComponents.Button.TextButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/yuz_space_1"
        android:text="Bekor qilish"
        android:textColor="@color/yuz_text_secondary" />
</LinearLayout>
