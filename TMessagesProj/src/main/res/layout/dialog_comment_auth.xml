<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet_comments"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="Izoh yozish"
        android:textColor="@color/text_primary"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:lineSpacingExtra="3dp"
        android:text="Izoh qoldirish uchun kiring va qisqa profil yarating.\nIlovaning boshqa qismlari uchun ro'yxatdan o'tish shart emas."
        android:textColor="@color/text_secondary"
        android:textSize="13sp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnPhoneSignIn"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="18dp"
        android:text="@string/auth_phone_sign_in_button"
        android:textColor="@color/text_on_gold"
        android:textStyle="bold"
        app:backgroundTint="@color/white"
        app:cornerRadius="25dp"
        app:icon="@drawable/ic_login"
        app:iconGravity="textStart"
        app:iconTint="@color/text_primary" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnCancelAuth"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Bekor qilish"
        android:textColor="@color/text_secondary" />
</LinearLayout>
