<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/yuz_bg">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/adsAppBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/yuz_bg"
        app:elevation="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_scrollFlags="scroll|enterAlways">

            <!-- Sarlavha qatori: belgi + nom/izoh + yordamchi tugmalar. -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="@dimen/yuz_gutter"
                android:paddingTop="@dimen/yuz_space_4"
                android:paddingEnd="@dimen/yuz_gutter"
                android:paddingBottom="@dimen/yuz_space_2">

                <ImageView
                    android:id="@+id/ivElonlarIcon"
                    android:layout_width="@dimen/yuz_icon"
                    android:layout_height="@dimen/yuz_icon"
                    android:layout_centerVertical="true"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_yuz_tag"
                    app:tint="@color/yuz_action" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/yuz_space_3"
                    android:layout_toEndOf="@id/ivElonlarIcon"
                    android:orientation="vertical">

                    <TextView
                        style="@style/YuzScreenTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/classified_ads_title" />

                    <TextView
                        style="@style/YuzScreenSubtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/classified_ads_subtitle" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <!--
                      Faza E: "Mening e'lonlarim" rejimi. Holat ranglari
                      ElonlarActivity.updateMyAdsButton() dan.
                    -->
                    <TextView
                        android:id="@+id/btnMyAds"
                        style="@style/YuzPill"
                        android:layout_marginEnd="@dimen/yuz_space_2"
                        android:text="@string/classified_my_ads" />

                    <ImageButton
                        android:id="@+id/btnElonlarSearch"
                        style="@style/YuzIconButton"
                        android:contentDescription="@string/classified_search_hint"
                        android:src="@drawable/ic_search" />
                </LinearLayout>
            </RelativeLayout>

            <!-- Kategoriyalar: alohida, to'liq kenglikdagi qator. -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipToPadding="false"
                android:overScrollMode="never"
                android:paddingStart="@dimen/yuz_gutter"
                android:paddingEnd="@dimen/yuz_gutter"
                android:paddingBottom="@dimen/yuz_space_2"
                android:scrollbars="none">

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/chipGroupCategories"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:chipSpacingHorizontal="@dimen/yuz_space_2"
                    app:singleLine="true"
                    app:singleSelection="true" />
            </HorizontalScrollView>

            <!-- Qidiruv paneli (qidiruv tugmasi bilan ochiladi). -->
            <LinearLayout
                android:id="@+id/adsSearchContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="vertical"
                android:paddingStart="@dimen/yuz_gutter"
                android:paddingEnd="@dimen/yuz_gutter"
                android:paddingBottom="@dimen/yuz_space_3"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/yuz_field_height"
                    android:layout_marginBottom="@dimen/yuz_space_2"
                    android:background="@drawable/bg_yuz_field"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/yuz_space_3"
                    android:paddingEnd="@dimen/yuz_space_3">

                    <ImageView
                        android:layout_width="@dimen/yuz_icon_sm"
                        android:layout_height="@dimen/yuz_icon_sm"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_search"
                        app:tint="@color/yuz_text_muted" />

                    <EditText
                        android:id="@+id/etSearchKeyword"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_marginStart="@dimen/yuz_space_2"
                        android:background="@null"
                        android:hint="@string/classified_search_keyword_hint"
                        android:imeOptions="actionSearch"
                        android:inputType="text"
                        android:maxLines="1"
                        android:textColor="@color/yuz_text"
                        android:textColorHint="@color/yuz_text_muted"
                        android:textSize="@dimen/yuz_text_body" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="@dimen/yuz_field_height"
                        android:layout_weight="1"
                        android:background="@drawable/bg_yuz_field"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="@dimen/yuz_space_3"
                        android:paddingEnd="@dimen/yuz_space_3">

                        <ImageView
                            android:layout_width="@dimen/yuz_icon_sm"
                            android:layout_height="@dimen/yuz_icon_sm"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_location_pin"
                            app:tint="@color/yuz_text_muted" />

                        <EditText
                            android:id="@+id/etSearchAddress"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_marginStart="@dimen/yuz_space_2"
                            android:layout_weight="1"
                            android:background="@null"
                            android:hint="@string/classified_search_location_hint"
                            android:imeOptions="actionSearch"
                            android:inputType="textCapSentences"
                            android:maxLines="1"
                            android:textColor="@color/yuz_text"
                            android:textColorHint="@color/yuz_text_muted"
                            android:textSize="@dimen/yuz_text_body" />
                    </LinearLayout>

                    <ImageButton
                        android:id="@+id/btnToggleFilter"
                        style="@style/YuzIconButton"
                        android:layout_width="@dimen/yuz_field_height"
                        android:layout_height="@dimen/yuz_field_height"
                        android:layout_marginStart="@dimen/yuz_space_2"
                        android:background="@drawable/bg_yuz_field"
                        android:contentDescription="@string/classified_filter"
                        android:src="@drawable/ic_filter"
                        app:tint="@color/yuz_action" />
                </LinearLayout>
            </LinearLayout>

            <!-- Filtrlar paneli -->
            <LinearLayout
                android:id="@+id/filterPanel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="@dimen/yuz_gutter"
                android:paddingEnd="@dimen/yuz_gutter"
                android:paddingBottom="@dimen/yuz_space_4"
                android:visibility="gone">

                <TextView
                    style="@style/YuzSectionHeader"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/yuz_space_3"
                    android:text="@string/classified_filter_title" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="@dimen/yuz_space_2"
                        android:layout_weight="1"
                        android:hint="@string/classified_filter_min_price"
                        app:boxBackgroundColor="@color/yuz_field"
                        app:boxCornerRadiusBottomEnd="@dimen/yuz_radius_field"
                        app:boxCornerRadiusBottomStart="@dimen/yuz_radius_field"
                        app:boxCornerRadiusTopEnd="@dimen/yuz_radius_field"
                        app:boxCornerRadiusTopStart="@dimen/yuz_radius_field"
                        app:hintTextColor="@color/yuz_text_secondary"
                        style="@style/Widget.MaterialComponents.TextInputLayout.FilledBox.Dense">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etFilterMinPrice"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="number"
                            android:textColor="@color/yuz_text"
                            android:textSize="@dimen/yuz_text_body" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:hint="@string/classified_filter_max_price"
                        app:boxBackgroundColor="@color/yuz_field"
                        app:boxCornerRadiusBottomEnd="@dimen/yuz_radius_field"
                        app:boxCornerRadiusBottomStart="@dimen/yuz_radius_field"
                        app:boxCornerRadiusTopEnd="@dimen/yuz_radius_field"
                        app:boxCornerRadiusTopStart="@dimen/yuz_radius_field"
                        app:hintTextColor="@color/yuz_text_secondary"
                        style="@style/Widget.MaterialComponents.TextInputLayout.FilledBox.Dense">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etFilterMaxPrice"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="number"
                            android:textColor="@color/yuz_text"
                            android:textSize="@dimen/yuz_text_body" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/yuz_space_2"
                    android:hint="@string/classified_search_location_hint"
                    app:boxBackgroundColor="@color/yuz_field"
                    app:boxCornerRadiusBottomEnd="@dimen/yuz_radius_field"
                    app:boxCornerRadiusBottomStart="@dimen/yuz_radius_field"
                    app:boxCornerRadiusTopEnd="@dimen/yuz_radius_field"
                    app:boxCornerRadiusTopStart="@dimen/yuz_radius_field"
                    app:hintTextColor="@color/yuz_text_secondary"
                    style="@style/Widget.MaterialComponents.TextInputLayout.FilledBox.Dense">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etFilterLocation"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="text"
                        android:textColor="@color/yuz_text"
                        android:textSize="@dimen/yuz_text_body" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- #75: ro'yxatdan hudud tanlash — erkin matn o'rniga xato yozish imkoni yo'q. -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnFilterRegionPicker"
                    style="@style/YuzButtonSecondary"
                    android:layout_height="@dimen/yuz_field_height"
                    android:layout_marginTop="@dimen/yuz_space_3"
                    android:text="@string/classified_filter_region"
                    android:textSize="@dimen/yuz_text_secondary"
                    app:icon="@drawable/ic_location_pin" />

                <TextView
                    style="@style/YuzLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/yuz_space_4"
                    android:layout_marginBottom="@dimen/yuz_space_2"
                    android:text="@string/classified_filter_date_title" />

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:overScrollMode="never"
                    android:scrollbars="none">

                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/chipGroupAdsDate"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:chipSpacingHorizontal="@dimen/yuz_space_2"
                        app:singleLine="true"
                        app:singleSelection="true" />
                </HorizontalScrollView>

                <TextView
                    style="@style/YuzLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/yuz_space_3"
                    android:layout_marginBottom="@dimen/yuz_space_2"
                    android:text="@string/classified_filter_sort_title" />

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:overScrollMode="never"
                    android:scrollbars="none">

                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/chipGroupAdsSort"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:chipSpacingHorizontal="@dimen/yuz_space_2"
                        app:singleLine="true"
                        app:singleSelection="true" />
                </HorizontalScrollView>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/yuz_space_4"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnFilterReset"
                        style="@style/YuzButtonText"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="@dimen/yuz_space_2"
                        android:text="@string/classified_filter_reset" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnFilterApply"
                        style="@style/YuzButton"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:text="@string/classified_filter_apply" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipeRefreshAds"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvClassifiedAds"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingStart="@dimen/yuz_space_3"
                android:paddingTop="@dimen/yuz_space_2"
                android:paddingEnd="@dimen/yuz_space_3"
                android:paddingBottom="100dp" />

            <!-- Bo'sh holat: nega bo'sh va keyin nima qilish kerak. -->
            <LinearLayout
                android:id="@+id/emptyState"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingStart="@dimen/yuz_space_6"
                android:paddingEnd="@dimen/yuz_space_6"
                android:visibility="gone">

                <ImageView
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:alpha="0.8"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_yuz_tag"
                    app:tint="@color/yuz_text_muted" />

                <TextView
                    style="@style/YuzEmptyTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/yuz_space_3"
                    android:text="@string/classified_no_results" />

                <TextView
                    style="@style/YuzEmptyHint"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/yuz_space_1"
                    android:text="@string/classified_no_results_hint" />
            </LinearLayout>

            <ProgressBar
                android:id="@+id/progressBar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:indeterminateTint="@color/yuz_action"
                android:visibility="gone" />
        </FrameLayout>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/fabPostAd"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="@dimen/yuz_gutter"
        android:layout_marginBottom="92dp"
        android:text="@string/classified_post_ad"
        android:textColor="@color/yuz_on_action"
        android:textSize="@dimen/yuz_text_button"
        android:textStyle="bold"
        app:backgroundTint="@color/yuz_action"
        app:elevation="8dp"
        app:icon="@drawable/ic_yuz_add"
        app:iconTint="@color/yuz_on_action" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
