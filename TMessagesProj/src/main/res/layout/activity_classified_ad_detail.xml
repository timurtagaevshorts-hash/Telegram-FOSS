<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_home_main">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="@dimen/yuz_space_6">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:navigationIcon="@drawable/ic_yuz_back"
            app:title="@string/classified_ad_detail"
            app:titleTextColor="@color/yuz_text" />

        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/vpImages"
            android:layout_width="match_parent"
            android:layout_height="280dp" />

        <com.google.android.material.tabs.TabLayout
            android:id="@+id/tabImageIndicator"
            android:layout_width="match_parent"
            android:layout_height="16dp"
            android:layout_marginTop="@dimen/yuz_space_2"
            app:tabBackground="@drawable/tab_classified_indicator"
            app:tabGravity="center"
            app:tabIndicatorHeight="0dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/yuz_gutter">

            <!-- Kategoriya: ikon + nom (ClassifiedAdDetailActivity bindAd()). -->
            <TextView
                android:id="@+id/tvCategory"
                style="@style/YuzLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/yuz_action" />

            <TextView
                android:id="@+id/tvModel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/yuz_space_2"
                android:textColor="@color/yuz_text_secondary"
                android:textSize="@dimen/yuz_text_secondary" />

            <TextView
                android:id="@+id/tvTitle"
                style="@style/YuzScreenTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/yuz_space_2" />

            <TextView
                android:id="@+id/tvPrice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/yuz_space_3"
                android:textColor="@color/yuz_gold"
                android:textSize="@dimen/yuz_text_title"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvAddress"
                style="@style/YuzBodySecondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/yuz_space_2" />

            <TextView
                style="@style/YuzSectionHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/yuz_space_6"
                android:text="@string/classified_description" />

            <TextView
                android:id="@+id/tvDescription"
                style="@style/YuzBodySecondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/yuz_space_2"
                android:lineSpacingExtra="4dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnShareFriends"
                style="@style/YuzButtonSecondary"
                android:layout_marginTop="@dimen/yuz_space_4"
                android:text="@string/classified_share_friends"
                app:icon="@drawable/ic_yuz_share" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCall"
                style="@style/YuzButton"
                android:layout_marginTop="@dimen/yuz_space_2"
                android:text="@string/classified_call_seller"
                app:icon="@drawable/ic_yuz_phone" />
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
