<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_chat_room_gradient"
    android:orientation="vertical">

    <!-- Top bar -->
    <LinearLayout
        android:id="@+id/musiqaTopBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/yuz_space_1"
        android:paddingEnd="@dimen/yuz_space_2"
        android:paddingBottom="@dimen/yuz_space_2">

        <ImageButton
            android:id="@+id/btnMusiqaBack"
            style="@style/YuzIconButton"
            android:contentDescription="@string/yuz_a11y_back"
            android:src="@drawable/ic_back" />

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginStart="@dimen/yuz_space_2"
            android:src="@drawable/ic_yuz_music"
            app:tint="@color/yuz_action" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/yuz_space_2"
            android:text="@string/musiqa_title"
            android:textColor="@color/yuz_text"
            android:textSize="@dimen/yuz_text_title"
            android:textStyle="bold" />

        <!-- YuzGram #128: kolleksiyalar (playlistlar/radio) — ikon tugma -->
        <ImageButton
            android:id="@+id/btnMusiqaCollections"
            style="@style/YuzIconButton"
            android:contentDescription="@string/musiqa_collections"
            android:src="@drawable/ic_yuz_box"
            app:tint="@color/yuz_text_secondary" />

        <!-- YuzGram #62: keshdagi qo'shiqlar ro'yxatiga o'tish tugmasi -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnMusiqaSaved"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="0dp"
            android:text="@string/musiqa_saved_btn"
            android:textSize="@dimen/yuz_text_secondary" />
    </LinearLayout>

    <!-- Qidiruv qatori -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/yuz_space_4"
        android:paddingEnd="@dimen/yuz_space_4"
        android:paddingBottom="@dimen/yuz_space_2">

        <EditText
            android:id="@+id/etMusiqaQuery"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/taksi_addr_bg"
            android:hint="@string/musiqa_search_hint"
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:maxLines="1"
            android:paddingStart="@dimen/yuz_space_4"
            android:paddingTop="@dimen/yuz_space_3"
            android:paddingEnd="@dimen/yuz_space_4"
            android:paddingBottom="@dimen/yuz_space_3"
            android:textColor="@color/yuz_text"
            android:textColorHint="@color/yuz_text_secondary"
            android:textSize="@dimen/yuz_text_body" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnMusiqaSearch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/yuz_space_2"
            android:text="@string/musiqa_search"
            android:textSize="@dimen/yuz_text_body"
            app:cornerRadius="@dimen/yuz_radius_field" />
    </LinearLayout>

    <!-- YuzGram #116: tayyor qidiruv tugmalari — bosish tegishli seed
         so'rovi bilan ro'yxatni yuklaydi. -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:paddingStart="@dimen/yuz_space_4"
        android:paddingEnd="@dimen/yuz_space_4"
        android:scrollbars="none">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chipGroupMusiqaPreset"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingBottom="@dimen/yuz_space_2"
            app:chipSpacingHorizontal="8dp"
            app:singleLine="true"
            app:singleSelection="true" />
    </HorizontalScrollView>

    <TextView
        android:id="@+id/tvMusiqaStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/yuz_gutter"
        android:paddingEnd="@dimen/yuz_gutter"
        android:paddingBottom="@dimen/yuz_space_2"
        android:text="@string/musiqa_trending"
        android:textColor="@color/yuz_text_secondary"
        android:textSize="@dimen/yuz_text_secondary" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvMusiqa"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="@dimen/yuz_space_4" />

        <!-- YuzGram #98: qidiruv skeleti (sotuvchi yorug'lik bilan) -->
        <uz.kodlikino.top4.ui.YuzShimmer
            android:id="@+id/shimmerMusiqa"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/yuz_space_2"
            android:visibility="gone" />

        <!-- YuzGram #98: ommabop xitlar kelganda markazdagi animatsiya -->
        <LinearLayout
            android:id="@+id/hitsLoading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:visibility="gone">

            <uz.kodlikino.top4.ui.YuzPulseLoader
                android:layout_width="88dp"
                android:layout_height="88dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/yuz_space_3"
                android:text="@string/musiqa_hits_loading"
                android:textColor="@color/yuz_text_secondary"
                android:textSize="@dimen/yuz_text_secondary" />
        </LinearLayout>
    </FrameLayout>

    <!-- YuzGram #62: pastdagi ijochi panel (gone; kuylash boshlanganda ko'rinadi) -->
    <include layout="@layout/layout_yuz_music_player" />
</LinearLayout>
