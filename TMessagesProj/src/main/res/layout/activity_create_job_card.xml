<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_chat_room_gradient">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="@dimen/yuz_space_8">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:navigationIcon="@drawable/ic_back"
            app:title="@string/job_board_post"
            app:titleTextColor="@color/yuz_text" />

        <!-- Rasm tanlagich (ixtiyoriy, bitta rasm) -->
        <FrameLayout
            android:id="@+id/btnPickImage"
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:layout_marginStart="@dimen/yuz_space_4"
            android:layout_marginEnd="@dimen/yuz_space_4"
            android:background="@drawable/bg_classified_image_picker"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical">

                <FrameLayout
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:background="@drawable/bg_classified_premium_fab">

                    <ImageView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:layout_gravity="center"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_add_photo"
                        app:tint="@color/yuz_text" />
                </FrameLayout>

                <TextView
                    android:id="@+id/tvPickImageLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/yuz_space_3"
                    android:text="@string/job_board_pick_image_optional"
                    android:textColor="@color/yuz_text"
                    android:textSize="@dimen/yuz_text_section"
                    android:textStyle="bold" />
            </LinearLayout>

            <ImageView
                android:id="@+id/ivPreview"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@null"
                android:scaleType="centerCrop"
                android:visibility="gone" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/yuz_space_4">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/job_board_listing_type"
                android:textColor="@color/yuz_text"
                android:textSize="@dimen/yuz_text_secondary"
                android:textStyle="bold" />

            <Spinner
                android:id="@+id/spinnerListingType"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="@dimen/yuz_space_2"
                android:background="@drawable/bg_classified_search_bar"
                android:paddingStart="@dimen/yuz_space_3"
                android:paddingEnd="@dimen/yuz_space_3" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilTitle"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/yuz_space_4"
                android:hint="@string/job_board_title_hint"
                app:hintTextColor="@color/yuz_text_secondary">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textCapSentences"
                    android:maxLines="2"
                    android:textColor="@color/yuz_text" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/yuz_space_3"
                android:hint="@string/job_board_description_hint"
                app:hintTextColor="@color/yuz_text_secondary">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etDescription"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="top"
                    android:inputType="textMultiLine|textCapSentences"
                    android:minLines="3"
                    android:textColor="@color/yuz_text" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Ish haqi bo'limi — faqat "Ishchi kerak" holatida -->
            <LinearLayout
                android:id="@+id/salarySection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/yuz_space_4"
                    android:text="@string/job_board_salary_type"
                    android:textColor="@color/yuz_text"
                    android:textSize="@dimen/yuz_text_secondary"
                    android:textStyle="bold" />

                <Spinner
                    android:id="@+id/spinnerSalaryType"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="@dimen/yuz_space_2"
                    android:background="@drawable/bg_classified_search_bar"
                    android:paddingStart="@dimen/yuz_space_3"
                    android:paddingEnd="@dimen/yuz_space_3" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilSalary"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/yuz_space_3"
                    android:hint="@string/job_board_salary_hint"
                    app:hintTextColor="@color/yuz_text_secondary">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etSalary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:importantForAutofill="no"
                        android:inputType="number"
                        android:maxLines="1"
                        android:textColor="@color/yuz_text" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/yuz_space_3"
                android:hint="@string/classified_phone_hint"
                app:hintTextColor="@color/yuz_text_secondary">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etPhone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="phone"
                    android:maxLines="1"
                    android:textColor="@color/yuz_text" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/yuz_space_3"
                android:hint="@string/job_board_location_hint"
                app:hintTextColor="@color/yuz_text_secondary">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etLocation"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textCapSentences"
                    android:maxLines="1"
                    android:textColor="@color/yuz_text" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- #75: hudud tanlagichi — filtr qidiruvi region maydoniga tayanadi. -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnJobPickRegion"
                style="@style/YuzButtonSecondary"
                android:layout_width="match_parent"
                android:layout_height="@dimen/yuz_button"
                android:layout_marginTop="@dimen/yuz_space_2"
                android:text="@string/classified_region_optional"
                android:textSize="@dimen/yuz_text_secondary"
                app:icon="@drawable/ic_location_pin"
                app:iconGravity="start" />

            <ProgressBar
                android:id="@+id/uploadProgress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/yuz_space_4"
                android:indeterminate="true"
                android:indeterminateTint="@color/yuz_action"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPublish"
                style="@style/YuzButton"
                android:layout_width="match_parent"
                android:layout_height="@dimen/yuz_button"
                android:layout_marginTop="@dimen/yuz_gutter"
                android:text="@string/job_board_publish" />
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
