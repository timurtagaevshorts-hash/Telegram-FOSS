<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/yuz_bg"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/trustTopBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/yuz_space_1"
        android:paddingTop="@dimen/yuz_space_2"
        android:paddingEnd="@dimen/yuz_gutter"
        android:paddingBottom="@dimen/yuz_space_2">

        <ImageButton
            android:id="@+id/btnTrustBack"
            style="@style/YuzIconButton"
            android:contentDescription="@string/yuz_trust_title"
            android:src="@drawable/ic_back" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/yuz_space_1"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                style="@style/YuzScreenTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/yuz_trust_title" />

            <TextView
                style="@style/YuzScreenSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/yuz_trust_subtitle" />
        </LinearLayout>
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/yuz_gutter"
            android:paddingTop="@dimen/yuz_space_2"
            android:paddingEnd="@dimen/yuz_gutter"
            android:paddingBottom="@dimen/yuz_space_8">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_yuz_trust_hero"
                android:orientation="vertical"
                android:padding="@dimen/yuz_space_4">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <FrameLayout
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        android:background="@drawable/bg_yuz_trust_crest">

                        <ImageView
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:layout_gravity="center"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_yuz_trust_shield" />
                    </FrameLayout>

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/yuz_space_3"
                        android:layout_weight="1"
                        android:text="@string/yuz_trust_hero_lead"
                        android:textColor="@color/yuz_text_bright"
                        android:textSize="17sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    style="@style/YuzBodySecondary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/yuz_space_3"
                    android:lineSpacingExtra="3dp"
                    android:text="@string/yuz_trust_hero_desc" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/trustRules"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/yuz_space_3"
                android:background="@drawable/bg_yuz_games_panel"
                android:orientation="vertical"
                android:padding="@dimen/yuz_space_4" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnTrustRequest"
                style="@style/YuzButton"
                android:layout_width="match_parent"
                android:layout_marginTop="@dimen/yuz_space_4"
                android:text="@string/yuz_trust_cta_request" />

            <ProgressBar
                android:id="@+id/trustProgress"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="@dimen/yuz_space_4"
                android:indeterminateTint="@color/yuz_action"
                android:visibility="gone" />

            <TextView
                android:id="@+id/trustEmptyTitle"
                style="@style/YuzEmptyTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/yuz_space_6"
                android:gravity="center"
                android:text="@string/yuz_trust_empty_title" />

            <TextView
                android:id="@+id/trustEmptyDesc"
                style="@style/YuzEmptyHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/yuz_space_2"
                android:gravity="center"
                android:lineSpacingExtra="2dp"
                android:text="@string/yuz_trust_empty_desc" />

            <TextView
                android:id="@+id/trustIncomingHeader"
                style="@style/YuzSectionHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/yuz_space_6"
                android:text="@string/yuz_trust_section_incoming"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/trustIncomingList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/yuz_space_2"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/trustActiveHeader"
                style="@style/YuzSectionHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/yuz_space_6"
                android:text="@string/yuz_trust_section_active"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/trustActiveList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/yuz_space_2"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/trustSentHeader"
                style="@style/YuzSectionHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/yuz_space_6"
                android:text="@string/yuz_trust_section_sent"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/trustSentList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/yuz_space_2"
                android:orientation="vertical" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>