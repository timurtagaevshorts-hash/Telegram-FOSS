<?xml version="1.0" encoding="utf-8"?>
<!--
  Reel izohining bitta qatori. KinoTOP4'dagi izoh ko'rinishi asosida,
  ammo YuzGram neon mavzusiga moslashtirilgan (to'q fon, brend-ko'k urg'u).
  Matn qatori eni cheklangan: ekran kengligi qancha bo'lishidan qat'i-nazar
  o'ngdagi tugmalar ustuniga urib yubormaydi.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingStart="14dp"
    android:paddingEnd="14dp"
    android:paddingTop="9dp"
    android:paddingBottom="9dp">

    <FrameLayout
        android:id="@+id/commentAvatarWrap"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:background="@drawable/bg_classified_premium_fab">

        <TextView
            android:id="@+id/tvCommentAvatar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:textColor="@color/white"
            android:textSize="13sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/ivCommentAvatar"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:contentDescription="@null"
            android:scaleType="centerCrop" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvCommentReplyHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/home_accent"
            android:textSize="12sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvCommentAuthor"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/text_primary"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvCommentText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="#DEE4EE"
            android:textIsSelectable="true"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tvCommentTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:textColor="@color/text_secondary"
            android:textSize="11sp" />
    </LinearLayout>
</LinearLayout>
