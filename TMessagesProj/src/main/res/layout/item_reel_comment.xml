<?xml version="1.0" encoding="utf-8"?>
<!--
  Reel izohining bitta qatori. KinoTOP4'dagi izoh ko'rinishi asosida,
  ammo YuzGram neon mavzusiga moslashtirilgan (to'q fon, brend-ko'k urg'u).
  Matn qatori eni cheklangan: ekran kengligi qancha bo'lishidan qat'i-nazar
  o'ngdagi tugmalar ustuniga urib yubormaydi.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingStart="@dimen/yuz_space_4"
    android:paddingEnd="@dimen/yuz_space_4"
    android:paddingTop="@dimen/yuz_space_2"
    android:paddingBottom="@dimen/yuz_space_2">

    <FrameLayout
        android:id="@+id/commentAvatarWrap"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:background="@drawable/bg_classified_premium_fab">

        <TextView
            android:id="@+id/tvCommentAvatar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:textColor="@color/yuz_text"
            android:textSize="@dimen/yuz_text_secondary"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/ivCommentAvatar"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:contentDescription="@null"
            android:scaleType="centerCrop" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/yuz_space_3"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvCommentReplyHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/yuz_action"
            android:textSize="@dimen/yuz_text_secondary"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvCommentAuthor"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/yuz_text"
            android:textSize="@dimen/yuz_text_secondary"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvCommentText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/yuz_text_secondary"
            android:textIsSelectable="true"
            android:textSize="@dimen/yuz_text_body" />

        <TextView
            android:id="@+id/tvCommentTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/yuz_space_1"
            android:textColor="@color/yuz_text_secondary"
            android:textSize="@dimen/yuz_text_caption" />
    </LinearLayout>
</LinearLayout>
