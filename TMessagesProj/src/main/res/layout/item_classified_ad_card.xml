<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/adCardRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="@dimen/yuz_space_1"
    android:layout_marginVertical="@dimen/yuz_space_2"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    app:cardBackgroundColor="@color/yuz_surface"
    app:cardCornerRadius="@dimen/yuz_radius_field"
    app:cardElevation="0dp"
    app:strokeColor="@color/yuz_stroke"
    app:strokeWidth="@dimen/yuz_stroke">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <FrameLayout
            android:id="@+id/cardAdImage"
            android:layout_width="match_parent"
            android:layout_height="128dp">

            <ImageView
                android:id="@+id/ivAdImage"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@null"
                android:scaleType="centerCrop" />

            <View
                android:layout_width="match_parent"
                android:layout_height="72dp"
                android:layout_gravity="bottom"
                android:background="@drawable/bg_classified_ad_scrim" />

            <TextView
                android:id="@+id/tvImageCount"
                style="@style/YuzBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|end"
                android:layout_margin="@dimen/yuz_space_2"
                android:background="@drawable/bg_classified_image_count_badge"
                android:elevation="2dp"
                android:paddingStart="@dimen/yuz_space_2"
                android:paddingTop="2dp"
                android:paddingEnd="@dimen/yuz_space_2"
                android:paddingBottom="2dp"
                android:textColor="@color/yuz_text"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvCategory"
                style="@style/YuzBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|start"
                android:layout_margin="@dimen/yuz_space_2"
                android:background="@drawable/bg_classified_category_badge"
                android:elevation="2dp"
                android:paddingStart="@dimen/yuz_space_2"
                android:paddingTop="2dp"
                android:paddingEnd="@dimen/yuz_space_2"
                android:paddingBottom="2dp"
                android:textColor="@color/yuz_text"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvAdPrice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|start"
                android:layout_marginStart="@dimen/yuz_space_3"
                android:layout_marginBottom="@dimen/yuz_space_3"
                android:background="@drawable/bg_classified_price_badge"
                android:elevation="2dp"
                android:paddingStart="@dimen/yuz_space_2"
                android:paddingTop="@dimen/yuz_space_1"
                android:paddingEnd="@dimen/yuz_space_2"
                android:paddingBottom="@dimen/yuz_space_1"
                android:textColor="@color/yuz_gold"
                android:textSize="@dimen/yuz_text_secondary"
                android:textStyle="bold" />
        </FrameLayout>

        <LinearLayout
            android:id="@+id/adInfoColumn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/yuz_space_3">

            <TextView
                android:id="@+id/tvAdModel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/yuz_action"
                android:textSize="@dimen/yuz_text_caption"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvAdTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:lineSpacingExtra="2dp"
                android:maxLines="2"
                android:textColor="@color/yuz_text"
                android:textSize="@dimen/yuz_text_secondary"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/adAddressRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/yuz_space_2"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/ivAdAddressIcon"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_location_pin"
                    app:tint="@color/yuz_text_secondary" />

                <TextView
                    android:id="@+id/tvAdAddress"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/yuz_space_1"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/yuz_text_secondary"
                    android:textSize="@dimen/yuz_text_caption" />
            </LinearLayout>

            <!-- O'z e'loni: tahrirlash / o'chirish. 40dp — barmog'ga yetarli maydon. -->
            <LinearLayout
                android:id="@+id/adOwnActionsRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/yuz_space_2"
                android:gravity="end"
                android:orientation="horizontal"
                android:visibility="gone">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnEditAd"
                    style="@style/YuzButtonIcon"
                    android:contentDescription="@string/classified_edit"
                    app:icon="@drawable/ic_edit"
                    app:iconTint="@color/yuz_action"
                    app:strokeColor="@color/yuz_action" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnDeleteAd"
                    style="@style/YuzButtonDangerIcon"
                    android:layout_marginStart="@dimen/yuz_space_2"
                    android:contentDescription="@string/classified_delete"
                    app:icon="@drawable/ic_delete" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
