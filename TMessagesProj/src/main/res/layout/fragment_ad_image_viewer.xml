<?xml version="1.0" encoding="utf-8"?>
<!--
  E'lon rasmlari uchun to'liq ekranli ko'ruvchi (KinoTOP4'dagi
  ChatImageViewerDialog pariteti). Fon qora, chunki rasm o'zi — butun ekran.

  Qavatlar tartibi muhim: ViewPager2 eng ostida (surgish + masshtab uni
  bosmasligi kerak), sarlavha/qaytish bloklari ustida.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF000000">

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/vpViewer"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <ImageView
        android:id="@+id/btnViewerBack"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_gravity="top|start"
        android:layout_marginStart="4dp"
        android:contentDescription="@string/classified_viewer_close"
        android:foreground="?attr/selectableItemBackgroundBorderless"
        android:padding="10dp"
        android:src="@drawable/ic_back" />

    <TextView
        android:id="@+id/tvViewerCounter"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:shadowColor="@color/yuz_scrim"
        android:shadowRadius="6"
        android:textColor="@color/yuz_text"
        android:textSize="@dimen/yuz_text_body" />

    <TextView
        android:id="@+id/tvViewerHint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="34dp"
        android:shadowColor="@color/yuz_scrim"
        android:shadowRadius="6"
        android:text="@string/classified_viewer_hint"
        android:textColor="@color/yuz_on_media_dim"
        android:textSize="@dimen/yuz_text_secondary" />
</FrameLayout>
