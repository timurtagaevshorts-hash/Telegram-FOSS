<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_chat_room_gradient">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="@dimen/yuz_space_8">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:navigationIcon="@drawable/ic_back"
            app:title="@string/job_board_detail"
            app:titleTextColor="@color/yuz_text" />

        <ImageView
            android:id="@+id/ivHero"
            android:layout_width="match_parent"
            android:layout_height="240dp"
            android:layout_marginStart="@dimen/yuz_space_4"
            android:layout_marginEnd="@dimen/yuz_space_4"
            android:background="@drawable/bg_classified_image_placeholder"
            android:contentDescription="@null"
            android:scaleType="centerCrop" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/detailCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/yuz_space_4"
            app:cardBackgroundColor="@color/classified_card_default_bg"
            app:cardCornerRadius="@dimen/yuz_radius_card"
            app:cardElevation="6dp"
            app:strokeColor="@color/yuz_stroke_soft"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/yuz_space_4">

                <TextView
                    android:id="@+id/tvType"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_classified_category_badge"
                    android:paddingStart="@dimen/yuz_space_3"
                    android:paddingTop="5dp"
                    android:paddingEnd="@dimen/yuz_space_3"
                    android:paddingBottom="5dp"
                    android:textColor="@color/yuz_text"
                    android:textSize="@dimen/yuz_text_secondary"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/yuz_space_3"
                    android:textColor="@color/yuz_text"
                    android:textSize="@dimen/yuz_text_title"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvSalary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/yuz_space_3"
                    android:background="@drawable/bg_classified_price_badge"
                    android:paddingStart="@dimen/yuz_space_3"
                    android:paddingTop="@dimen/yuz_space_2"
                    android:paddingEnd="@dimen/yuz_space_3"
                    android:paddingBottom="@dimen/yuz_space_2"
                    android:textColor="@color/yuz_gold"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvLocation"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/yuz_space_3"
                    android:drawablePadding="6dp"
                    android:gravity="center_vertical"
                    android:textColor="@color/yuz_text_secondary"
                    android:textSize="@dimen/yuz_text_secondary"
                    app:drawableStartCompat="@drawable/ic_location_pin"
                    app:drawableTint="@color/yuz_action" />

                <TextView
                    android:id="@+id/tvDescription"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/yuz_space_4"
                    android:lineSpacingExtra="3dp"
                    android:textColor="@color/yuz_text"
                    android:textSize="@dimen/yuz_text_body" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/yuz_space_4"
            android:layout_marginEnd="@dimen/yuz_space_4"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCall"
                android:layout_width="0dp"
                android:layout_height="@dimen/yuz_button"
                android:layout_weight="1"
                style="@style/YuzButton"
                android:text="@string/classified_call"
                app:icon="@drawable/ic_call" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDelete"
                style="@style/YuzButtonSecondary"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/yuz_button"
                android:layout_marginStart="@dimen/yuz_space_3"
                android:text="@string/classified_delete"
                android:visibility="gone"
                app:icon="@drawable/ic_delete"
                app:iconTint="@color/yuz_danger"
                app:strokeColor="@color/yuz_danger_soft" />
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
