<?xml version="1.0" encoding="utf-8"?>
<!-- YuzGram #62: qo'shiqni ilova ichida ijro etuvchi pastki pleyer paneli -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/musicPlayerBar"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/yuz_panel_elevated"
    android:orientation="vertical"
    android:paddingStart="@dimen/yuz_space_3"
    android:paddingTop="@dimen/yuz_space_2"
    android:paddingEnd="@dimen/yuz_space_3"
    android:paddingBottom="@dimen/yuz_space_2"
    android:visibility="gone">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/ivPlayerCover"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@color/modern_surface_high"
            android:contentDescription="@null"
            android:scaleType="centerCrop" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/yuz_space_3"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvPlayerTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/yuz_text"
                android:textSize="@dimen/yuz_text_body"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvPlayerArtist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/yuz_text_secondary"
                android:textSize="@dimen/yuz_text_secondary" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btnPlayerPrev"
            android:layout_width="@dimen/yuz_icon_button"
            android:layout_height="@dimen/yuz_icon_button"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/yuz_a11y_prev"
            android:src="@drawable/ic_yuz_prev"
            app:tint="@color/yuz_text" />

        <ImageButton
            android:id="@+id/btnPlayerPlay"
            android:layout_width="@dimen/yuz_icon_button"
            android:layout_height="@dimen/yuz_icon_button"
            android:layout_marginStart="@dimen/yuz_space_1"
            android:layout_marginEnd="@dimen/yuz_space_1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/yuz_a11y_pause"
            android:src="@drawable/ic_yuz_pause"
            app:tint="@color/yuz_action" />

        <ImageButton
            android:id="@+id/btnPlayerNext"
            android:layout_width="@dimen/yuz_icon_button"
            android:layout_height="@dimen/yuz_icon_button"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/yuz_a11y_next"
            android:src="@drawable/ic_yuz_next"
            app:tint="@color/yuz_text" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/btnPlayerEq"
            android:layout_width="@dimen/yuz_button_sm"
            android:layout_height="@dimen/yuz_button_sm"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/yuz_a11y_equalizer"
            android:src="@drawable/ic_yuz_eq"
            app:tint="@color/yuz_action" />

        <TextView
            android:id="@+id/tvPlayerPos"
            android:layout_width="34dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/yuz_space_1"
            android:gravity="end"
            android:text="0:00"
            android:textColor="@color/yuz_text_secondary"
            android:textSize="@dimen/yuz_text_caption" />

        <SeekBar
            android:id="@+id/playerSeek"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/tvPlayerDur"
            android:layout_width="34dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/yuz_space_1"
            android:gravity="end"
            android:text="0:30"
            android:textColor="@color/yuz_text_secondary"
            android:textSize="@dimen/yuz_text_caption" />

        <ImageButton
            android:id="@+id/btnPlayerLoop"
            android:layout_width="@dimen/yuz_button_sm"
            android:layout_height="@dimen/yuz_button_sm"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/yuz_a11y_repeat"
            android:src="@drawable/ic_yuz_loop"
            app:tint="@color/yuz_action" />

        <ImageButton
            android:id="@+id/btnPlayerDl"
            android:layout_width="@dimen/yuz_button_sm"
            android:layout_height="@dimen/yuz_button_sm"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/yuz_a11y_download"
            android:src="@drawable/ic_yuz_download"
            app:tint="@color/yuz_text" />
    </LinearLayout>
</LinearLayout>
