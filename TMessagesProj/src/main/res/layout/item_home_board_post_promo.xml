<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/promoCardRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_marginHorizontal="16dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    app:cardBackgroundColor="@color/surface_elevated"
    app:cardCornerRadius="16dp"
    app:cardElevation="5dp"
    app:strokeColor="@color/yuz_action"
    app:strokeWidth="1.5dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_classified_post_hero"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/yuz_space_4"
        android:paddingTop="@dimen/yuz_space_3"
        android:paddingEnd="@dimen/yuz_space_3"
        android:paddingBottom="@dimen/yuz_space_3">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/yuz_space_3"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_classified_category_badge_light"
                android:paddingHorizontal="@dimen/yuz_space_2"
                android:paddingVertical="@dimen/yuz_space_1"
                android:text="@string/home_board_post_promo_free"
                android:textColor="@color/yuz_action"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvPromoTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/yuz_space_2"
                android:lineSpacingExtra="2dp"
                android:text="@string/home_board_post_promo_title"
                android:textColor="@color/yuz_text"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/yuz_space_1"
                android:text="@string/home_board_post_promo_subtitle"
                android:textColor="@color/yuz_text_secondary"
                android:textSize="@dimen/yuz_text_secondary" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPromoPostAd"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/yuz_button_sm"
                android:layout_marginTop="@dimen/yuz_space_3"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minWidth="0dp"
                android:paddingStart="@dimen/yuz_space_4"
                android:paddingEnd="@dimen/yuz_space_4"
                android:text="@string/home_board_post_promo_button"
                android:textAllCaps="false"
                android:textColor="@color/yuz_text"
                android:textSize="@dimen/yuz_text_secondary"
                android:textStyle="bold"
                app:backgroundTint="@color/yuz_action"
                app:cornerRadius="@dimen/yuz_radius_field"
                app:icon="@drawable/ic_add"
                app:iconGravity="textStart"
                app:iconPadding="6dp"
                app:iconSize="18dp"
                app:iconTint="@color/yuz_text" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="88dp"
            android:layout_height="88dp">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:cardBackgroundColor="@color/modern_surface"
                app:cardCornerRadius="14dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/modern_border"
                app:strokeWidth="1dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="📣"
                    android:textSize="36sp" />
            </com.google.android.material.card.MaterialCardView>
        </FrameLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
