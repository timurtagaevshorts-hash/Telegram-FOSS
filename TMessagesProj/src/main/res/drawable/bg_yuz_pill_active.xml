<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/yuz_action" />
            <corners android:radius="@dimen/yuz_radius_pill" />
        </shape>
    </item>
    <!-- Faol pill ustida ingichka yorug' halqa: qorong'i fonda "tanlangan"
         holat rangdan tashqari shakl bilan ham o'qiladi. -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#26FFFFFF" />
            <corners android:radius="@dimen/yuz_radius_pill" />
            <stroke android:width="@dimen/yuz_stroke" android:color="#40FFFFFF" />
        </shape>
    </item>
</layer-list>
