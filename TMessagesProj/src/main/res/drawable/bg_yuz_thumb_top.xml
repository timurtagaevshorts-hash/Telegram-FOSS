<?xml version="1.0" encoding="utf-8"?>
<!-- Media bloki karta burchaklariga mos tushishi uchun: yuqori burchaklar
     karta radiusi bilan bir xil, pastki burchaklar to'g'ri (kontent davom etadi).
     Fon `clipToOutline` uchun kerak — rasm shu chegara bo'ylab qirqiladi. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/yuz_field" />
    <corners
        android:topLeftRadius="@dimen/yuz_radius_card"
        android:topRightRadius="@dimen/yuz_radius_card"
        android:bottomLeftRadius="0dp"
        android:bottomRightRadius="0dp" />
</shape>
