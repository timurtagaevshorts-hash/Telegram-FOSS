<?xml version="1.0" encoding="utf-8"?>
<!--
  Izohlar paneli sirti: tepasi yumaloq.
  Fon mavzu tokenidan olinadi — kunduzgi mavzuda panel oq bo'lib, matn
  (@color/yuz_text) bilan bir xil rangga tushib qolmaydi.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/yuz_surface_raised" />
    <stroke
        android:width="1dp"
        android:color="@color/yuz_stroke" />
    <corners
        android:topLeftRadius="22dp"
        android:topRightRadius="22dp" />
</shape>
