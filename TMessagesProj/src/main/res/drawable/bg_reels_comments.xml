<?xml version="1.0" encoding="utf-8"?>
<!--
  Izohlar paneli sirti: tepasi yumaloq, chuqur-ko'k neon fon.
  Faqat tepa burchaklar yumaloq (pastki ekran chetiga yaqin turadi).
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#0D1526" />
    <stroke
        android:width="1dp"
        android:color="#332AABEE" />
    <corners
        android:topLeftRadius="22dp"
        android:topRightRadius="22dp" />
</shape>
